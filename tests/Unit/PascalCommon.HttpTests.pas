unit PascalCommon.HttpTests;

{ Tests for the HTTP contract without a server: PascalCommon.Http's helpers
  and URL parsing, the fake (PascalCommon.Http.Fake), the requests
  PcNewHttpTransport refuses before connecting, a closed port, and
  PcUtf8BytesToString. The helper and fake tests came from
  pascal-api-infra-faa's PascalApi.HttpTransportTests, renamed. Exchanges
  with a server are PascalCommon.HttpClientTests.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  PascalCommon.DUnitXCompat,
  SysUtils,
  PascalCommon.Utf8,
  PascalCommon.Http,
  PascalCommon.Http.Client,
  PascalCommon.Http.Fake;

type
  [TestFixture]
  THttpTests = class
  private
    FTransport: IPcHttpTransport;
    FRequest: TPcHttpRequest;
    FUrl: string;
    procedure SendToFake;
    procedure SendToClosedPort;
    procedure SendRequest;
    procedure ParseUrl;
    procedure CheckUrlRefused(const AUrl: string);
    procedure CheckRequestRefused(const AWhat: string);
  public
    [Test] procedure HeaderLine_Split;
    [Test] procedure HeaderLine_NotAHeader;
    [Test] procedure Header_AnyCase_FirstWins;
    [Test] procedure MethodsWithBody;
    [Test] procedure MethodsIdempotent;
    [Test] procedure UrlWithoutQuery_CutsQueryAndFragment;
    [Test] procedure ParseUrl_SchemesPortsAndTarget;
    [Test] procedure ParseUrl_Ipv6;
    [Test] procedure ParseUrl_Refused;
    [Test] procedure HostHeader_PortOnlyWhenNotTheDefault;
    [Test] procedure Fake_AnswersInOrder_KeepsRequests;
    [Test] procedure Fake_Fail_IsNoAnswer;
    [Test] procedure Fake_Empty_IsTheTestsFailure;
    [Test] procedure Fake_BadHeaderLine_Raises;
    [Test] procedure Client_ClosedPort_IsNoAnswer;
    [Test] procedure Client_NoAnswer_LeavesTheQueryOut;
    [Test] procedure Client_OwnedHeaders_Refused;
    [Test] procedure Client_BadMethodOrHeader_Refused;
    [Test] procedure Client_BadUrl_Refused;
    [Test] procedure Utf8BytesToString_RaisesWithTheOrigin;
  end;

implementation

function Bytes(const AValues: array of Byte): TBytes;
var
  I: Integer;
begin
  SetLength(Result, Length(AValues));
  for I := 0 to High(AValues) do
    Result[I] := AValues[I];
end;

procedure THttpTests.SendToFake;
begin
  FTransport.Send(TPcHttpRequest.Create('GET', 'http://api.test/health/live'));
end;

procedure THttpTests.SendToClosedPort;
var
  LRequest: TPcHttpRequest;
begin
  // Port 1 on the loopback: nothing listens there (tcpmux, never enabled).
  LRequest := TPcHttpRequest.Create('POST', 'http://127.0.0.1:1/auth/login');
  LRequest.TimeoutMs := 1000;
  FTransport.Send(LRequest);
end;

procedure THttpTests.SendRequest;
begin
  FTransport.Send(FRequest);
end;

procedure THttpTests.ParseUrl;
begin
  PcParseHttpUrl(FUrl);
end;

procedure THttpTests.CheckUrlRefused(const AUrl: string);
begin
  FUrl := AUrl;
  TAssert.AssertException(AUrl, EArgumentException, ParseUrl);
end;

procedure THttpTests.CheckRequestRefused(const AWhat: string);
begin
  // Port 1: if the request were sent, the failure would be EPcHttpTransport.
  TAssert.AssertException(AWhat, EArgumentException, SendRequest);
end;

procedure THttpTests.HeaderLine_Split;
var
  LField: TPcHttpHeader;
begin
  TAssert.AssertTrue(PcHttpSplitHeaderLine('ETag: "3"', LField));
  TAssert.AssertEquals('ETag', LField.Name);
  TAssert.AssertEquals('"3"', LField.Value);
  TAssert.AssertTrue(PcHttpSplitHeaderLine('Retry-After:5', LField));
  TAssert.AssertEquals('Retry-After', LField.Name);
  TAssert.AssertEquals('5', LField.Value);
  // Split at the first colon only.
  TAssert.AssertTrue(PcHttpSplitHeaderLine('Location:  http://127.0.0.1:9400/x ', LField));
  TAssert.AssertEquals('http://127.0.0.1:9400/x', LField.Value);
  TAssert.AssertTrue(PcHttpSplitHeaderLine('X-Empty:', LField));
  TAssert.AssertEquals('X-Empty', LField.Name);
  TAssert.AssertEquals('', LField.Value);
end;

procedure THttpTests.HeaderLine_NotAHeader;
var
  LField: TPcHttpHeader;
begin
  TAssert.AssertFalse(PcHttpSplitHeaderLine('HTTP/1.1 200 OK', LField));
  TAssert.AssertFalse(PcHttpSplitHeaderLine(': no name', LField));
  TAssert.AssertFalse(PcHttpSplitHeaderLine('', LField));
  TAssert.AssertEquals('', LField.Name);
end;

procedure THttpTests.Header_AnyCase_FirstWins;
var
  LResponse: TPcHttpResponse;
  LRequest: TPcHttpRequest;
  LValue: string;
begin
  SetLength(LResponse.Headers, 3);
  LResponse.Headers[0].Name := 'Content-Type';
  LResponse.Headers[0].Value := 'application/json';
  LResponse.Headers[1].Name := 'etag';
  LResponse.Headers[1].Value := '"7"';
  LResponse.Headers[2].Name := 'ETag';
  LResponse.Headers[2].Value := '"8"';
  TAssert.AssertEquals('"7"', LResponse.Header('ETAG'));
  TAssert.AssertEquals('', LResponse.Header('Retry-After'));
  TAssert.AssertFalse(PcHttpFindHeader(LResponse.Headers, 'Retry-After', LValue));
  TAssert.AssertTrue(PcHttpFindHeader(LResponse.Headers, 'content-type', LValue));
  TAssert.AssertEquals('application/json', LValue);

  LRequest := TPcHttpRequest.Create('PATCH', 'http://api.test/customers/1');
  LRequest.AddHeader('If-Match', '"2"');
  LRequest.AddHeader('Authorization', 'Bearer t');
  TAssert.AssertEquals(2, Length(LRequest.Headers));
  TAssert.AssertEquals('"2"', LRequest.Header('if-match'));
  TAssert.AssertEquals(0, LRequest.TimeoutMs);
end;

procedure THttpTests.MethodsWithBody;
begin
  TAssert.AssertTrue(PcHttpMethodHasBody('POST'));
  TAssert.AssertTrue(PcHttpMethodHasBody('put'));
  TAssert.AssertTrue(PcHttpMethodHasBody('Patch'));
  TAssert.AssertFalse(PcHttpMethodHasBody('GET'));
  TAssert.AssertFalse(PcHttpMethodHasBody('DELETE'));
  TAssert.AssertFalse(PcHttpMethodHasBody('HEAD'));
end;

procedure THttpTests.MethodsIdempotent;
begin
  TAssert.AssertTrue(PcHttpMethodIsIdempotent('GET'));
  TAssert.AssertTrue(PcHttpMethodIsIdempotent('head'));
  TAssert.AssertTrue(PcHttpMethodIsIdempotent('OPTIONS'));
  TAssert.AssertTrue(PcHttpMethodIsIdempotent('PUT'));
  TAssert.AssertTrue(PcHttpMethodIsIdempotent('Delete'));
  TAssert.AssertFalse(PcHttpMethodIsIdempotent('POST'));
  TAssert.AssertFalse(PcHttpMethodIsIdempotent('PATCH'));
  TAssert.AssertFalse(PcHttpMethodIsIdempotent(''));
end;

procedure THttpTests.UrlWithoutQuery_CutsQueryAndFragment;
begin
  TAssert.AssertEquals('http://h/a', PcUrlWithoutQuery('http://h/a?b=1&c=2'));
  TAssert.AssertEquals('http://h/a', PcUrlWithoutQuery('http://h/a#x?y'));
  TAssert.AssertEquals('http://h/a', PcUrlWithoutQuery('http://h/a'));
  TAssert.AssertEquals('', PcUrlWithoutQuery('?only'));
  TAssert.AssertEquals('', PcUrlWithoutQuery(''));
end;

procedure THttpTests.ParseUrl_SchemesPortsAndTarget;
var
  LUrl: TPcHttpUrl;
begin
  LUrl := PcParseHttpUrl('http://search.test/indexes/cities/search?q=S%C3%A3o#top');
  TAssert.AssertEquals('http', LUrl.Scheme);
  TAssert.AssertEquals('search.test', LUrl.Host);
  TAssert.AssertEquals(80, LUrl.Port);
  TAssert.AssertEquals('/indexes/cities/search?q=S%C3%A3o', LUrl.Target);
  TAssert.AssertFalse(LUrl.IsHttps);

  LUrl := PcParseHttpUrl('HTTPS://Search.Test:7700');
  TAssert.AssertEquals('https', LUrl.Scheme);
  TAssert.AssertEquals('Search.Test', LUrl.Host);
  TAssert.AssertEquals(7700, LUrl.Port);
  TAssert.AssertEquals('/', LUrl.Target);
  TAssert.AssertTrue(LUrl.IsHttps);

  LUrl := PcParseHttpUrl('https://h?x=1');
  TAssert.AssertEquals(443, LUrl.Port);
  TAssert.AssertEquals('/?x=1', LUrl.Target);

  // An empty port is the scheme's (RFC 3986, 3.2.3).
  LUrl := PcParseHttpUrl('http://h:/p');
  TAssert.AssertEquals(80, LUrl.Port);
  TAssert.AssertEquals('/p', LUrl.Target);
end;

procedure THttpTests.ParseUrl_Ipv6;
var
  LUrl: TPcHttpUrl;
begin
  LUrl := PcParseHttpUrl('http://[::1]:8108/collections');
  TAssert.AssertEquals('::1', LUrl.Host);
  TAssert.AssertEquals(8108, LUrl.Port);
  TAssert.AssertEquals('/collections', LUrl.Target);
  TAssert.AssertEquals('[::1]:8108', LUrl.HostHeader);
  LUrl := PcParseHttpUrl('https://[fe80::1]/');
  TAssert.AssertEquals('fe80::1', LUrl.Host);
  TAssert.AssertEquals(443, LUrl.Port);
  TAssert.AssertEquals('[fe80::1]', LUrl.HostHeader);
end;

procedure THttpTests.ParseUrl_Refused;
begin
  CheckUrlRefused('ftp://h/x');
  CheckUrlRefused('h/x');
  CheckUrlRefused('http:///x');
  CheckUrlRefused('http://:80/x');
  CheckUrlRefused('http://user:pass@h/x');
  CheckUrlRefused('http://h:0/');
  CheckUrlRefused('http://h:65536/');
  CheckUrlRefused('http://h:8o/');
  CheckUrlRefused('http://[::1/');
  CheckUrlRefused('http://[::1]x/');
  CheckUrlRefused('http://h/a b');
  CheckUrlRefused('http://h/a'#10'Host: evil');
  CheckUrlRefused('http://h/S' + Char($E3) + 'o');
end;

procedure THttpTests.HostHeader_PortOnlyWhenNotTheDefault;
begin
  TAssert.AssertEquals('h', PcParseHttpUrl('http://h:80/').HostHeader);
  TAssert.AssertEquals('h:443', PcParseHttpUrl('http://h:443/').HostHeader);
  TAssert.AssertEquals('h', PcParseHttpUrl('https://h:443/').HostHeader);
  TAssert.AssertEquals('h:80', PcParseHttpUrl('https://h:80/').HostHeader);
end;

procedure THttpTests.Fake_AnswersInOrder_KeepsRequests;
var
  LFake: TPcFakeHttpTransport;
  LRequest: TPcHttpRequest;
  LResponse: TPcHttpResponse;
begin
  LFake := TPcFakeHttpTransport.Create;
  FTransport := LFake;
  LFake.Answer(200, '{"accessToken":"a"}', ['Content-Type: application/json']);
  LFake.Answer(412, '', ['ETag: "4"', 'Retry-After: 2']);
  TAssert.AssertEquals(2, LFake.Pending);

  LRequest := TPcHttpRequest.Create('POST', 'http://api.test/auth/login');
  LRequest.AddHeader('Content-Type', 'application/json');
  LRequest.Body := '{"email":"joao@demo.test"}';
  LResponse := FTransport.Send(LRequest);
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals('{"accessToken":"a"}', LResponse.Body);
  TAssert.AssertEquals('application/json', LResponse.Header('content-type'));

  LResponse := FTransport.Send(TPcHttpRequest.Create('PATCH', 'http://api.test/appointments/9'));
  TAssert.AssertEquals(412, LResponse.Status);
  TAssert.AssertEquals('', LResponse.Body);
  TAssert.AssertEquals('"4"', LResponse.Header('ETag'));
  TAssert.AssertEquals('2', LResponse.Header('Retry-After'));

  TAssert.AssertEquals(0, LFake.Pending);
  TAssert.AssertEquals(2, LFake.RequestCount);
  TAssert.AssertEquals('POST', LFake.Request(0).Method);
  TAssert.AssertEquals(LRequest.Body, LFake.Request(0).Body);
  TAssert.AssertEquals('application/json', LFake.Request(0).Header('Content-Type'));
  TAssert.AssertEquals('http://api.test/appointments/9', LFake.Requests[1].Url);
  FTransport := nil;
end;

procedure THttpTests.Fake_Fail_IsNoAnswer;
var
  LFake: TPcFakeHttpTransport;
begin
  LFake := TPcFakeHttpTransport.Create;
  FTransport := LFake;
  LFake.Fail;
  LFake.Answer(204);
  TAssert.AssertException(EPcHttpTransport, SendToFake);
  // The failure took its place in the queue: the next one answers.
  TAssert.AssertEquals(204, FTransport.Send(
    TPcHttpRequest.Create('GET', 'http://api.test/me')).Status);
  TAssert.AssertEquals(2, LFake.RequestCount);
  FTransport := nil;
end;

procedure THttpTests.Fake_Empty_IsTheTestsFailure;
var
  LFake: TPcFakeHttpTransport;
begin
  LFake := TPcFakeHttpTransport.Create;
  FTransport := LFake;
  TAssert.AssertException(EPcFakeHttpTransport, SendToFake);
  TAssert.AssertEquals(1, LFake.RequestCount);
  TAssert.AssertException(EPcFakeHttpTransport, SendToFake);
  FTransport := nil;
end;

procedure THttpTests.Fake_BadHeaderLine_Raises;
var
  LFake: TPcFakeHttpTransport;
  LRaised: Boolean;
begin
  LFake := TPcFakeHttpTransport.Create;
  FTransport := LFake;
  LRaised := False;
  try
    LFake.Answer(200, '', ['no colon here']);
  except
    on EPcFakeHttpTransport do
      LRaised := True;
  end;
  TAssert.AssertTrue(LRaised);
  TAssert.AssertEquals(0, LFake.Pending);
  FTransport := nil;
end;

procedure THttpTests.Client_ClosedPort_IsNoAnswer;
begin
  FTransport := PcNewHttpTransport;
  TAssert.AssertException(EPcHttpTransport, SendToClosedPort);
  FTransport := nil;
end;

// The message of the EPcHttpTransport a closed port raises, '' for none.
function ClosedPortMessage(const AUrl: string): string;
var
  LTransport: IPcHttpTransport;
  LRequest: TPcHttpRequest;
begin
  Result := '';
  LTransport := PcNewHttpTransport;
  LRequest := TPcHttpRequest.Create('GET', AUrl);
  LRequest.TimeoutMs := 1000;
  try
    LTransport.Send(LRequest);
  except
    on E: EPcHttpTransport do
      Result := E.Message;
  end;
end;

procedure THttpTests.Client_NoAnswer_LeavesTheQueryOut;
var
  LMessage: string;
begin
  LMessage := ClosedPortMessage('http://127.0.0.1:1/cities?token=s3cr3t#frag');
  TAssert.AssertTrue(LMessage, Pos('GET http://127.0.0.1:1/cities: no answer (EPcTransport', LMessage) = 1);
  TAssert.AssertEquals(LMessage, 0, Pos('s3cr3t', LMessage));
  TAssert.AssertEquals(LMessage, 0, Pos('frag', LMessage));
end;

procedure THttpTests.Client_OwnedHeaders_Refused;
const
  COwned: array[0..3] of string = ('Host', 'content-length', 'Transfer-Encoding',
    'CONNECTION');
var
  I: Integer;
begin
  FTransport := PcNewHttpTransport;
  for I := 0 to High(COwned) do
  begin
    FRequest := TPcHttpRequest.Create('GET', 'http://127.0.0.1:1/x');
    FRequest.AddHeader(COwned[I], 'x');
    CheckRequestRefused(COwned[I]);
  end;
  FTransport := nil;
end;

procedure THttpTests.Client_BadMethodOrHeader_Refused;
begin
  FTransport := PcNewHttpTransport;
  FRequest := TPcHttpRequest.Create('', 'http://127.0.0.1:1/x');
  CheckRequestRefused('empty method');
  FRequest := TPcHttpRequest.Create('GET /x', 'http://127.0.0.1:1/x');
  CheckRequestRefused('method with a space');
  FRequest := TPcHttpRequest.Create('GET', 'http://127.0.0.1:1/x');
  FRequest.AddHeader('X Bad', 'v');
  CheckRequestRefused('header name with a space');
  FRequest := TPcHttpRequest.Create('GET', 'http://127.0.0.1:1/x');
  FRequest.AddHeader('X-Forged', 'v'#13#10'Authorization: Bearer stolen');
  CheckRequestRefused('CRLF in a value');
  FRequest := TPcHttpRequest.Create('GET', 'http://127.0.0.1:1/x');
  FRequest.AddHeader('X-Nul', 'a'#0'b');
  CheckRequestRefused('NUL in a value');
  FTransport := nil;
end;

procedure THttpTests.Client_BadUrl_Refused;
begin
  FTransport := PcNewHttpTransport;
  FRequest := TPcHttpRequest.Create('GET', 'ftp://127.0.0.1:1/x');
  CheckRequestRefused('ftp');
  FRequest := TPcHttpRequest.Create('GET', 'http://127.0.0.1:1/a b');
  CheckRequestRefused('a space in the path');
  FTransport := nil;
end;

procedure THttpTests.Utf8BytesToString_RaisesWithTheOrigin;
var
  LMessage: string;
begin
  TAssert.AssertEquals('ok', PcUtf8BytesToString(Bytes([$6F, $6B]), 'x'));
  TAssert.AssertEquals('', PcUtf8BytesToString(nil, 'x'));
  LMessage := '';
  try
    PcUtf8BytesToString(Bytes([$53, $E3, $6F]), 'the answer to GET http://h/p');
  except
    on E: EPcTextEncoding do
      LMessage := E.Message;
  end;
  TAssert.AssertTrue(LMessage, Pos('the answer to GET http://h/p is not UTF-8', LMessage) = 1);
  LMessage := '';
  try
    PcUtf8BytesToString(Bytes([$FF, $FE, $41, 0]), 'f.env');
  except
    on E: EPcTextEncoding do
      LMessage := E.Message;
  end;
  TAssert.AssertTrue(LMessage, Pos('UTF-16 byte order mark', LMessage) > 0);
end;

initialization
  TDUnitX.RegisterTestFixture(THttpTests);

end.
