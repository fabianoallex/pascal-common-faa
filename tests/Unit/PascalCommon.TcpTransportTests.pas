unit PascalCommon.TcpTransportTests;

{ Loopback tests for PcTcpConnect and PcTcpListen: a client and a server in
  this process, on port 0, so no external server, Docker or fixed port is
  needed. They use only the factories and the TPcEndpoint contract, so the
  same tests run on the WinSock backend and on the POSIX one.

  Ported from pascal-pipes-faa's TPipeTcpTransportTests (Pipes.TransportTests),
  translated: both directions, the stream adapter, Close unblocking Accept,
  CloseAbort unblocking Read, the peer's drop detected, several clients.
  New here: the port reported after binding to 0, the peer address, the IO
  deadline on read and on write (also one per direction, as a pub/sub
  subscriber needs: a reader with none and a writer with one), CloseAbort from a third thread unblocking a
  reader and a writer at once, IPv6 loopback, connect errors, and a
  full-duplex bulk transfer (a reader and a writer on each endpoint at the
  same time) and a request-reply exchange (a reader waiting while another
  thread writes a large request). Those two are the patterns the Windows
  wake-up hand-off is for (PascalCommon.Transport.Tcp's header); they don't
  reproduce the race it closes, which needs a window of microseconds.

  Waits are deterministic: each thread sets an event when it ends and the
  test waits on it with a deadline; on a timeout it aborts the endpoints, so
  a hang becomes a failure instead of a stuck run. The only Sleeps give a
  thread a moment to enter a blocking call before it is aborted; the tests
  pass whether or not it got there in time (CloseAbort is also checked before
  every wait), so they never decide the result.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  PascalCommon.DUnitXCompat,
  SysUtils,
  Classes,
  SyncObjs,
  PascalCommon.Threading,
  PascalCommon.Transport,
  PascalCommon.Transport.Tcp;

type
  [TestFixture]
  TTcpTransportTests = class
  private
    FListener: TPcListener;
    FServerEp: TPcEndpoint;
    FClientEp: TPcEndpoint;
    FHost: string;
    FPort: Word;
    FTimeoutMs: Cardinal;
    // Listens on AHost:0, connects a client and fills the fields above.
    procedure OpenLoopback(const AHost: string);
    procedure DoConnect;
  public
    [Setup] procedure SetUp;
    [TearDown] procedure TearDown;
  public
    [Test] procedure Listen_PortZero_ReportsTheBoundPort;
    [Test] procedure Loopback_SendsAndReceivesBothWays;
    [Test] procedure EndpointStream_ReadBufferAndWriteBuffer;
    [Test] procedure Accept_UnblockedByClose;
    [Test] procedure Read_UnblockedByCloseAbort;
    [Test] procedure Read_DetectsThePeerDropping;
    [Test] procedure CloseAbort_FromAThirdThread_UnblocksReaderAndWriter;
    [Test] procedure SeveralClients_EachWithItsEndpoint;
    [Test] procedure TryPeerAddress_IsTheOtherSide;
    [Test] procedure SetIoDeadline_ReadTimesOut;
    [Test] procedure SetIoDeadline_WriteTimesOutWhenThePeerStopsReading;
    [Test] procedure SetWriteDeadline_WriterGivesUpWhileTheReaderWaitsOn;
    [Test] procedure SetReadDeadline_OnlyTheReadTimesOut;
    [Test] procedure FullDuplexBulk_ReaderAndWriterOnEachEndpoint;
    [Test] procedure RequestReply_WriterNotStarvedByAWaitingReader;
    [Test] procedure IPv6Loopback_WhereTheMachineHasIt;
    [Test] procedure Connect_ClosedPort_RaisesWithinTheBudget;
    [Test] procedure Connect_ClosedPort_IsRefused;
    [Test] procedure Connect_UnresolvableName_Raises;
    [Test] procedure Listen_PortInUse_Raises;
    [Test] procedure NoDelay_SmallWritesDontWaitForAcks;
  end;

implementation

const
  CWaitMs = 10000;   // a thread that takes longer than this is stuck

type
  { Accepts up to N connections, then sets Done. }
  TAcceptThread = class(TThread)
  private
    FListener: TPcListener;
    FAccepted: array of TPcEndpoint;
    FError: string;
  protected
    procedure Execute; override;
  public
    Done: TEvent;
    constructor Create(AListener: TPcListener; ACount: Integer);
    destructor Destroy; override;
    function Accepted(AIndex: Integer): TPcEndpoint;
  end;

  { Base for the IO threads: signals Started before the blocking work and
    Done at the end, and keeps the class of the exception that ended it. }
  TIoThread = class(TThread)
  protected
    FEndpoint: TPcEndpoint;
    FErrorClass: string;
    FErrorMessage: string;
    procedure Work; virtual; abstract;
    procedure Execute; override;
  public
    Started: TEvent;
    Done: TEvent;
    constructor Create(AEndpoint: TPcEndpoint);
    destructor Destroy; override;
    property ErrorClass: string read FErrorClass;
    property ErrorMessage: string read FErrorMessage;
  end;

  { One Read. }
  TReadOneThread = class(TIoThread)
  protected
    procedure Work; override;
  end;

  { Writes a byte pattern of ATotal bytes, in chunks. }
  TBulkWriter = class(TIoThread)
  private
    FTotal: Int64;
    FSeed: Byte;
  protected
    procedure Work; override;
  public
    constructor Create(AEndpoint: TPcEndpoint; ATotal: Int64; ASeed: Byte);
  end;

  { Reads ATotal bytes and checks the pattern TBulkWriter writes. }
  TBulkReader = class(TIoThread)
  private
    FTotal: Int64;
    FSeed: Byte;
    FReceived: Int64;
    FMismatchAt: Int64;
  protected
    procedure Work; override;
  public
    constructor Create(AEndpoint: TPcEndpoint; ATotal: Int64; ASeed: Byte);
    property Received: Int64 read FReceived;
    property MismatchAt: Int64 read FMismatchAt;
  end;

  { Writes until something stops it (no total). }
  TEndlessWriter = class(TIoThread)
  protected
    procedure Work; override;
  end;

  { Server side of the request-reply test: for each round, reads a whole
    request, then answers one byte. }
  TRequestServer = class(TIoThread)
  private
    FRounds: Integer;
    FRequestSize: Integer;
  protected
    procedure Work; override;
  public
    constructor Create(AEndpoint: TPcEndpoint; ARounds, ARequestSize: Integer);
  end;

  { Client side's reader: reads one reply byte per round. }
  TReplyReader = class(TIoThread)
  private
    FRounds: Integer;
    FReplies: Integer;
  protected
    procedure Work; override;
  public
    constructor Create(AEndpoint: TPcEndpoint; ARounds: Integer);
    property Replies: Integer read FReplies;
  end;

  { Server side of the latency test: per round, reads two one-byte writes
    and answers one byte. }
  TEchoRounds = class(TIoThread)
  private
    FRounds: Integer;
  protected
    procedure Work; override;
  public
    constructor Create(AEndpoint: TPcEndpoint; ARounds: Integer);
  end;

function PatternByte(AIndex: Int64; ASeed: Byte): Byte;
begin
  Result := Byte((AIndex * 7 + AIndex div 251 + ASeed) and $FF);
end;

function BufText(const ABuf; ALen: Integer): string;
var
  LText: AnsiString;
begin
  SetString(LText, PAnsiChar(@ABuf), ALen);
  Result := string(LText);
end;

function Opts: TPcTcpOptions;
begin
  Result := Default(TPcTcpOptions);
end;

{ TAcceptThread }

constructor TAcceptThread.Create(AListener: TPcListener; ACount: Integer);
begin
  FListener := AListener;
  SetLength(FAccepted, ACount);
  Done := TEvent.Create(nil, True, False, '');
  FreeOnTerminate := False;
  inherited Create(False);
end;

destructor TAcceptThread.Destroy;
begin
  inherited;
  Done.Free;
end;

procedure TAcceptThread.Execute;
var
  I: Integer;
begin
  try
    try
      for I := 0 to High(FAccepted) do
      begin
        FAccepted[I] := FListener.Accept;
        if FAccepted[I] = nil then
          Break; // listener closed
      end;
    except
      on E: Exception do
        FError := E.ClassName + ': ' + E.Message;
    end;
  finally
    Done.SetEvent;
  end;
end;

function TAcceptThread.Accepted(AIndex: Integer): TPcEndpoint;
begin
  Result := FAccepted[AIndex];
end;

{ TIoThread }

constructor TIoThread.Create(AEndpoint: TPcEndpoint);
begin
  FEndpoint := AEndpoint;
  Started := TEvent.Create(nil, True, False, '');
  Done := TEvent.Create(nil, True, False, '');
  FreeOnTerminate := False;
  inherited Create(False);
end;

destructor TIoThread.Destroy;
begin
  inherited;
  Started.Free;
  Done.Free;
end;

procedure TIoThread.Execute;
begin
  try
    try
      Started.SetEvent;
      Work;
    except
      on E: Exception do
      begin
        FErrorClass := E.ClassName;
        FErrorMessage := E.Message;
      end;
    end;
  finally
    Done.SetEvent;
  end;
end;

procedure TReadOneThread.Work;
var
  LBuf: array[0..63] of Byte;
begin
  FEndpoint.Read(LBuf, SizeOf(LBuf));
end;

constructor TBulkWriter.Create(AEndpoint: TPcEndpoint; ATotal: Int64;
  ASeed: Byte);
begin
  FTotal := ATotal;
  FSeed := ASeed;
  inherited Create(AEndpoint);
end;

procedure TBulkWriter.Work;
const
  CChunk = 256 * 1024;
var
  LBuf: TBytes;
  LSent: Int64;
  LLen, I: Integer;
begin
  SetLength(LBuf, CChunk);
  LSent := 0;
  while LSent < FTotal do
  begin
    LLen := CChunk;
    if FTotal - LSent < LLen then
      LLen := Integer(FTotal - LSent);
    for I := 0 to LLen - 1 do
      LBuf[I] := PatternByte(LSent + I, FSeed);
    FEndpoint.WriteExactly(LBuf[0], LLen);
    Inc(LSent, LLen);
  end;
end;

constructor TBulkReader.Create(AEndpoint: TPcEndpoint; ATotal: Int64;
  ASeed: Byte);
begin
  FTotal := ATotal;
  FSeed := ASeed;
  FMismatchAt := -1;
  inherited Create(AEndpoint);
end;

procedure TBulkReader.Work;
const
  CChunk = 64 * 1024;
var
  LBuf: TBytes;
  LGot, I: Integer;
  LWant: Int64;
begin
  SetLength(LBuf, CChunk);
  while FReceived < FTotal do
  begin
    LWant := FTotal - FReceived;
    if LWant > CChunk then
      LWant := CChunk;
    LGot := FEndpoint.Read(LBuf[0], Integer(LWant));
    if FMismatchAt < 0 then
      for I := 0 to LGot - 1 do
        if LBuf[I] <> PatternByte(FReceived + I, FSeed) then
        begin
          FMismatchAt := FReceived + I;
          Break;
        end;
    Inc(FReceived, LGot);
  end;
end;

procedure TEndlessWriter.Work;
var
  LBuf: TBytes;
begin
  SetLength(LBuf, 1024 * 1024);
  while True do
    FEndpoint.WriteExactly(LBuf[0], Length(LBuf));
end;

constructor TRequestServer.Create(AEndpoint: TPcEndpoint;
  ARounds, ARequestSize: Integer);
begin
  FRounds := ARounds;
  FRequestSize := ARequestSize;
  inherited Create(AEndpoint);
end;

procedure TRequestServer.Work;
var
  LBuf: TBytes;
  LRound, LLeft, LWant: Integer;
  LReply: Byte;
begin
  SetLength(LBuf, 16 * 1024); // small reads: many waits for room on the writer
  for LRound := 1 to FRounds do
  begin
    LLeft := FRequestSize;
    while LLeft > 0 do
    begin
      LWant := LLeft;
      if LWant > Length(LBuf) then
        LWant := Length(LBuf);
      Dec(LLeft, FEndpoint.Read(LBuf[0], LWant));
    end;
    LReply := Byte(LRound);
    FEndpoint.WriteExactly(LReply, 1);
  end;
end;

constructor TReplyReader.Create(AEndpoint: TPcEndpoint; ARounds: Integer);
begin
  FRounds := ARounds;
  inherited Create(AEndpoint);
end;

procedure TReplyReader.Work;
var
  LByte: Byte;
begin
  while FReplies < FRounds do
  begin
    FEndpoint.Read(LByte, 1);
    Inc(FReplies);
  end;
end;

constructor TEchoRounds.Create(AEndpoint: TPcEndpoint; ARounds: Integer);
begin
  FRounds := ARounds;
  inherited Create(AEndpoint);
end;

procedure TEchoRounds.Work;
var
  LBuf: array[0..1] of Byte;
  LGot, LRound: Integer;
begin
  for LRound := 1 to FRounds do
  begin
    LGot := 0;
    while LGot < 2 do
      Inc(LGot, FEndpoint.Read(LBuf[LGot], 2 - LGot));
    FEndpoint.WriteExactly(LBuf[0], 1);
  end;
end;

{ TTcpTransportTests }

procedure TTcpTransportTests.SetUp;
begin
  FListener := nil;
  FServerEp := nil;
  FClientEp := nil;
end;

procedure TTcpTransportTests.TearDown;
begin
  if Assigned(FListener) then
    FListener.Close;
  FreeAndNil(FClientEp);
  FreeAndNil(FServerEp);
  FreeAndNil(FListener);
end;

procedure TTcpTransportTests.OpenLoopback(const AHost: string);
var
  LAcc: TAcceptThread;
begin
  FListener := PcTcpListen(AHost, 0, Opts);
  LAcc := TAcceptThread.Create(FListener, 1);
  try
    try
      FClientEp := PcTcpConnect(AHost, FListener.Port, Opts);
    finally
      if LAcc.Done.WaitFor(CWaitMs) <> wrSignaled then
        FListener.Close; // unblocks the thread so WaitFor below returns
      LAcc.WaitFor;
    end;
    FServerEp := LAcc.Accepted(0);
    TAssert.AssertEquals('accept error', '', LAcc.FError);
  finally
    LAcc.Free;
  end;
  TAssert.AssertTrue('Accept returned no endpoint', FServerEp <> nil);
end;

procedure TTcpTransportTests.DoConnect;
var
  LOpts: TPcTcpOptions;
begin
  LOpts := Opts;
  LOpts.ConnectTimeoutMs := FTimeoutMs;
  FClientEp := PcTcpConnect(FHost, FPort, LOpts);
end;

procedure TTcpTransportTests.Listen_PortZero_ReportsTheBoundPort;
begin
  FListener := PcTcpListen('127.0.0.1', 0, Opts);
  TAssert.AssertTrue('Port should be the one the OS chose, not 0',
    FListener.Port > 0);
end;

procedure TTcpTransportTests.Loopback_SendsAndReceivesBothWays;
var
  LOut: AnsiString;
  LIn: array[0..15] of AnsiChar;
  LLen: Integer;
begin
  OpenLoopback('127.0.0.1');

  LOut := 'ping';
  FClientEp.WriteExactly(LOut[1], Length(LOut));
  LLen := FServerEp.Read(LIn[0], SizeOf(LIn));
  TAssert.AssertEquals(4, LLen);
  TAssert.AssertEquals('ping', BufText(LIn, LLen));

  LOut := 'pong!';
  FServerEp.WriteExactly(LOut[1], Length(LOut));
  LLen := FClientEp.Read(LIn[0], SizeOf(LIn));
  TAssert.AssertEquals(5, LLen);
  TAssert.AssertEquals('pong!', BufText(LIn, LLen));
end;

procedure TTcpTransportTests.EndpointStream_ReadBufferAndWriteBuffer;
var
  LCli, LSrv: TPcEndpointStream;
  LValue, LBack: Int64;
begin
  OpenLoopback('127.0.0.1');
  LCli := TPcEndpointStream.Create(FClientEp);
  LSrv := TPcEndpointStream.Create(FServerEp);
  try
    LValue := $0102030405060708;
    LCli.WriteBuffer(LValue, SizeOf(LValue));
    LBack := 0;
    LSrv.ReadBuffer(LBack, SizeOf(LBack));
    TAssert.AssertEquals(LValue, LBack);
    TAssert.AssertTrue('the stream does not own the endpoint',
      LSrv.Endpoint = FServerEp);
  finally
    LCli.Free;
    LSrv.Free;
  end;
end;

procedure TTcpTransportTests.Accept_UnblockedByClose;
var
  LAcc: TAcceptThread;
begin
  FListener := PcTcpListen('127.0.0.1', 0, Opts);
  LAcc := TAcceptThread.Create(FListener, 1);
  try
    Sleep(50); // a moment to enter Accept (not needed for the result)
    FListener.Close;
    TAssert.AssertTrue('Close did not unblock Accept',
      LAcc.Done.WaitFor(CWaitMs) = wrSignaled);
    LAcc.WaitFor;
    TAssert.AssertTrue('Accept should return nil after Close',
      LAcc.Accepted(0) = nil);
    TAssert.AssertEquals('', LAcc.FError);
  finally
    LAcc.Free;
  end;
end;

procedure TTcpTransportTests.Read_UnblockedByCloseAbort;
var
  LReader: TReadOneThread;
begin
  OpenLoopback('127.0.0.1');
  LReader := TReadOneThread.Create(FServerEp);
  try
    LReader.Started.WaitFor(CWaitMs);
    Sleep(50); // a moment to enter the wait (not needed for the result)
    FServerEp.CloseAbort;
    TAssert.AssertTrue('CloseAbort did not unblock Read',
      LReader.Done.WaitFor(CWaitMs) = wrSignaled);
    LReader.WaitFor;
    TAssert.AssertEquals(EPcTransportClosed.ClassName, LReader.ErrorClass);
  finally
    LReader.Free;
  end;
end;

procedure TTcpTransportTests.Read_DetectsThePeerDropping;
var
  LReader: TReadOneThread;
begin
  OpenLoopback('127.0.0.1');
  LReader := TReadOneThread.Create(FServerEp);
  try
    LReader.Started.WaitFor(CWaitMs);
    FreeAndNil(FClientEp); // closes the client's socket
    if LReader.Done.WaitFor(CWaitMs) <> wrSignaled then
      FServerEp.CloseAbort;
    LReader.WaitFor;
    TAssert.AssertEquals(EPcTransportClosed.ClassName, LReader.ErrorClass);
    TAssert.AssertEquals('connection closed by the peer', LReader.ErrorMessage);
  finally
    LReader.Free;
  end;
end;

procedure TTcpTransportTests.CloseAbort_FromAThirdThread_UnblocksReaderAndWriter;
var
  LReader: TReadOneThread;
  LWriter: TEndlessWriter;
  LBoth: Boolean;
begin
  // The server neither writes nor reads: the client's reader waits for data
  // and its writer, once the buffers fill, for room.
  OpenLoopback('127.0.0.1');
  LReader := TReadOneThread.Create(FClientEp);
  LWriter := TEndlessWriter.Create(FClientEp);
  try
    LReader.Started.WaitFor(CWaitMs);
    LWriter.Started.WaitFor(CWaitMs);
    Sleep(100); // a moment to fill the buffers (not needed for the result)
    FClientEp.CloseAbort; // this test's thread is the third one
    LBoth := (LReader.Done.WaitFor(CWaitMs) = wrSignaled)
      and (LWriter.Done.WaitFor(CWaitMs) = wrSignaled);
    if not LBoth then
      FServerEp.CloseAbort; // last resort, so the threads can be joined
    LReader.WaitFor;
    LWriter.WaitFor;
    TAssert.AssertTrue('CloseAbort did not unblock both threads', LBoth);
    TAssert.AssertEquals('reader', EPcTransportClosed.ClassName,
      LReader.ErrorClass);
    TAssert.AssertEquals('writer', EPcTransportClosed.ClassName,
      LWriter.ErrorClass);
  finally
    LReader.Free;
    LWriter.Free;
  end;
end;

procedure TTcpTransportTests.SeveralClients_EachWithItsEndpoint;
var
  LAcc: TAcceptThread;
  LClients: array[0..2] of TPcEndpoint;
  LByte: Byte;
  LSum, I, LLen: Integer;
begin
  FListener := PcTcpListen('127.0.0.1', 0, Opts);
  for I := 0 to 2 do
    LClients[I] := nil;
  LAcc := TAcceptThread.Create(FListener, 3);
  try
    try
      for I := 0 to 2 do
        LClients[I] := PcTcpConnect('127.0.0.1', FListener.Port, Opts);
    finally
      if LAcc.Done.WaitFor(CWaitMs) <> wrSignaled then
        FListener.Close;
      LAcc.WaitFor;
    end;
    for I := 0 to 2 do
      TAssert.AssertTrue('server endpoint ' + IntToStr(I) + ' is nil',
        LAcc.Accepted(I) <> nil);
    // Each client sends its own byte; {1,2,3} must arrive, in any order of
    // accept.
    for I := 0 to 2 do
    begin
      LByte := I + 1;
      LClients[I].WriteExactly(LByte, 1);
    end;
    LSum := 0;
    for I := 0 to 2 do
    begin
      LLen := LAcc.Accepted(I).Read(LByte, 1);
      TAssert.AssertEquals(1, LLen);
      TAssert.AssertTrue('unexpected byte', (LByte >= 1) and (LByte <= 3));
      LSum := LSum + LByte;
    end;
    TAssert.AssertEquals(6, LSum); // all three arrived, none twice
  finally
    for I := 0 to 2 do
      LClients[I].Free;
    for I := 0 to 2 do
      LAcc.Accepted(I).Free;
    LAcc.Free;
  end;
end;

procedure TTcpTransportTests.TryPeerAddress_IsTheOtherSide;
var
  LAddr, LHost: string;
  LPort: Word;
begin
  OpenLoopback('127.0.0.1');
  TAssert.AssertTrue('client side', FClientEp.TryPeerAddress(LAddr));
  TAssert.AssertEquals('127.0.0.1:' + IntToStr(FListener.Port), LAddr);
  TAssert.AssertTrue('server side', FServerEp.TryPeerAddress(LAddr));
  PcParseHostPort(LAddr, LHost, LPort); // a client port, unknown in advance
  TAssert.AssertEquals('127.0.0.1', LHost);
  FServerEp.CloseAbort;
  TAssert.AssertFalse('no address after CloseAbort',
    FServerEp.TryPeerAddress(LAddr));
end;

procedure TTcpTransportTests.SetIoDeadline_ReadTimesOut;
var
  LBuf: array[0..15] of Byte;
  T0, LElapsed: UInt64;
  LClass: string;
begin
  OpenLoopback('127.0.0.1');
  FClientEp.SetIoDeadline(200);
  LClass := '';
  T0 := PcTickMs;
  try
    FClientEp.Read(LBuf, SizeOf(LBuf)); // the server sends nothing
  except
    on E: Exception do
      LClass := E.ClassName;
  end;
  LElapsed := PcTickMs - T0;
  TAssert.AssertEquals(EPcTransportTimeout.ClassName, LClass);
  // The tick's resolution is ~16 ms on Windows: allow for it below.
  TAssert.AssertTrue('returned too early: ' + IntToStr(LElapsed) + ' ms',
    LElapsed >= 150);
  TAssert.AssertTrue('took too long: ' + IntToStr(LElapsed) + ' ms',
    LElapsed < 5000);
  // The endpoint is still usable after a timeout.
  FClientEp.SetIoDeadline(0);
  LBuf[0] := 42;
  FServerEp.WriteExactly(LBuf[0], 1);
  TAssert.AssertEquals(1, FClientEp.Read(LBuf, SizeOf(LBuf)));
  TAssert.AssertEquals(42, Integer(LBuf[0]));
end;

procedure TTcpTransportTests.SetIoDeadline_WriteTimesOutWhenThePeerStopsReading;
var
  LWriter: TEndlessWriter;
  LDone: Boolean;
begin
  // The server never reads: the buffers fill and a wait for room passes its
  // deadline. The writer runs on its own thread so that a deadline that
  // doesn't work ends as a failure here, not as a hung run (it did hang on
  // Linux before MSG_DONTWAIT; see PascalCommon.Transport.Posix).
  OpenLoopback('127.0.0.1');
  FClientEp.SetIoDeadline(300);
  LWriter := TEndlessWriter.Create(FClientEp);
  try
    LDone := LWriter.Done.WaitFor(CWaitMs) = wrSignaled;
    if not LDone then
      FClientEp.CloseAbort;
    LWriter.WaitFor;
    TAssert.AssertTrue('the write deadline did not fire', LDone);
    TAssert.AssertEquals(EPcTransportTimeout.ClassName, LWriter.ErrorClass);
  finally
    LWriter.Free;
  end;
end;

procedure TTcpTransportTests.SetWriteDeadline_WriterGivesUpWhileTheReaderWaitsOn;
var
  LReader: TReadOneThread;
  LWriter: TEndlessWriter;
  LWriterDone, LReaderDone: Boolean;
  LBuf: Byte;
begin
  // A pub/sub subscriber's shape: a reader waiting with no deadline (silence
  // is normal there) and a writer, on the same endpoint, that must give up
  // when the server stops reading. The server neither reads nor writes.
  OpenLoopback('127.0.0.1');
  FClientEp.SetReadDeadline(0);
  FClientEp.SetWriteDeadline(300);
  LReader := TReadOneThread.Create(FClientEp);
  LWriter := nil;
  try
    LReader.Started.WaitFor(CWaitMs);
    LWriter := TEndlessWriter.Create(FClientEp);
    LWriterDone := LWriter.Done.WaitFor(CWaitMs) = wrSignaled;
    // The reader has no deadline: it must still be waiting, long after the
    // writer's 300 ms (a deadline shared by both would have ended it too).
    LReaderDone := LReader.Done.WaitFor(0) = wrSignaled;
    // Data still arrives on the endpoint whose write timed out.
    LBuf := 7;
    FServerEp.WriteExactly(LBuf, 1);
    if LReader.Done.WaitFor(CWaitMs) <> wrSignaled then
      FClientEp.CloseAbort;
    if not LWriterDone then
      FClientEp.CloseAbort;
    LWriter.WaitFor;
    LReader.WaitFor;
    TAssert.AssertTrue('the write deadline did not fire', LWriterDone);
    TAssert.AssertEquals(EPcTransportTimeout.ClassName, LWriter.ErrorClass);
    TAssert.AssertFalse('the reader got the writer''s deadline', LReaderDone);
    TAssert.AssertEquals('the reader', '', LReader.ErrorClass);
  finally
    LWriter.Free;
    LReader.Free;
  end;
end;

procedure TTcpTransportTests.SetReadDeadline_OnlyTheReadTimesOut;
var
  LBuf: array[0..15] of Byte;
  LClass: string;
begin
  OpenLoopback('127.0.0.1');
  FClientEp.SetIoDeadline(5000);
  FClientEp.SetReadDeadline(200); // the write deadline stays 5000
  LClass := '';
  try
    FClientEp.Read(LBuf, SizeOf(LBuf)); // the server sends nothing
  except
    on E: Exception do
      LClass := E.ClassName;
  end;
  TAssert.AssertEquals(EPcTransportTimeout.ClassName, LClass);
  // SetIoDeadline sets both again: 0 removes the read deadline too.
  FClientEp.SetIoDeadline(0);
  LBuf[0] := 9;
  FServerEp.WriteExactly(LBuf[0], 1);
  TAssert.AssertEquals(1, FClientEp.Read(LBuf, SizeOf(LBuf)));
  TAssert.AssertEquals(9, Integer(LBuf[0]));
end;

procedure TTcpTransportTests.FullDuplexBulk_ReaderAndWriterOnEachEndpoint;
const
  CTotal = 16 * 1024 * 1024;
  CBulkWaitMs = 60000;
var
  LCliW, LSrvW: TBulkWriter;
  LCliR, LSrvR: TBulkReader;
  LAllDone: Boolean;
begin
  // Both sides write a lot at once while also reading: the send buffers
  // fill, writers wait for room while readers wait for data, on the same
  // endpoint. A writer that misses its wake-up hangs here.
  OpenLoopback('127.0.0.1');
  LCliW := nil; LSrvW := nil; LCliR := nil; LSrvR := nil;
  try
    LSrvR := TBulkReader.Create(FServerEp, CTotal, 1);
    LCliR := TBulkReader.Create(FClientEp, CTotal, 2);
    LCliW := TBulkWriter.Create(FClientEp, CTotal, 1);
    LSrvW := TBulkWriter.Create(FServerEp, CTotal, 2);
    LAllDone := (LCliW.Done.WaitFor(CBulkWaitMs) = wrSignaled)
      and (LSrvW.Done.WaitFor(CBulkWaitMs) = wrSignaled)
      and (LCliR.Done.WaitFor(CBulkWaitMs) = wrSignaled)
      and (LSrvR.Done.WaitFor(CBulkWaitMs) = wrSignaled);
    if not LAllDone then
    begin
      FClientEp.CloseAbort; // so the threads can be joined
      FServerEp.CloseAbort;
    end;
    LCliW.WaitFor; LSrvW.WaitFor; LCliR.WaitFor; LSrvR.WaitFor;
    TAssert.AssertTrue(Format('stuck: client wrote? %s, server wrote? %s, ' +
      'server read %d, client read %d of %d',
      [BoolToStr(LCliW.ErrorClass = '', True), BoolToStr(LSrvW.ErrorClass = '', True),
       LSrvR.Received, LCliR.Received, CTotal]), LAllDone);
    TAssert.AssertEquals('client writer', '', LCliW.ErrorClass);
    TAssert.AssertEquals('server writer', '', LSrvW.ErrorClass);
    TAssert.AssertEquals('server reader', '', LSrvR.ErrorClass);
    TAssert.AssertEquals('client reader', '', LCliR.ErrorClass);
    TAssert.AssertEquals('server received', Int64(CTotal), LSrvR.Received);
    TAssert.AssertEquals('client received', Int64(CTotal), LCliR.Received);
    TAssert.AssertEquals('server mismatch', Int64(-1), LSrvR.MismatchAt);
    TAssert.AssertEquals('client mismatch', Int64(-1), LCliR.MismatchAt);
  finally
    LCliW.Free; LSrvW.Free; LCliR.Free; LSrvR.Free;
  end;
end;

procedure TTcpTransportTests.RequestReply_WriterNotStarvedByAWaitingReader;
const
  CRounds = 40;
  CRequestSize = 2 * 1024 * 1024;
var
  LServer: TRequestServer;
  LReader: TReplyReader;
  LBuf: TBytes;
  I: Integer;
  LDone: Boolean;
  LWriteError: string;
begin
  // The pattern of a client with a reader thread (Kafka, AMQP): the reader
  // waits for replies while another thread writes a large request, and the
  // server answers only after reading the whole request. If the reader takes
  // the writer's wake-up (the FD_WRITE, on Windows), nothing else arrives to
  // wake the writer, and both sides wait for each other forever.
  OpenLoopback('127.0.0.1');
  LServer := TRequestServer.Create(FServerEp, CRounds, CRequestSize);
  LReader := TReplyReader.Create(FClientEp, CRounds);
  try
    SetLength(LBuf, CRequestSize);
    LWriteError := '';
    // A deadline, so a starved writer ends as a failure, not a hang.
    FClientEp.SetIoDeadline(20000);
    try
      for I := 1 to CRounds do
        FClientEp.WriteExactly(LBuf[0], Length(LBuf));
    except
      on E: Exception do
        LWriteError := E.ClassName + ': ' + E.Message;
    end;
    LDone := (LReader.Done.WaitFor(CWaitMs) = wrSignaled)
      and (LServer.Done.WaitFor(CWaitMs) = wrSignaled);
    if not LDone then
    begin
      FClientEp.CloseAbort;
      FServerEp.CloseAbort;
    end;
    LServer.WaitFor;
    LReader.WaitFor;
    TAssert.AssertEquals('writer', '', LWriteError);
    TAssert.AssertTrue('stuck', LDone);
    TAssert.AssertEquals('server', '', LServer.ErrorClass);
    TAssert.AssertEquals('reader', '', LReader.ErrorClass);
    TAssert.AssertEquals(CRounds, LReader.Replies);
  finally
    LServer.Free;
    LReader.Free;
  end;
end;

procedure TTcpTransportTests.IPv6Loopback_WhereTheMachineHasIt;
var
  LAddr: string;
  LByte: Byte;
begin
  try
    FListener := PcTcpListen('::1', 0, Opts);
  except
    on EPcTransport do
    begin
      // No IPv6 here (a container started without it): nothing to test.
      TAssert.AssertTrue(True);
      Exit;
    end;
  end;
  FreeAndNil(FListener);
  OpenLoopback('::1');
  TAssert.AssertTrue(FClientEp.TryPeerAddress(LAddr));
  TAssert.AssertEquals('[0:0:0:0:0:0:0:1]:' + IntToStr(FListener.Port), LAddr);
  LByte := 7;
  FClientEp.WriteExactly(LByte, 1);
  LByte := 0;
  TAssert.AssertEquals(1, FServerEp.Read(LByte, 1));
  TAssert.AssertEquals(7, Integer(LByte));
end;

procedure TTcpTransportTests.Connect_ClosedPort_RaisesWithinTheBudget;
var
  LListener: TPcListener;
  T0, LElapsed: UInt64;
  LRaised: Boolean;
begin
  // A port that was free a moment ago: nobody listens there now.
  LListener := PcTcpListen('127.0.0.1', 0, Opts);
  FPort := LListener.Port;
  LListener.Free;
  FHost := '127.0.0.1';
  FTimeoutMs := 1000;
  LRaised := False;
  T0 := PcTickMs;
  try
    DoConnect;
  except
    // Linux refuses at once; Windows retries the SYN on loopback for about
    // 2 s, so with this budget it ends as a timeout. Both are EPcTransport.
    on EPcTransport do
      LRaised := True;
  end;
  LElapsed := PcTickMs - T0;
  TAssert.AssertTrue('connect to a closed port should raise', LRaised);
  TAssert.AssertTrue('ignored the budget: ' + IntToStr(LElapsed) + ' ms',
    LElapsed < 3000);
end;

procedure TTcpTransportTests.Connect_ClosedPort_IsRefused;
var
  LListener: TPcListener;
  LClass: string;
begin
  // A budget longer than Windows' ~2 s of SYN retries on loopback, so both
  // platforms end with the refusal itself: the class a library's retry loop
  // tells apart from a name that doesn't resolve (EPcTransport).
  LListener := PcTcpListen('127.0.0.1', 0, Opts);
  FPort := LListener.Port;
  LListener.Free;
  FHost := '127.0.0.1';
  FTimeoutMs := 6000;
  LClass := '';
  try
    DoConnect;
  except
    on E: Exception do
      LClass := E.ClassName;
  end;
  TAssert.AssertEquals(EPcTransportRefused.ClassName, LClass);
end;

procedure TTcpTransportTests.Connect_UnresolvableName_Raises;
var
  LClass: string;
begin
  FHost := 'no-such-host.invalid'; // RFC 6761: never resolves
  FPort := 80;
  FTimeoutMs := 5000;
  LClass := '';
  try
    DoConnect;
  except
    on E: Exception do
      LClass := E.ClassName;
  end;
  TAssert.AssertEquals(EPcTransport.ClassName, LClass);
end;

procedure TTcpTransportTests.Listen_PortInUse_Raises;
var
  LSecond: TPcListener;
  LClass: string;
begin
  FListener := PcTcpListen('127.0.0.1', 0, Opts);
  LClass := '';
  LSecond := nil;
  try
    try
      LSecond := PcTcpListen('127.0.0.1', FListener.Port, Opts);
    except
      on E: Exception do
        LClass := E.ClassName;
    end;
  finally
    LSecond.Free;
  end;
  TAssert.AssertEquals(EPcTransport.ClassName, LClass);
end;

procedure TTcpTransportTests.NoDelay_SmallWritesDontWaitForAcks;
const
  CRounds = 20;
var
  LEcho: TEchoRounds;
  LByte: Byte;
  LRound: Integer;
  T0, LElapsed: UInt64;
begin
  // TCP_NODELAY can't be read back from an endpoint, so its effect is what
  // is checked. Two small writes then a read is the case Nagle's algorithm
  // and delayed ACKs stall: the second write waits for the ACK of the first,
  // which the peer delays (about 40 ms per round on Linux). From
  // pascal-amqp-faa's guard (its migration, step 5): 9 ms measured on Linux,
  // 1634 ms with Nagle on. Windows loopback hides it (it passes either way
  // there); Linux is where this test bites.
  OpenLoopback('127.0.0.1');
  LEcho := TEchoRounds.Create(FServerEp, CRounds);
  try
    T0 := PcTickMs;
    for LRound := 1 to CRounds do
    begin
      LByte := 1;
      FClientEp.WriteExactly(LByte, 1);
      LByte := 2;
      FClientEp.WriteExactly(LByte, 1);
      FClientEp.Read(LByte, 1);
    end;
    LElapsed := PcTickMs - T0;
    if LEcho.Done.WaitFor(CWaitMs) <> wrSignaled then
      FServerEp.CloseAbort;
    LEcho.WaitFor;
    TAssert.AssertEquals('echo', '', LEcho.ErrorClass);
    TAssert.AssertTrue(Format('%d rounds took %d ms: is TCP_NODELAY off?',
      [CRounds, LElapsed]), LElapsed < 400);
  finally
    LEcho.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TTcpTransportTests);

end.
