unit PascalCommon.SingleFlightTests;

{ Tests for PascalCommon.SingleFlight: N threads on one key run the loader
  once and get the same value; different keys run at the same time; the
  loader's exception reaches every thread (the same class and message, or
  EPcSingleFlightError when it can't be built again); the key is forgotten
  after the flight; T as a value, a record and an interface, a class refused;
  a re-entrant call raises; an overridden WaiterException is used. Also two
  TPcCache cases that its own suite doesn't cover and that moving GetOrLoad
  onto this unit had to keep: a store bug in Put reaches the loading thread
  while the waiters get the value, and a loader raising a non-Exception.

  No test hopes on Sleep: the loader blocks on an event and is released only
  once every other thread waits for it (Waiting, LoadsWaiting), and every
  wait has a deadline.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  PascalCommon.DUnitXCompat,
  Classes,
  SysUtils,
  SyncObjs,
  PascalCommon.Threading,
  PascalCommon.Cache,
  PascalCommon.SingleFlight;

type
  [TestFixture]
  TSingleFlightTests = class
  public
    [Test] procedure Run_ConcurrentCalls_LoadOnceAndShareTheValue;
    [Test] procedure Run_DifferentKeys_RunAtTheSameTime;
    [Test] procedure Run_LoaderRaises_EveryThreadGetsTheClassAndMessage;
    [Test] procedure Run_LoaderRaisesANonException_WaitersGetEPcSingleFlightError;
    [Test] procedure Run_AfterTheFlight_TheLoaderRunsAgain;
    [Test] procedure Run_ValueRecordAndInterface;
    [Test] procedure Create_ClassT_IsRefused;
    [Test] procedure Run_ReentrantCall_Raises;
    [Test] procedure WaiterException_HeapAndUnbuildableClasses_AreWrapped;
    [Test] procedure WaiterException_Override_IsUsed;
    [Test] procedure Cache_PutBug_LoadingThreadGetsItWaitersGetTheValue;
    [Test] procedure Cache_LoaderRaisesANonException_WaitersGetEPcCacheLoadError;
  end;

implementation

const
  THREADS = 8;

type
  TRaiseMode = (rmNone, rmConvert, rmNonException);

  /// Raised by a loader to test what isn't an Exception.
  TNotAnException = class
  end;

  /// An exception class that can't be built: NewInstance raises.
  EUnbuildable = class(Exception)
  public
    class function NewInstance: TObject; override;
  end;

  /// What the overriding flight gives to waiters.
  ECustomWaiter = class(Exception);

  TRec = record
    Number: Integer;
    Text: string;
  end;

  { The loader: counts its runs, optionally blocks until Release is set
    (deadline 10 s), then returns 'loaded:' + AArg or raises as Mode says. }
  TLoaderHost = class
  public
    Calls: Integer;
    Started: TEvent;
    Release: TEvent;
    Mode: TRaiseMode;
    Flight: TPcSingleFlight<string>;
    constructor Create(ABlock: Boolean);
    destructor Destroy; override;
    function Load(const AArg: string): string;
    function LoadInt(const AArg: string): Integer;
    function LoadRec(const AArg: string): TRec;
    function LoadIntf(const AArg: string): IInterface;
    function LoadReentrant(const AArg: string): string;
  end;

  /// Exposes WaiterException; optionally overrides it.
  TTestFlight = class(TPcSingleFlight<string>)
  protected
    function WaiterException(AClass: ExceptClass;
      const AClassName, AMessage: string): Exception; override;
  public
    Custom: Boolean;
    function CallWaiterException(AClass: ExceptClass;
      const AClassName, AMessage: string): Exception;
  end;

  { Calls Flight.Run (or Cache.GetOrLoad when Cache is set) once and keeps
    what came back. }
  TRunThread = class(TThread)
  private
    FFlight: TPcSingleFlight<string>;
    FCache: IPcCache;
    FHost: TLoaderHost;
    FKey: string;
  protected
    procedure Execute; override;
  public
    Value: string;
    ErrorClass: string;
    ErrorOriginalClass: string;
    ErrorMessage: string;
    ErrorHelpContext: Integer;
    constructor Create(AFlight: TPcSingleFlight<string>; const ACache: IPcCache;
      AHost: TLoaderHost; const AKey: string);
  end;

  TThreadArray = array[0..THREADS - 1] of TRunThread;

  /// Every read misses; Put raises a bug (not EPcCacheUnavailable).
  TPutBugStore = class(TInterfacedObject, IPcCacheStore)
  public
    function TryGet(const AKey: string; out AValue: string): Boolean;
    procedure Put(const AKey, AValue: string; ATtlMs: Int64);
    procedure Delete(const AKey: string);
    function Generations(const ATags: array of string): TArray<Int64>;
    procedure Bump(const ATags: array of string);
  end;

var
  GNameSeq: Integer;

class function EUnbuildable.NewInstance: TObject;
begin
  Result := nil;
  raise EInvalidOperation.Create('cannot build (test)');
end;

constructor TLoaderHost.Create(ABlock: Boolean);
begin
  inherited Create;
  Started := TEvent.Create(nil, True, False, '');
  if ABlock then
    Release := TEvent.Create(nil, True, False, '');
end;

destructor TLoaderHost.Destroy;
begin
  Started.Free;
  Release.Free;
  inherited Destroy;
end;

function TLoaderHost.Load(const AArg: string): string;
var
  LError: EConvertError;
begin
  PcAtomicInc(Calls);
  Started.SetEvent;
  if Release <> nil then
    Release.WaitFor(10000);
  case Mode of
    rmConvert:
      begin
        LError := EConvertError.Create('loader failed (test)');
        LError.HelpContext := 42;
        raise LError;
      end;
    rmNonException:
      raise TNotAnException.Create;
  end;
  Result := 'loaded:' + AArg;
end;

function TLoaderHost.LoadInt(const AArg: string): Integer;
begin
  PcAtomicInc(Calls);
  Result := StrToInt(AArg) * 2;
end;

function TLoaderHost.LoadRec(const AArg: string): TRec;
begin
  PcAtomicInc(Calls);
  Result.Number := 7;
  Result.Text := AArg;
end;

function TLoaderHost.LoadIntf(const AArg: string): IInterface;
begin
  PcAtomicInc(Calls);
  Result := TInterfacedObject.Create;
end;

function TLoaderHost.LoadReentrant(const AArg: string): string;
begin
  PcAtomicInc(Calls);
  Result := Flight.Run(AArg, Load, AArg);
end;

function TTestFlight.WaiterException(AClass: ExceptClass;
  const AClassName, AMessage: string): Exception;
begin
  if Custom then
    Result := ECustomWaiter.Create('custom: ' + AMessage)
  else
    Result := inherited WaiterException(AClass, AClassName, AMessage);
end;

function TTestFlight.CallWaiterException(AClass: ExceptClass;
  const AClassName, AMessage: string): Exception;
begin
  Result := WaiterException(AClass, AClassName, AMessage);
end;

constructor TRunThread.Create(AFlight: TPcSingleFlight<string>; const ACache: IPcCache;
  AHost: TLoaderHost; const AKey: string);
begin
  FFlight := AFlight;
  FCache := ACache;
  FHost := AHost;
  FKey := AKey;
  FreeOnTerminate := False;
  inherited Create(False);
end;

procedure TRunThread.Execute;
begin
  try
    if FCache <> nil then
      Value := FCache.GetOrLoad(FKey, 60, FHost.Load, 'x')
    else
      Value := FFlight.Run(FKey, FHost.Load, 'x');
  except
    on E: EPcSingleFlightError do
    begin
      ErrorClass := E.ClassName;
      ErrorOriginalClass := E.OriginalClassName;
      ErrorMessage := E.Message;
    end;
    on E: EPcCacheLoadError do
    begin
      ErrorClass := E.ClassName;
      ErrorOriginalClass := E.OriginalClassName;
      ErrorMessage := E.Message;
    end;
    on E: Exception do
    begin
      ErrorClass := E.ClassName;
      ErrorMessage := E.Message;
      ErrorHelpContext := E.HelpContext;
    end
    else
      ErrorClass := 'non-exception:' + ExceptObject.ClassName;
  end;
end;

function TPutBugStore.TryGet(const AKey: string; out AValue: string): Boolean;
begin
  AValue := '';
  Result := False;
end;

procedure TPutBugStore.Put(const AKey, AValue: string; ATtlMs: Int64);
begin
  raise EInvalidOperation.Create('put bug (test)');
end;

procedure TPutBugStore.Delete(const AKey: string);
begin
end;

function TPutBugStore.Generations(const ATags: array of string): TArray<Int64>;
begin
  Result := nil;
  SetLength(Result, Length(ATags));
end;

procedure TPutBugStore.Bump(const ATags: array of string);
begin
end;

// Waits until AWaiting returns AExpected; False past the deadline.
function WaitFlightWaiting(AFlight: TPcSingleFlight<string>; AExpected: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + 10000;
  while (AFlight.Waiting < AExpected) and (PcTickMs < LDeadline) do
    Sleep(1);
  Result := AFlight.Waiting = AExpected;
end;

function WaitCacheWaiting(ACache: TPcCache; AExpected: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + 10000;
  while (ACache.LoadsWaiting < AExpected) and (PcTickMs < LDeadline) do
    Sleep(1);
  Result := ACache.LoadsWaiting = AExpected;
end;

// Starts THREADS threads on one key (on AFlight, or on ACacheObject's
// GetOrLoad when it is set) with a blocking loader, releases it once the
// other THREADS - 1 wait, and waits for them all.
procedure RunConcurrent(AFlight: TPcSingleFlight<string>; ACacheObject: TPcCache;
  AHost: TLoaderHost; out AThreads: TThreadArray);
var
  LCache: IPcCache;
  I: Integer;
begin
  LCache := ACacheObject;
  for I := 0 to THREADS - 1 do
    AThreads[I] := nil;
  try
    for I := 0 to THREADS - 1 do
      if LCache <> nil then
        AThreads[I] := TRunThread.Create(nil, LCache, AHost, LCache.Key('k', []))
      else
        AThreads[I] := TRunThread.Create(AFlight, nil, AHost, 'k');
    TAssert.AssertTrue('the loader must start', AHost.Started.WaitFor(10000) = wrSignaled);
    if LCache <> nil then
      TAssert.AssertTrue('every other thread must wait for the load',
        WaitCacheWaiting(ACacheObject, THREADS - 1))
    else
      TAssert.AssertTrue('every other thread must wait for the load',
        WaitFlightWaiting(AFlight, THREADS - 1));
  finally
    if AHost.Release <> nil then
      AHost.Release.SetEvent;
    for I := 0 to THREADS - 1 do
      if AThreads[I] <> nil then
        AThreads[I].WaitFor;
  end;
end;

procedure FreeThreads(var AThreads: TThreadArray);
var
  I: Integer;
begin
  for I := 0 to THREADS - 1 do
    FreeAndNil(AThreads[I]);
end;

function NewName: string;
begin
  Result := 'sf-test-' + IntToStr(PcAtomicInc(GNameSeq));
end;

{ TSingleFlightTests }

procedure TSingleFlightTests.Run_ConcurrentCalls_LoadOnceAndShareTheValue;
var
  LFlight: TPcSingleFlight<string>;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  I: Integer;
begin
  LFlight := TPcSingleFlight<string>.Create;
  LHost := TLoaderHost.Create(True);
  try
    RunConcurrent(LFlight, nil, LHost, LThreads);
    try
      TAssert.AssertEquals('the loader ran once', 1, LHost.Calls);
      for I := 0 to THREADS - 1 do
      begin
        TAssert.AssertEquals('no error', '', LThreads[I].ErrorClass);
        TAssert.AssertEquals('loaded:x', LThreads[I].Value);
      end;
      TAssert.AssertEquals('nobody waits after the flight', 0, LFlight.Waiting);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.Run_DifferentKeys_RunAtTheSameTime;
var
  LFlight: TPcSingleFlight<string>;
  LHostA, LHostB: TLoaderHost;
  LThreadA, LThreadB: TRunThread;
begin
  LFlight := TPcSingleFlight<string>.Create;
  LHostA := TLoaderHost.Create(True);
  LHostB := TLoaderHost.Create(True);
  LThreadA := nil;
  LThreadB := nil;
  try
    try
      LThreadA := TRunThread.Create(LFlight, nil, LHostA, 'a');
      LThreadB := TRunThread.Create(LFlight, nil, LHostB, 'b');
      // Both loaders are running before either is released.
      TAssert.AssertTrue('loader a runs', LHostA.Started.WaitFor(10000) = wrSignaled);
      TAssert.AssertTrue('loader b runs while a is held', LHostB.Started.WaitFor(10000) = wrSignaled);
      TAssert.AssertEquals('neither waits for the other', 0, LFlight.Waiting);
    finally
      LHostA.Release.SetEvent;
      LHostB.Release.SetEvent;
      if LThreadA <> nil then
        LThreadA.WaitFor;
      if LThreadB <> nil then
        LThreadB.WaitFor;
    end;
    TAssert.AssertEquals('loaded:x', LThreadA.Value);
    TAssert.AssertEquals('loaded:x', LThreadB.Value);
    TAssert.AssertEquals(1, LHostA.Calls);
    TAssert.AssertEquals(1, LHostB.Calls);
  finally
    LThreadA.Free;
    LThreadB.Free;
    LHostA.Free;
    LHostB.Free;
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.Run_LoaderRaises_EveryThreadGetsTheClassAndMessage;
var
  LFlight: TPcSingleFlight<string>;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  I: Integer;
begin
  LFlight := TPcSingleFlight<string>.Create;
  LHost := TLoaderHost.Create(True);
  try
    LHost.Mode := rmConvert;
    RunConcurrent(LFlight, nil, LHost, LThreads);
    try
      TAssert.AssertEquals('the loader ran once', 1, LHost.Calls);
      for I := 0 to THREADS - 1 do
      begin
        TAssert.AssertEquals('the same class in every thread', 'EConvertError', LThreads[I].ErrorClass);
        TAssert.AssertEquals('loader failed (test)', LThreads[I].ErrorMessage);
        TAssert.AssertEquals('the same HelpContext', 42, LThreads[I].ErrorHelpContext);
        TAssert.AssertEquals('no value', '', LThreads[I].Value);
      end;
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.Run_LoaderRaisesANonException_WaitersGetEPcSingleFlightError;
var
  LFlight: TPcSingleFlight<string>;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  LLeader, LWaiters, I: Integer;
begin
  LFlight := TPcSingleFlight<string>.Create;
  LHost := TLoaderHost.Create(True);
  try
    LHost.Mode := rmNonException;
    RunConcurrent(LFlight, nil, LHost, LThreads);
    try
      LLeader := 0;
      LWaiters := 0;
      for I := 0 to THREADS - 1 do
        if LThreads[I].ErrorClass = 'non-exception:TNotAnException' then
          Inc(LLeader)
        else if (LThreads[I].ErrorClass = 'EPcSingleFlightError')
          and (LThreads[I].ErrorOriginalClass = 'TNotAnException') then
          Inc(LWaiters);
      TAssert.AssertEquals('the loading thread gets what was raised', 1, LLeader);
      TAssert.AssertEquals('each waiter gets EPcSingleFlightError', THREADS - 1, LWaiters);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.Run_AfterTheFlight_TheLoaderRunsAgain;
var
  LFlight: TPcSingleFlight<string>;
  LHost: TLoaderHost;
  LRaised: Boolean;
begin
  LFlight := TPcSingleFlight<string>.Create;
  LHost := TLoaderHost.Create(False);
  try
    TAssert.AssertEquals('loaded:1', LFlight.Run('k', LHost.Load, '1'));
    TAssert.AssertEquals('nothing is kept: a new flight', 'loaded:2', LFlight.Run('k', LHost.Load, '2'));
    TAssert.AssertEquals(2, LHost.Calls);
    LHost.Mode := rmConvert;
    LRaised := False;
    try
      LFlight.Run('k', LHost.Load, '3');
    except
      on E: EConvertError do
        LRaised := True;
    end;
    TAssert.AssertTrue('the loader raised', LRaised);
    LHost.Mode := rmNone;
    TAssert.AssertEquals('a failed flight is forgotten too', 'loaded:4', LFlight.Run('k', LHost.Load, '4'));
    TAssert.AssertEquals(4, LHost.Calls);
  finally
    LHost.Free;
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.Run_ValueRecordAndInterface;
var
  LHost: TLoaderHost;
  LInts: TPcSingleFlight<Integer>;
  LRecs: TPcSingleFlight<TRec>;
  LIntfs: TPcSingleFlight<IInterface>;
  LRec: TRec;
begin
  LHost := TLoaderHost.Create(False);
  LInts := nil;
  LRecs := nil;
  LIntfs := nil;
  try
    LInts := TPcSingleFlight<Integer>.Create;
    LRecs := TPcSingleFlight<TRec>.Create;
    LIntfs := TPcSingleFlight<IInterface>.Create;
    TAssert.AssertEquals(42, LInts.Run('a', LHost.LoadInt, '21'));
    LRec := LRecs.Run('a', LHost.LoadRec, 'São Paulo');
    TAssert.AssertEquals(7, LRec.Number);
    TAssert.AssertEquals('São Paulo', LRec.Text);
    TAssert.AssertTrue('an interface comes back', LIntfs.Run('a', LHost.LoadIntf, '') <> nil);
    TAssert.AssertEquals(3, LHost.Calls);
  finally
    LIntfs.Free;
    LRecs.Free;
    LInts.Free;
    LHost.Free;
  end;
end;

procedure TSingleFlightTests.Create_ClassT_IsRefused;
var
  LRaised: Boolean;
begin
  LRaised := False;
  try
    TPcSingleFlight<TObject>.Create.Free;
  except
    on E: EArgumentException do
      LRaised := True;
  end;
  TAssert.AssertTrue('a class T raises EArgumentException', LRaised);
end;

procedure TSingleFlightTests.Run_ReentrantCall_Raises;
var
  LFlight: TPcSingleFlight<string>;
  LHost: TLoaderHost;
  LClass: string;
begin
  LFlight := TPcSingleFlight<string>.Create;
  LHost := TLoaderHost.Create(False);
  try
    LHost.Flight := LFlight;
    LClass := '';
    try
      LFlight.Run('k', LHost.LoadReentrant, 'k');
    except
      on E: Exception do
        LClass := E.ClassName;
    end;
    TAssert.AssertEquals('raises instead of waiting for itself', 'EPcSingleFlightError', LClass);
    TAssert.AssertEquals('the inner loader never ran', 1, LHost.Calls);
    TAssert.AssertEquals('the key is free again', 'loaded:x', LFlight.Run('k', LHost.Load, 'x'));
  finally
    LHost.Free;
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.WaiterException_HeapAndUnbuildableClasses_AreWrapped;
var
  LFlight: TTestFlight;
  LError: Exception;
begin
  LFlight := TTestFlight.Create;
  try
    LError := LFlight.CallWaiterException(EOutOfMemory, 'EOutOfMemory', 'm1');
    try
      TAssert.AssertEquals('a heap exception is wrapped', 'EPcSingleFlightError', LError.ClassName);
      TAssert.AssertEquals('EOutOfMemory', EPcSingleFlightError(LError).OriginalClassName);
      TAssert.AssertEquals('m1', LError.Message);
    finally
      LError.Free;
    end;
    LError := LFlight.CallWaiterException(EInvalidPointer, 'EInvalidPointer', 'm2');
    try
      TAssert.AssertEquals('EPcSingleFlightError', LError.ClassName);
    finally
      LError.Free;
    end;
    LError := LFlight.CallWaiterException(EUnbuildable, 'EUnbuildable', 'm3');
    try
      TAssert.AssertEquals('a class whose Create raises is wrapped', 'EPcSingleFlightError', LError.ClassName);
      TAssert.AssertEquals('EUnbuildable', EPcSingleFlightError(LError).OriginalClassName);
    finally
      LError.Free;
    end;
    LError := LFlight.CallWaiterException(EConvertError, 'EConvertError', 'm4');
    try
      TAssert.AssertEquals('any other class is built again', 'EConvertError', LError.ClassName);
      TAssert.AssertEquals('m4', LError.Message);
    finally
      LError.Free;
    end;
  finally
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.WaiterException_Override_IsUsed;
var
  LFlight: TTestFlight;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  LOriginal, LCustom, I: Integer;
begin
  LFlight := TTestFlight.Create;
  LFlight.Custom := True;
  LHost := TLoaderHost.Create(True);
  try
    LHost.Mode := rmConvert;
    RunConcurrent(LFlight, nil, LHost, LThreads);
    try
      LOriginal := 0;
      LCustom := 0;
      for I := 0 to THREADS - 1 do
        if LThreads[I].ErrorClass = 'EConvertError' then
          Inc(LOriginal)
        else if (LThreads[I].ErrorClass = 'ECustomWaiter')
          and (LThreads[I].ErrorMessage = 'custom: loader failed (test)') then
          Inc(LCustom);
      TAssert.AssertEquals('the loading thread gets the original', 1, LOriginal);
      TAssert.AssertEquals('each waiter gets the override''s exception', THREADS - 1, LCustom);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
    LFlight.Free;
  end;
end;

procedure TSingleFlightTests.Cache_PutBug_LoadingThreadGetsItWaitersGetTheValue;
var
  LObject: TPcCache;
  LCache: IPcCache;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  LBug, LValues, I: Integer;
begin
  LObject := TPcCache.Create(TPutBugStore.Create, NewName);
  LCache := LObject;
  LHost := TLoaderHost.Create(True);
  try
    RunConcurrent(nil, LObject, LHost, LThreads);
    try
      TAssert.AssertEquals('the loader ran once', 1, LHost.Calls);
      LBug := 0;
      LValues := 0;
      for I := 0 to THREADS - 1 do
        if (LThreads[I].ErrorClass = 'EInvalidOperation')
          and (LThreads[I].ErrorMessage = 'put bug (test)') then
          Inc(LBug)
        else if (LThreads[I].ErrorClass = '') and (LThreads[I].Value = 'loaded:x') then
          Inc(LValues);
      TAssert.AssertEquals('the loading thread gets the store bug', 1, LBug);
      TAssert.AssertEquals('the waiters get the value', THREADS - 1, LValues);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
  end;
end;

procedure TSingleFlightTests.Cache_LoaderRaisesANonException_WaitersGetEPcCacheLoadError;
var
  LObject: TPcCache;
  LCache: IPcCache;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  LLeader, LWaiters, I: Integer;
begin
  LObject := TPcCache.Create(TPcMemoryCacheStore.Create(10), NewName);
  LCache := LObject;
  LHost := TLoaderHost.Create(True);
  try
    LHost.Mode := rmNonException;
    RunConcurrent(nil, LObject, LHost, LThreads);
    try
      LLeader := 0;
      LWaiters := 0;
      for I := 0 to THREADS - 1 do
        if LThreads[I].ErrorClass = 'non-exception:TNotAnException' then
          Inc(LLeader)
        else if (LThreads[I].ErrorClass = 'EPcCacheLoadError')
          and (LThreads[I].ErrorOriginalClass = 'TObject')
          and (LThreads[I].ErrorMessage = 'The cache loader raised an object that is not an Exception') then
          Inc(LWaiters);
      TAssert.AssertEquals('the loading thread gets what was raised', 1, LLeader);
      TAssert.AssertEquals('each waiter gets EPcCacheLoadError, as before 1.30.0', THREADS - 1, LWaiters);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TSingleFlightTests);

end.
