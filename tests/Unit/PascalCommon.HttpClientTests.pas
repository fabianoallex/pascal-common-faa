    Exit;
  StartServer('srv');
  LStatus := TryGet(ClientOptions('ca_cert.pem', False),
    'http://127.0.0.1', '/ok', LError);
  TAssert.AssertEquals(LError, 0, LStatus);
  // The server refuses the plaintext and closes; whether an alert comes
  // first depends on the backend, so the message's middle part does too.
  TAssert.AssertTrue(LError, Pos(Format('GET http://127.0.0.1:%d/ok: ', [Port]), LError) = 1);
end;

procedure THttpsClientTests.KeepAlive_OneConnection_ChunkedAndToClose;
var
  LTransport: IPcHttpTransport;
  I: Integer;
  LBase: string;
begin
  if not Ready then
    Exit;
  StartServer('srv');
  LTransport := PcNewHttpTransport(ClientOptions('ca_cert.pem', False));
  LBase := Format('https://127.0.0.1:%d', [Port]);
  for I := 1 to 5 do
    TAssert.AssertEquals('hello', LTransport.Send(TPcHttpRequest.Create('GET', LBase + '/ok')).Body);
  TAssert.AssertEquals(SaoPaulo, LTransport.Send(TPcHttpRequest.Create('GET', LBase + '/chunked')).Body);
  TAssert.AssertEquals(1, THttpTestServer(FServer).Connections);
  TAssert.AssertEquals('until close', LTransport.Send(TPcHttpRequest.Create('GET', LBase + '/toclose')).Body);
  TAssert.AssertEquals('hello', LTransport.Send(TPcHttpRequest.Create('GET', LBase + '/ok')).Body);
  TAssert.AssertEquals(2, THttpTestServer(FServer).Connections);
end;

procedure THttpsClientTests.DroppedConnection_GetReplayed;
var
  LTransport: IPcHttpTransport;
  LUrl: string;
begin
  if not Ready then
    Exit;
  StartServer('srv');
  LTransport := PcNewHttpTransport(ClientOptions('ca_cert.pem', False));
  LUrl := Format('https://127.0.0.1:%d/drop-second', [Port]);
  TAssert.AssertEquals('first', LTransport.Send(TPcHttpRequest.Create('GET', LUrl)).Body);
  TAssert.AssertEquals('first', LTransport.Send(TPcHttpRequest.Create('GET', LUrl)).Body);
  TAssert.AssertEquals(2, THttpTestServer(FServer).Connections);
end;

