implementation

const
  CWaitMs = 10000;
  CPfxPassword = 'pipestest';
  // 'São Paulo' in UTF-8.
  CSaoPaulo: array[0..9] of Byte = ($53, $C3, $A3, $6F, $20, $50, $61, $75, $6C, $6F);

type
  THttpTestServer = class;

  { One accepted connection: reads requests and answers them by path until
    the client closes, or the path asks for a close. }
  TServerConn = class(TThread)
  private
    FServer: THttpTestServer;
    FEndpoint: TPcEndpoint;
    FBuf: TBytes;
    FPos: Integer;
    FLen: Integer;
    FRequests: Integer;
    FEnd: string; // why the connection ended
    function ReadLine(out ALine: string): Boolean;
    function ServeOne: Boolean;
    procedure Send(const AText: string); overload;
    procedure Send(const AHead: string; const ABody: TBytes); overload;
  protected
    procedure Execute; override;
  public
    constructor Create(AServer: THttpTestServer; AEndpoint: TPcEndpoint);
    destructor Destroy; override;
  end;

  TAcceptThread = class(TThread)
  private
    FServer: THttpTestServer;
  protected
    procedure Execute; override;
  public
    constructor Create(AServer: THttpTestServer);
  end;

  THttpTestServer = class
  private
    FListener: TPcListener;
    FAcceptor: TAcceptThread;
    FLock: TCriticalSection;
    FConns: array of TServerConn;
    FConnections: Integer;
    FClosed: Integer;
    FChanged: TEvent;
    FEnded: string;
    procedure Add(AConn: TServerConn);
    procedure Ended(const AWhy: string);
  public
    /// Takes ownership of AListener.
    constructor Create(AListener: TPcListener);
    destructor Destroy; override;
    function Port: Word;
    function Connections: Integer;
    /// Waits until ACount connections have ended on the server's side.
    function WaitClosed(ACount: Integer): Boolean;
    /// Why each connection that ended did, one per line.
    function EndedText: string;
  end;

  { Sends ACount requests with bodies of its own through a shared transport. }
  TClientThread = class(TThread)
  private
    FTransport: IPcHttpTransport;
    FUrl: string;
    FIndex: Integer;
    FCount: Integer;
  protected
    procedure Execute; override;
  public
    Error: string;
    constructor Create(const ATransport: IPcHttpTransport; const AUrl: string;
      AIndex, ACount: Integer);
  end;

var
  GPkiDir: string;
  GOpenSslNoticePrinted: Boolean;

function SaoPaulo: string;
var
  LBytes: TBytes;
begin
  SetLength(LBytes, Length(CSaoPaulo));
  Move(CSaoPaulo[0], LBytes[0], Length(CSaoPaulo));
  Result := PcUtf8BytesToString(LBytes, 'the test data');
end;

function AsciiBytes(const AText: string): TBytes;
var
  I: Integer;
begin
  SetLength(Result, Length(AText));
  for I := 1 to Length(AText) do
    Result[I - 1] := Byte(Ord(AText[I]));
end;

function Join(const A, B: TBytes): TBytes;
begin
  SetLength(Result, Length(A) + Length(B));
  if Length(A) > 0 then
    Move(A[0], Result[0], Length(A));
  if Length(B) > 0 then
    Move(B[0], Result[Length(A)], Length(B));
end;

// tests/pki, looked for upwards from the executable.
function PkiDir: string;
var
  LDir: string;
  I: Integer;
begin
  if GPkiDir <> '' then
    Exit(GPkiDir);
  LDir := ExtractFileDir(ExpandFileName(ParamStr(0)));
  for I := 0 to 6 do
  begin
    if FileExists(IncludeTrailingPathDelimiter(LDir) + 'tests' + PathDelim +
         'pki' + PathDelim + 'ca_cert.pem') then
    begin
      GPkiDir := IncludeTrailingPathDelimiter(LDir) + 'tests' + PathDelim + 'pki';
      Exit(GPkiDir);
    end;
    if FileExists(IncludeTrailingPathDelimiter(LDir) + 'pki' + PathDelim +
         'ca_cert.pem') then
    begin
      GPkiDir := IncludeTrailingPathDelimiter(LDir) + 'pki';
      Exit(GPkiDir);
    end;
    LDir := ExtractFileDir(LDir);
  end;
  raise Exception.Create('tests/pki not found above ' + ParamStr(0));
end;

function Pki(const AName: string): string;
begin
  Result := IncludeTrailingPathDelimiter(PkiDir) + AName;
end;

{ TServerConn }

constructor TServerConn.Create(AServer: THttpTestServer; AEndpoint: TPcEndpoint);
begin
  FServer := AServer;
  FEndpoint := AEndpoint;
  SetLength(FBuf, 8192);
  FreeOnTerminate := False;
  inherited Create(False);
end;

destructor TServerConn.Destroy;
begin
  inherited; // joins
  FEndpoint.Free;
end;

function TServerConn.ReadLine(out ALine: string): Boolean;
var
  B: Byte;
begin
  ALine := '';
  while True do
  begin
    if FPos >= FLen then
    begin
      try
        FLen := FEndpoint.Read(FBuf[0], Length(FBuf));
      except
        on E: EPcTransport do
        begin
          FEnd := E.ClassName + ': ' + E.Message;
          Exit(False);
        end;
      end;
      FPos := 0;
    end;
    B := FBuf[FPos];
    Inc(FPos);
    if B = 10 then
      Break;
    if B <> 13 then
      ALine := ALine + Char(B);
  end;
  Result := True;
end;

procedure TServerConn.Send(const AText: string);
begin
  Send(AText, nil);
end;

procedure TServerConn.Send(const AHead: string; const ABody: TBytes);
var
  LAll: TBytes;
begin
  LAll := Join(AsciiBytes(AHead), ABody);
  if Length(LAll) > 0 then
    FEndpoint.WriteExactly(LAll[0], Length(LAll));
end;

// Reads one request and answers it. False: close the connection.
function TServerConn.ServeOne: Boolean;
var
  LLine, LMethod, LPath, LLength, LHost, LConnection: string;
  LBody, LBig: TBytes;
  LSpace, N, LGot: Integer;
  LHeader: TPcHttpHeader;
begin
  Result := False;
  if not ReadLine(LLine) then
    Exit;
  LSpace := Pos(' ', LLine);
  LMethod := Copy(LLine, 1, LSpace - 1);
  LPath := Copy(LLine, LSpace + 1, MaxInt);
  LPath := Copy(LPath, 1, Pos(' ', LPath) - 1);
  if Pos('?', LPath) > 0 then
    LPath := Copy(LPath, 1, Pos('?', LPath) - 1);
  LLength := 'none';
  LHost := 'none';
  LConnection := 'none';
  while True do
  begin
    if not ReadLine(LLine) then
      Exit;
    if LLine = '' then
      Break;
    if PcHttpSplitHeaderLine(LLine, LHeader) then
    begin
      if SameText(LHeader.Name, 'Content-Length') then
        LLength := LHeader.Value
      else if SameText(LHeader.Name, 'Host') then
        LHost := LHeader.Value
      else if SameText(LHeader.Name, 'Connection') then
        LConnection := LHeader.Value;
    end;
  end;
  N := StrToIntDef(LLength, 0);
  SetLength(LBody, N);
  LGot := 0;
  while LGot < N do
  begin
    if FPos >= FLen then
    begin
      FLen := FEndpoint.Read(FBuf[0], Length(FBuf));
      FPos := 0;
    end;
    LBody[LGot] := FBuf[FPos];
    Inc(FPos);
    Inc(LGot);
  end;
  Inc(FRequests);
  Result := True;

  if LPath = '/ok' then
    Send('HTTP/1.1 200 OK'#13#10'Content-Length: 5'#13#10#13#10'hello')
  else if LPath = '/echo' then
    Send(Format('HTTP/1.1 200 OK'#13#10'X-Method: %s'#13#10'X-Content-Length: %s'#13#10 +
      'X-Host: %s'#13#10'X-Connection: %s'#13#10'Content-Length: %d'#13#10#13#10,
      [LMethod, LLength, LHost, LConnection, Length(LBody)]), LBody)
  else if LPath = '/chunked' then
    Send('HTTP/1.1 200 OK'#13#10'Transfer-Encoding: chunked'#13#10#13#10 +
      '2;name=value'#13#10'S'#$C3#13#10'8'#13#10#$A3'o Paulo'#13#10 +
      '0'#13#10'X-Trailer: t'#13#10#13#10)
  else if LPath = '/toclose' then
  begin
    Send('HTTP/1.1 200 OK'#13#10#13#10'until close');
    Result := False;
  end
  else if LPath = '/head' then
    Send('HTTP/1.1 200 OK'#13#10'Content-Length: 5'#13#10#13#10)
  else if LPath = '/204' then
    Send('HTTP/1.1 204 No Content'#13#10#13#10)
  else if LPath = '/1xx' then
    Send('HTTP/1.1 100 Continue'#13#10#13#10 +
      'HTTP/1.1 103 Early Hints'#13#10'Link: </a>'#13#10#13#10 +
      'HTTP/1.1 200 OK'#13#10'X-Dup: a'#13#10'x-dup: b'#13#10'Content-Length: 2'#13#10#13#10'ok')
  else if LPath = '/302' then
    Send('HTTP/1.1 302 Found'#13#10'Location: /ok'#13#10'Content-Length: 0'#13#10#13#10)
  else if LPath = '/latin1' then
    Send('HTTP/1.1 200 OK'#13#10'X-Name: S'#$E3'o'#13#10'Content-Length: 0'#13#10#13#10)
  else if LPath = '/garbage' then
  begin
    Send('THIS IS NOT HTTP'#13#10);
    Result := False;
  end
  else if LPath = '/closenow' then
    Result := False
  else if LPath = '/truncated' then
  begin
    Send('HTTP/1.1 200 OK'#13#10'Content-Length: 10'#13#10#13#10'only');
    Result := False;
  end
  else if LPath = '/badchunk' then
  begin
    Send('HTTP/1.1 200 OK'#13#10'Transfer-Encoding: chunked'#13#10#13#10'zz'#13#10);
    Result := False;
  end
  else if LPath = '/gzipte' then
    Send('HTTP/1.1 200 OK'#13#10'Transfer-Encoding: gzip, chunked'#13#10#13#10 +
      '3'#13#10'abc'#13#10'0'#13#10#13#10)
  else if LPath = '/obsfold' then
    Send('HTTP/1.1 200 OK'#13#10'X-A: a'#13#10' b'#13#10'Content-Length: 0'#13#10#13#10)
  else if LPath = '/bighead' then
    Send('HTTP/1.1 200 OK'#13#10'X-Big: ' + StringOfChar('a', 70000) + #13#10 +
      'Content-Length: 0'#13#10#13#10)
  else if (LPath = '/bigbody') or (LPath = '/bigchunked') then
  begin
    SetLength(LBig, 2000);
    FillChar(LBig[0], Length(LBig), Ord('b'));
    if LPath = '/bigbody' then
      Send('HTTP/1.1 200 OK'#13#10'Content-Length: 2000'#13#10#13#10, LBig)
    else
      Send('HTTP/1.1 200 OK'#13#10'Transfer-Encoding: chunked'#13#10#13#10'7d0'#13#10,
        Join(LBig, AsciiBytes(#13#10'0'#13#10#13#10)));
  end
  else if LPath = '/notutf8' then
    Send('HTTP/1.1 200 OK'#13#10'Content-Length: 3'#13#10#13#10'S'#$E3'o')
  else if LPath = '/silent' then
  begin
    // No answer: wait for the client to give up and close.
    ReadLine(LLine);
    Result := False;
  end
  else if LPath = '/connclose' then
  begin
    Send('HTTP/1.1 200 OK'#13#10'Connection: close'#13#10'Content-Length: 2'#13#10#13#10'ok');
    Result := False;
  end
  else if LPath = '/http10' then
    // HTTP/1.0 without keep-alive: the client must not reuse it. The
    // server keeps the connection open, so a reuse would hang, not pass.
    Send('HTTP/1.0 200 OK'#13#10'Content-Length: 2'#13#10#13#10'ok')
  else if LPath = '/drop-second' then
  begin
    if FRequests >= 2 then
      Result := False // closes without answering
    else
      Send('HTTP/1.1 200 OK'#13#10'Content-Length: 5'#13#10#13#10'first');
  end
  else if LPath = '/close-after' then
  begin
    Send('HTTP/1.1 200 OK'#13#10'Content-Length: 2'#13#10#13#10'ok');
    Result := False;
  end
  else
    Send('HTTP/1.1 404 Not Found'#13#10'Content-Length: 0'#13#10#13#10);
end;

procedure TServerConn.Execute;
begin
  try
    try
      FEndpoint.Handshake;
      FEndpoint.SetIoDeadline(CWaitMs);
      while ServeOne do
        ;
    except
      // a refused handshake, a client gone: the connection ends
      on E: Exception do
        FEnd := E.ClassName + ': ' + E.Message;
    end;
  finally
    FServer.Ended(Format('after %d requests: %s', [FRequests, FEnd]));
    FEndpoint.CloseAbort;
    PcAtomicInc(FServer.FClosed);
    FServer.FChanged.SetEvent;
  end;
end;

{ TAcceptThread }

constructor TAcceptThread.Create(AServer: THttpTestServer);
begin
  FServer := AServer;
  FreeOnTerminate := False;
  inherited Create(False);
end;

procedure TAcceptThread.Execute;
var
  LEndpoint: TPcEndpoint;
begin
  try
    while True do
    begin
      LEndpoint := FServer.FListener.Accept;
      if LEndpoint = nil then
        Exit;
      PcAtomicInc(FServer.FConnections);
      FServer.Add(TServerConn.Create(FServer, LEndpoint));
    end;
  except
    // the listener closed under us
  end;
end;

{ THttpTestServer }

constructor THttpTestServer.Create(AListener: TPcListener);
begin
  inherited Create;
  FListener := AListener;
  FLock := TCriticalSection.Create;
  FChanged := TEvent.Create(nil, False, False, '');
  FAcceptor := TAcceptThread.Create(Self);
end;

destructor THttpTestServer.Destroy;
var
  I: Integer;
begin
  FListener.Close;
  FAcceptor.Free; // joins
  for I := 0 to High(FConns) do
    FConns[I].FEndpoint.CloseAbort;
  for I := 0 to High(FConns) do
    FConns[I].Free; // joins
  FListener.Free;
  FChanged.Free;
  FLock.Free;
  inherited;
end;

procedure THttpTestServer.Add(AConn: TServerConn);
begin
  FLock.Acquire;
  try
    SetLength(FConns, Length(FConns) + 1);
    FConns[High(FConns)] := AConn;
  finally
    FLock.Release;
  end;
end;

procedure THttpTestServer.Ended(const AWhy: string);
begin
  FLock.Acquire;
  try
    FEnded := FEnded + AWhy + '; ';
  finally
    FLock.Release;
  end;
end;

function THttpTestServer.EndedText: string;
begin
  FLock.Acquire;
  try
    Result := FEnded;
  finally
    FLock.Release;
  end;
end;

function THttpTestServer.Port: Word;
begin
  Result := FListener.Port;
end;

function THttpTestServer.Connections: Integer;
begin
  Result := PcAtomicGet(FConnections);
end;

function THttpTestServer.WaitClosed(ACount: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + CWaitMs;
  while PcAtomicGet(FClosed) < ACount do
  begin
    if PcTickMs >= LDeadline then
      Exit(False);
    FChanged.WaitFor(100);
  end;
  Result := True;
end;

{ TClientThread }

constructor TClientThread.Create(const ATransport: IPcHttpTransport;
  const AUrl: string; AIndex, ACount: Integer);
begin
  FTransport := ATransport;
  FUrl := AUrl;
  FIndex := AIndex;
  FCount := ACount;
  FreeOnTerminate := False;
  inherited Create(False);
end;

procedure TClientThread.Execute;
var
  I: Integer;
  LRequest: TPcHttpRequest;
  LResponse: TPcHttpResponse;
begin
  try
    for I := 1 to FCount do
    begin
      LRequest := TPcHttpRequest.Create('POST', FUrl);
      LRequest.Body := Format('thread %d request %d', [FIndex, I]);
      LResponse := FTransport.Send(LRequest);
      if (LResponse.Status <> 200) or (LResponse.Body <> LRequest.Body) then
      begin
        Error := Format('thread %d request %d: %d "%s"',
          [FIndex, I, LResponse.Status, LResponse.Body]);
        Exit;
      end;
    end;
  except
    on E: Exception do
      Error := Format('thread %d: %s: %s', [FIndex, E.ClassName, E.Message]);
  end;
  FTransport := nil;
end;

{ THttpClientTests }

procedure THttpClientTests.SetUp;
begin
  FServer := nil;
  FTransport := nil;
end;

procedure THttpClientTests.TearDown;
begin
  FTransport := nil; // closes the idle connections first
  FreeAndNil(FServer);
end;

procedure THttpClientTests.StartServer;
begin
  FServer := THttpTestServer.Create(PcTcpListen('127.0.0.1', 0, Default(TPcTcpOptions)));
  if FTransport = nil then
    FTransport := PcNewHttpTransport;
end;

function THttpClientTests.Url(const APath: string): string;
begin
  Result := Format('http://127.0.0.1:%d%s', [THttpTestServer(FServer).Port, APath]);
end;

function THttpClientTests.Send(const AMethod, APath, ABody: string): TPcHttpResponse;
var
  LRequest: TPcHttpRequest;
begin
  LRequest := TPcHttpRequest.Create(AMethod, Url(APath));
  LRequest.Body := ABody;
  LRequest.TimeoutMs := CWaitMs;
  Result := FTransport.Send(LRequest);
end;

function THttpClientTests.Get(const APath: string): TPcHttpResponse;
begin
  Result := Send('GET', APath, '');
end;

function THttpClientTests.ErrorOf(const AMethod, APath: string;
  ATimeoutMs: Integer): string;
var
  LRequest: TPcHttpRequest;
  LResponse: TPcHttpResponse;
begin
  LRequest := TPcHttpRequest.Create(AMethod, Url(APath));
  LRequest.TimeoutMs := ATimeoutMs;
  if ATimeoutMs = 0 then
    LRequest.TimeoutMs := CWaitMs;
  try
    LResponse := FTransport.Send(LRequest);
    Result := Format('it answered, status %d', [LResponse.Status]);
  except
    on E: EPcHttpTransport do
      Result := E.Message;
  end;
end;

function THttpClientTests.Connections: Integer;
begin
  Result := THttpTestServer(FServer).Connections;
end;

procedure THttpClientTests.Get_ContentLength;
var
  LResponse: TPcHttpResponse;
begin
  StartServer;
  LResponse := Get('/ok');
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals('hello', LResponse.Body);
  TAssert.AssertEquals('5', LResponse.Header('content-length'));
  LResponse := Get('/nothing-here');
  TAssert.AssertEquals(404, LResponse.Status);
  TAssert.AssertEquals('', LResponse.Body);
end;

procedure THttpClientTests.Post_Utf8BodyBothWays;
var
  LResponse: TPcHttpResponse;
begin
  StartServer;
  LResponse := Send('POST', '/echo', '{"city":"' + SaoPaulo + '"}');
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals('{"city":"' + SaoPaulo + '"}', LResponse.Body);
  // 10 bytes of UTF-8 for 9 characters, plus 11 of JSON around them.
  TAssert.AssertEquals('21', LResponse.Header('X-Content-Length'));
  TAssert.AssertEquals('POST', LResponse.Header('X-Method'));
  // JSON lines: the newlines go as they are.
  LResponse := Send('POST', '/echo', '{"a":1}'#10'{"a":2}'#10);
  TAssert.AssertEquals('{"a":1}'#10'{"a":2}'#10, LResponse.Body);
end;

procedure THttpClientTests.ContentLength_AlwaysForBodyMethods;
begin
  StartServer;
  TAssert.AssertEquals('0', Send('POST', '/echo', '').Header('X-Content-Length'));
  TAssert.AssertEquals('0', Send('PUT', '/echo', '').Header('X-Content-Length'));
  TAssert.AssertEquals('0', Send('PATCH', '/echo', '').Header('X-Content-Length'));
  TAssert.AssertEquals('none', Send('GET', '/echo', '').Header('X-Content-Length'));
  TAssert.AssertEquals('none', Send('DELETE', '/echo', '').Header('X-Content-Length'));
  // A body on another method still carries its length.
  TAssert.AssertEquals('2', Send('DELETE', '/echo', '[]').Header('X-Content-Length'));
  TAssert.AssertEquals('none', Send('GET', '/echo', '').Header('X-Connection'));
end;

procedure THttpClientTests.HostHeader_WithThePort;
begin
