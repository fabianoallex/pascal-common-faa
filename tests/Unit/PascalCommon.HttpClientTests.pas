procedure THttpClientTests.NotHttp_TransferCodingOtherThanChunked;
var
  LError: string;
begin
  StartServer;
  // Never asked for (no TE header is sent), and the body would come back
  // still compressed.
  LError := ErrorOf('GET', '/gzipte');
  TAssert.AssertTrue(LError, Pos(': not an HTTP answer (Transfer-Encoding "gzip, chunked")', LError) > 0);
end;

procedure THttpClientTests.Limits_HeadAndBody;
var
  LOptions: TPcHttpOptions;
  LError: string;
begin
  LOptions := Default(TPcHttpOptions);
  LOptions.MaxResponseBytes := 1000;
  FTransport := PcNewHttpTransport(LOptions);
  StartServer;
  LError := ErrorOf('GET', '/bighead');
  TAssert.AssertTrue(LError, Pos('not an HTTP answer (a head larger than 65536 bytes)', LError) > 0);
  LError := ErrorOf('GET', '/bigbody');
  TAssert.AssertTrue(LError, Pos('not an HTTP answer (a body larger than 1000 bytes)', LError) > 0);
  LError := ErrorOf('GET', '/bigchunked');
  TAssert.AssertTrue(LError, Pos('not an HTTP answer (a body larger than 1000 bytes)', LError) > 0);
  // The default limit takes the same body.
  FTransport := PcNewHttpTransport;
  TAssert.AssertEquals(2000, Length(Get('/bigbody').Body));
end;

procedure THttpClientTests.BodyNotUtf8_RaisesEncoding_ConnectionStillReused;
var
  LMessage: string;
begin
  StartServer;
  LMessage := '';
  try
    Get('/notutf8?k=v');
  except
    on E: EPcTextEncoding do
      LMessage := E.Message;
  end;
  TAssert.AssertTrue(LMessage, Pos('the answer to GET ' + Url('/notutf8') + ' is not UTF-8', LMessage) = 1);
  // The answer was framed right: the connection went back to the pool.
  TAssert.AssertEquals('hello', Get('/ok').Body);
  TAssert.AssertEquals(1, Connections);
end;

procedure THttpClientTests.Timeout_SilentServer;
var
  LError: string;
  T0: UInt64;
begin
  StartServer;
  T0 := PcTickMs;
  LError := ErrorOf('GET', '/silent', 300);
  TAssert.AssertTrue(LError, Pos(': no answer (EPcTransportTimeout', LError) > 0);
  TAssert.AssertTrue(Format('took %d ms', [PcTickMs - T0]), PcTickMs - T0 < 5000);
  // A timeout is never replayed: one connection.
  TAssert.AssertTrue(THttpTestServer(FServer).WaitClosed(1));
  TAssert.AssertEquals(1, Connections);
end;

procedure THttpClientTests.Pool_SequentialExchanges_OneConnection;
var
  I: Integer;
begin
  StartServer;
  for I := 1 to 20 do
    TAssert.AssertEquals('hello', Get('/ok').Body);
  TAssert.AssertEquals(1, Connections);
end;

procedure THttpClientTests.Pool_DroppedConnection_GetReplayed;
begin
  StartServer;
  TAssert.AssertEquals('first', Get('/drop-second').Body);
  // The server reads the second request and closes: the GET goes again on a
  // new connection, where it is the first.
  TAssert.AssertEquals('first', Get('/drop-second').Body);
  TAssert.AssertEquals(2, Connections);
end;

procedure THttpClientTests.Pool_DroppedConnection_PostNotReplayed;
var
  LError: string;
begin
  StartServer;
  TAssert.AssertEquals('first', Get('/drop-second').Body);
  LError := ErrorOf('POST', '/drop-second');
  TAssert.AssertTrue(LError, Pos('POST ' + Url('/drop-second') + ': no answer (EPcTransport', LError) = 1);
  TAssert.AssertEquals(1, Connections);
end;

procedure THttpClientTests.Pool_ServerClosedIdle_NotReused;
begin
  StartServer;
  TAssert.AssertEquals('ok', Send('POST', '/close-after', '').Body);
  TAssert.AssertTrue(THttpTestServer(FServer).WaitClosed(1));
  // The pooled connection has the server's close pending: dropped before
  // use, so even a POST (never replayed) gets its answer.
  TAssert.AssertEquals('x', Send('POST', '/echo', 'x').Body);
  TAssert.AssertEquals(2, Connections);
end;

procedure THttpClientTests.Pool_ConnectionClose_AndHttp10_NotPooled;
begin
  StartServer;
  TAssert.AssertEquals('ok', Get('/connclose').Body);
  TAssert.AssertEquals('ok', Get('/connclose').Body);
  TAssert.AssertEquals(2, Connections);
  TAssert.AssertEquals('ok', Get('/http10').Body);
  TAssert.AssertEquals('ok', Get('/http10').Body);
  TAssert.AssertEquals(4, Connections);
end;

procedure THttpClientTests.Pool_NoKeepAlive_OneConnectionPerExchange;
var
  LOptions: TPcHttpOptions;
  I: Integer;
begin
  LOptions := Default(TPcHttpOptions);
  LOptions.NoKeepAlive := True;
  FTransport := PcNewHttpTransport(LOptions);
  StartServer;
  for I := 1 to 5 do
    TAssert.AssertEquals('close', Get('/echo').Header('X-Connection'));
  TAssert.AssertEquals(5, Connections);
end;

procedure THttpClientTests.Pool_IdleTimeout_ClosesOldConnections;
var
  LOptions: TPcHttpOptions;
begin
  LOptions := Default(TPcHttpOptions);
  LOptions.IdleTimeoutMs := 50;
  FTransport := PcNewHttpTransport(LOptions);
  StartServer;
  TAssert.AssertEquals('hello', Get('/ok').Body);
  Sleep(200); // the time is the point: the idle connection gets too old
  TAssert.AssertEquals('hello', Get('/ok').Body);
  TAssert.AssertEquals(2, Connections);
  // The old one was closed by the client.
  TAssert.AssertTrue(THttpTestServer(FServer).WaitClosed(1));
end;

procedure THttpClientTests.Concurrent_EightThreads;
var
  LOptions: TPcHttpOptions;
  LThreads: array[0..7] of TClientThread;
  I: Integer;
begin
  // A pool as large as the threads: with the default 4, eight connections
  // coming back at once close four, and the next burst opens new ones.
  LOptions := Default(TPcHttpOptions);
  LOptions.MaxIdlePerHost := 8;
  FTransport := PcNewHttpTransport(LOptions);
  StartServer;
  for I := 0 to High(LThreads) do
    LThreads[I] := TClientThread.Create(FTransport, Url('/echo'), I, 25);
  for I := 0 to High(LThreads) do
  begin
    LThreads[I].WaitFor;
    TAssert.AssertEquals('', LThreads[I].Error);
  end;
  for I := 0 to High(LThreads) do
    LThreads[I].Free;
  TAssert.AssertTrue(Format('%d connections for 8 threads; ended: %s',
    [Connections, THttpTestServer(FServer).EndedText]), Connections <= 8);
end;

{ THttpsClientTests }

function THttpsClientTests.Backend: TPcTlsBackend;
begin
  Result := tbDefault;
end;

function THttpsClientTests.Ready: Boolean;
var
  LError: string;
begin
  Result := True;
  if PcTlsResolveBackend(Backend) <> tbOpenSsl then
    Exit;
  if PcOpenSslAvailable(LError) then
    Exit;
  {$IFDEF MSWINDOWS}
  if not GOpenSslNoticePrinted then
  begin
    GOpenSslNoticePrinted := True;
    WriteLn('NOTICE: OpenSSL HTTPS tests skipped: ' + LError);
  end;
  Result := False;
  {$ELSE}
  TAssert.Fail('OpenSSL is the only TLS backend here and it is missing: ' + LError);
  Result := False;
  {$ENDIF}
end;

procedure THttpsClientTests.SetUp;
begin
  FServer := nil;
end;

procedure THttpsClientTests.TearDown;
begin
  FreeAndNil(FServer);
end;

procedure THttpsClientTests.StartServer(const ACert: string);
var
  LTls: TPcTlsOptions;
begin
  LTls := Default(TPcTlsOptions);
  LTls.Backend := Backend;
  LTls.HandshakeTimeoutMs := CWaitMs;
  if PcTlsResolveBackend(Backend) = tbOpenSsl then
  begin
    LTls.CertFile := Pki(ACert + '_cert.pem');
    LTls.KeyFile := Pki(ACert + '_key.pem');
  end
  else
  begin
    LTls.CertFile := Pki(ACert + '.pfx');
    LTls.CertPassword := CPfxPassword;
  end;
  FServer := THttpTestServer.Create(PcTlsListen('127.0.0.1', 0,
    Default(TPcTcpOptions), LTls));
end;

function THttpsClientTests.ClientOptions(const ACaFile: string;
  ASkip: Boolean): TPcHttpOptions;
begin
  Result := Default(TPcHttpOptions);
  Result.Tls.Backend := Backend;
  Result.Tls.SkipServerVerification := ASkip;
  if ACaFile <> '' then
    Result.Tls.CaFile := Pki(ACaFile);
end;

function THttpsClientTests.Port: Integer;
begin
  Result := THttpTestServer(FServer).Port;
end;

function THttpsClientTests.TryGet(const AOptions: TPcHttpOptions; const AHost,
  APath: string; out AError: string): Integer;
var
  LTransport: IPcHttpTransport;
  LRequest: TPcHttpRequest;
begin
  AError := '';
  Result := 0;
  LTransport := PcNewHttpTransport(AOptions);
  LRequest := TPcHttpRequest.Create('GET', Format('%s:%d%s', [AHost, Port, APath]));
  LRequest.TimeoutMs := CWaitMs;
  try
    Result := LTransport.Send(LRequest).Status;
  except
    on E: EPcHttpTransport do
      AError := E.Message;
  end;
end;

procedure THttpsClientTests.CheckRefused(const ACert, ACaFile: string);
var
  LError: string;
  LStatus: Integer;
begin
  StartServer(ACert);
  LStatus := TryGet(ClientOptions(ACaFile, False),
    'https://127.0.0.1', '/ok', LError);
  TAssert.AssertEquals(LError, 0, LStatus);
  // The cause is in the message: the certificate, not "connect failed".
  TAssert.AssertTrue(LError, Pos(': no answer (EPcTls: ', LError) > 0);
end;

