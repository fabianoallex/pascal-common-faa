  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals('', LResponse.Body);
  TAssert.AssertEquals('5', LResponse.Header('Content-Length'));
  TAssert.AssertEquals('hello', Get('/ok').Body);
  TAssert.AssertEquals(1, Connections);
end;

procedure THttpClientTests.NoContent_InformationalSkipped_DuplicatesKept;
var
  LResponse: TPcHttpResponse;
begin
  StartServer;
  LResponse := Get('/204');
  TAssert.AssertEquals(204, LResponse.Status);
  TAssert.AssertEquals('', LResponse.Body);
  LResponse := Get('/1xx');
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals('ok', LResponse.Body);
  TAssert.AssertEquals('', LResponse.Header('Link')); // the 103's header
  TAssert.AssertEquals(3, Length(LResponse.Headers));
  TAssert.AssertEquals('X-Dup', LResponse.Headers[0].Name);
  TAssert.AssertEquals('a', LResponse.Headers[0].Value);
  TAssert.AssertEquals('x-dup', LResponse.Headers[1].Name);
  TAssert.AssertEquals('b', LResponse.Headers[1].Value);
  TAssert.AssertEquals(1, Connections);
end;

