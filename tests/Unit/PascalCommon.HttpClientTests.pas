    Get('/echo').Header('X-Host'));
end;

procedure THttpClientTests.Chunked_WithExtensionsAndTrailers;
var
  LResponse: TPcHttpResponse;
begin
  StartServer;
  // Chunks cut inside a character: the body is decoded only when whole.
  LResponse := Get('/chunked');
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals(SaoPaulo, LResponse.Body);
  TAssert.AssertEquals('', LResponse.Header('X-Trailer'));
  TAssert.AssertEquals('hello', Get('/ok').Body);
  TAssert.AssertEquals(1, Connections);
end;

procedure THttpClientTests.ReadToClose_NotPooled;
