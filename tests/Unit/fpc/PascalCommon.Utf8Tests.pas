{ Tests for PascalCommon.Utf8: ASCII and non-ASCII text, the BOM, empty
  input, text to UTF-8 bytes (1.18.0), and on FPC the refusal outside a UTF-8 code page (the test switches
  the code page to 1252 and back, as pascal-db-faa's SqlSources tests did for
  the function this replaces there).

  1.25.0: bytes that aren't UTF-8 give False on both compilers instead of
  EEncodingError on Delphi and #0-filled text on FPC: UTF-16 with either BOM,
  stray and overlong bytes, surrogates, code points above U+10FFFF and a
  sequence cut at the end; the boundaries of table 3-7 stay valid.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  PascalCommon.Utf8;

type
  TUtf8Tests = class(TTestCase)
  published
    procedure Ascii;
    procedure NonAscii;
    procedure Bom_IsDropped;
    procedure Empty_And_BomOnly;
    procedure NonAscii_OutsideUtf8CodePage_IsRefusedOnFpc;
    procedure StringToUtf8Bytes_AsciiAndEmpty;
    procedure StringToUtf8Bytes_NonAscii;
    procedure Utf16LeWithBom_IsRefused;
    procedure Utf16BeWithBom_IsRefused;
    procedure InvalidBytes_AreRefused;
    procedure TruncatedAtTheEnd_IsRefused;
    procedure ValidBoundaries_AreAccepted;
    procedure ValidWithAndWithoutBom_StaysTrue;
    procedure InvalidBytes_AreRefusedOutsideUtf8CodePageOnFpc;
  end;

implementation

function Bytes(const AValues: array of Byte): TBytes;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(AValues));
  for I := 0 to High(AValues) do
    Result[I] := AValues[I];
end;

// 'São →' in UTF-8.
function NonAsciiBytes: TBytes;
begin
  Result := Bytes([$53, $C3, $A3, $6F, $20, $E2, $86, $92]);
end;

procedure TUtf8Tests.Ascii;
var
  LText: string;
begin
  TAssert.AssertTrue(PcTryUtf8BytesToString(Bytes([$6F, $6B]), LText));
  TAssert.AssertEquals('ok', LText);
end;

procedure TUtf8Tests.NonAscii;
var
  LText: string;
begin
  TAssert.AssertTrue(PcTryUtf8BytesToString(NonAsciiBytes, LText));
  TAssert.AssertEquals('São →', LText);
end;

procedure TUtf8Tests.Bom_IsDropped;
var
  LText: string;
begin
  TAssert.AssertTrue(PcTryUtf8BytesToString(Bytes([$EF, $BB, $BF, $C3, $A3]), LText));
  TAssert.AssertEquals('ã', LText);
end;

procedure TUtf8Tests.Empty_And_BomOnly;
var
  LText: string;
begin
  LText := 'x';
  TAssert.AssertTrue(PcTryUtf8BytesToString(nil, LText));
  TAssert.AssertEquals('', LText);
  TAssert.AssertTrue(PcTryUtf8BytesToString(Bytes([$EF, $BB, $BF]), LText));
  TAssert.AssertEquals('', LText);
end;

procedure TUtf8Tests.NonAscii_OutsideUtf8CodePage_IsRefusedOnFpc;
var
  LText: string;
  {$IFDEF FPC}
  LOldCodePage: TSystemCodePage;
  LResult, LAsciiResult: Boolean;
  {$ENDIF}
begin
  {$IFDEF FPC}
  LOldCodePage := DefaultSystemCodePage;
  SetMultiByteConversionCodePage(1252);
  try
    LResult := PcTryUtf8BytesToString(NonAsciiBytes, LText);
    LAsciiResult := PcTryUtf8BytesToString(Bytes([$6F, $6B]), LText);
  finally
    SetMultiByteConversionCodePage(LOldCodePage);
  end;
  TAssert.AssertFalse('non-ASCII outside UTF-8 is refused', LResult);
  TAssert.AssertTrue('ASCII is fine in any code page', LAsciiResult);
  TAssert.AssertEquals('ok', LText);
  {$ELSE}
  // Delphi: string is UTF-16, there is no code page to guard.
  TAssert.AssertTrue(PcTryUtf8BytesToString(NonAsciiBytes, LText));
  TAssert.AssertEquals('São →', LText);
  {$ENDIF}
end;

procedure TUtf8Tests.StringToUtf8Bytes_AsciiAndEmpty;
var
  LBytes: TBytes;
begin
  LBytes := PcStringToUtf8Bytes('ok');
  TAssert.AssertEquals(2, Length(LBytes));
  TAssert.AssertEquals(Ord('o'), Integer(LBytes[0]));
  TAssert.AssertEquals(Ord('k'), Integer(LBytes[1]));
  TAssert.AssertEquals(0, Length(PcStringToUtf8Bytes('')));
end;

procedure TUtf8Tests.StringToUtf8Bytes_NonAscii;
const
  // A typed constant: FPC warns (4104/4105) on a non-ASCII literal in an
  // expression.
  SAO: string = 'São →';
var
  LBytes, LExpected: TBytes;
  LText: string;
  I: Integer;
begin
  LBytes := PcStringToUtf8Bytes(SAO);
  LExpected := NonAsciiBytes;
  TAssert.AssertEquals(Length(LExpected), Length(LBytes));
  for I := 0 to High(LExpected) do
    TAssert.AssertEquals(Format('byte %d', [I]), Integer(LExpected[I]), Integer(LBytes[I]));
  TAssert.AssertTrue(PcTryUtf8BytesToString(LBytes, LText));
  TAssert.AssertEquals(SAO, LText);
end;

// 'a=1' as PowerShell 5.1's ">" writes it: UTF-16 LE with FF FE.
function Utf16LeBytes: TBytes;
begin
  Result := Bytes([$FF, $FE, $61, $00, $3D, $00, $31, $00]);
end;

procedure AssertRefused(const AName: string; const ABytes: TBytes);
var
  LText: string;
begin
  LText := 'x';
  TAssert.AssertFalse(AName + ': PcIsValidUtf8', PcIsValidUtf8(ABytes));
  TAssert.AssertFalse(AName + ': PcTryUtf8BytesToString', PcTryUtf8BytesToString(ABytes, LText));
  TAssert.AssertEquals(AName + ': text is empty', '', LText);
end;

procedure AssertAccepted(const AName: string; const ABytes: TBytes);
var
  LText: string;
  LBack: TBytes;
  LStart, I: Integer;
begin
  TAssert.AssertTrue(AName + ': PcIsValidUtf8', PcIsValidUtf8(ABytes));
  TAssert.AssertTrue(AName + ': PcTryUtf8BytesToString', PcTryUtf8BytesToString(ABytes, LText));
  // The text goes back to the same bytes (without the BOM).
  LStart := 0;
  if (Length(ABytes) >= 3) and (ABytes[0] = $EF) and (ABytes[1] = $BB) and (ABytes[2] = $BF) then
    LStart := 3;
  LBack := PcStringToUtf8Bytes(LText);
  TAssert.AssertEquals(AName + ': length', Length(ABytes) - LStart, Length(LBack));
  for I := 0 to High(LBack) do
    TAssert.AssertEquals(Format('%s: byte %d', [AName, I]), Integer(ABytes[LStart + I]),
      Integer(LBack[I]));
end;

procedure TUtf8Tests.Utf16LeWithBom_IsRefused;
begin
  AssertRefused('UTF-16 LE', Utf16LeBytes);
  AssertRefused('UTF-16 LE, BOM only', Bytes([$FF, $FE]));
end;

procedure TUtf8Tests.Utf16BeWithBom_IsRefused;
begin
  AssertRefused('UTF-16 BE', Bytes([$FE, $FF, $00, $61, $00, $3D, $00, $31]));
  AssertRefused('UTF-16 BE, BOM only', Bytes([$FE, $FF]));
end;

procedure TUtf8Tests.InvalidBytes_AreRefused;
begin
  AssertRefused('stray continuation', Bytes([$61, $80, $62]));
  AssertRefused('stray BF', Bytes([$BF]));
  AssertRefused('C0 (overlong lead)', Bytes([$C0, $AF]));
  AssertRefused('C1 (overlong lead)', Bytes([$C1, $BF]));
  AssertRefused('overlong 3 bytes', Bytes([$E0, $80, $AF]));
  AssertRefused('overlong 4 bytes', Bytes([$F0, $8F, $BF, $BF]));
  AssertRefused('surrogate D800', Bytes([$ED, $A0, $80]));
  AssertRefused('surrogate DFFF', Bytes([$ED, $BF, $BF]));
  AssertRefused('above U+10FFFF', Bytes([$F4, $90, $80, $80]));
  AssertRefused('F5', Bytes([$F5, $80, $80, $80]));
  AssertRefused('FF', Bytes([$61, $FF]));
  AssertRefused('lead without continuation', Bytes([$C3, $61]));
  AssertRefused('second continuation missing', Bytes([$E2, $86, $61]));
  AssertRefused('Latin-1 text', Bytes([$53, $E3, $6F]));
  AssertRefused('after a BOM', Bytes([$EF, $BB, $BF, $80]));
end;

procedure TUtf8Tests.TruncatedAtTheEnd_IsRefused;
begin
  AssertRefused('2 of 2 cut', Bytes([$61, $C3]));
  AssertRefused('3 of 3 cut after 1', Bytes([$61, $E2]));
  AssertRefused('3 of 3 cut after 2', Bytes([$61, $E2, $86]));
  AssertRefused('4 of 4 cut after 3', Bytes([$61, $F0, $9F, $98]));
  AssertRefused('BOM cut', Bytes([$EF, $BB]));
end;

procedure TUtf8Tests.ValidBoundaries_AreAccepted;
begin
  AssertAccepted('U+0000', Bytes([$00]));
  AssertAccepted('U+007F', Bytes([$7F]));
  AssertAccepted('U+0080', Bytes([$C2, $80]));
  AssertAccepted('U+07FF', Bytes([$DF, $BF]));
  AssertAccepted('U+0800', Bytes([$E0, $A0, $80]));
  AssertAccepted('U+D7FF', Bytes([$ED, $9F, $BF]));
  AssertAccepted('U+E000', Bytes([$EE, $80, $80]));
  AssertAccepted('U+FFFD', Bytes([$EF, $BF, $BD]));
  AssertAccepted('U+10000', Bytes([$F0, $90, $80, $80]));
  AssertAccepted('U+1F600', Bytes([$F0, $9F, $98, $80]));
  AssertAccepted('U+10FFFF', Bytes([$F4, $8F, $BF, $BF]));
end;

procedure TUtf8Tests.ValidWithAndWithoutBom_StaysTrue;
var
  LText: string;
begin
  AssertAccepted('without BOM', NonAsciiBytes);
  AssertAccepted('with BOM', Bytes([$EF, $BB, $BF, $53, $C3, $A3, $6F, $20, $E2, $86, $92]));
  TAssert.AssertTrue(PcTryUtf8BytesToString(Bytes([$EF, $BB, $BF, $53, $C3, $A3, $6F, $20, $E2, $86, $92]), LText));
  TAssert.AssertEquals('São →', LText);
  TAssert.AssertTrue('empty is valid', PcIsValidUtf8(nil));
  TAssert.AssertTrue('BOM only is valid', PcIsValidUtf8(Bytes([$EF, $BB, $BF])));
end;

procedure TUtf8Tests.InvalidBytes_AreRefusedOutsideUtf8CodePageOnFpc;
var
  LText: string;
  LValid: Boolean;
  {$IFDEF FPC}
  LOldCodePage: TSystemCodePage;
  {$ENDIF}
begin
  // PcIsValidUtf8 doesn't depend on the code page: a caller tells "not
  // UTF-8" from "this code page can't hold it" with it.
  {$IFDEF FPC}
  LOldCodePage := DefaultSystemCodePage;
  SetMultiByteConversionCodePage(1252);
  try
  {$ENDIF}
    LValid := PcIsValidUtf8(NonAsciiBytes);
    TAssert.AssertFalse('UTF-16 refused', PcTryUtf8BytesToString(Utf16LeBytes, LText));
    TAssert.AssertFalse('UTF-16 not valid', PcIsValidUtf8(Utf16LeBytes));
  {$IFDEF FPC}
  finally
    SetMultiByteConversionCodePage(LOldCodePage);
  end;
  {$ENDIF}
  TAssert.AssertTrue('valid UTF-8 whatever the code page', LValid);
end;

initialization
  RegisterTest(TUtf8Tests);

end.
