unit PascalCommon.SafeLogTests;

{$mode delphi}{$H+}

{ GENERATED FILE — produced by tools/gen_fpc_mirror.py from
  tests/Unit/PascalCommon.SafeLogTests.pas (DUnitX). Do not edit by hand: edit the DUnitX
  master and run the script again. }

{ Tests for PascalCommon.SafeLog: what SafeWriteln writes, that it writes
  nothing (and doesn't format) without a console, that each line reaches a
  redirected stdout before the next write, and that concurrent writers don't
  corrupt each other's lines.

  The output is captured with a text-file driver of the test's own: Output is
  reassigned to a device whose InOutFunc appends the buffer to a memory stream.
  Its FlushFunc does nothing, which is how the RTL treats a file or a pipe:
  Writeln doesn't flush, the buffer goes out when it fills. It can't be nil:
  FPC skips a nil FlushFunc (its own stdout has one when redirected), but
  Delphi calls it unchecked, an access violation at address 0 (measured on
  Delphi 12, Win32 and Win64). That is the case where FPC
  needs SafeWriteln's Flush (unit header of PascalCommon.SafeLog, gotcha 8), so
  the concurrent test fails on FPC without it, on Windows as well as Linux.
  Output is a threadvar on FPC: there each writer thread redirects its own
  Output; on Delphi it is one global, redirected once by the test. The main
  thread's Output record is saved byte for byte and copied back afterwards: its
  BufPtr points into the record itself, so the copy stays valid.

  The file test redirects Output (the main thread's) to a real temporary file
  with AssignFile, so the RTL's own file path is the one tested: on both
  compilers a disk file gets a FlushFunc that writes nothing (gotchas 8 and
  9). It reads the file through a second handle after each SafeWriteln,
  without closing Output; both RTLs open the file sharing reads. It fails on
  Delphi without SafeWriteln's Flush (before 1.8.1): the short line doesn't
  reach the file at all, and after the long one the file holds only the first
  256 bytes of the output, two Delphi buffers.

  IsConsole is set explicitly in every test and restored: the FPC GUI runner on
  Windows runs without a console.

  The UTF-8 tests (PcSetSafeLogUtf8, 1.10.0) set the code page of the
  captured or file Output to 1252 before writing, so the bytes would come out
  in 1252 if SafeWriteln didn't switch it, and compare bytes, not strings.
  The text is built from UTF-8 bytes, not from a literal: this file has no
  BOM, and Delphi would read a non-ASCII literal in it as ANSI. It holds a
  character outside 1252 and one outside the BMP (a surrogate pair on
  Delphi). The console path (WriteConsoleW) has no test here: the tests'
  Output is never a console. It was measured by reading a console's screen
  back (unit header of PascalCommon.SafeLog).

  The concurrent test checks what can be checked from inside the process: every
  line arrives whole, none is lost, and each writer's lines arrive in the order
  it wrote them. It doesn't check that two libraries share the lock; that holds
  by construction, since there is one unit. The threads start together on an
  event, wait for it with a deadline and are joined with WaitFor.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  Classes,
  SyncObjs,
  PascalCommon.SafeLog;

type
  TSafeLogTests = class(TTestCase)
  published
    procedure WritesTheLine;
    procedure FormatOverload_FormatsTheLine;
    procedure NoConsole_WritesNothing;
    procedure NoConsole_FormatOverloadDoesntFormat;
    procedure FileOutput_EachLineReachesTheFileBeforeTheNextWrite;
    procedure ConcurrentWriters_EveryLineWholeAndInOrder;
    procedure Utf8_IsOffByDefault;
    procedure Utf8Off_WritesInTheOutputCodePage;
    procedure Utf8_WritesUtf8AndKeepsTheOutputCodePage;
    procedure Utf8_FileOutput_WritesUtf8;
    procedure Utf8_ConcurrentWriters_EveryLineWholeAndInOrder;
  end;

implementation

{$IFNDEF FPC}
uses
  System.IOUtils;
{$ENDIF}

const
  NUM_WRITERS = 8;
  LINES_PER_WRITER = 2000;
  // longer than either RTL's text buffer (Delphi 128, FPC 256 bytes), so a
  // buffer often fills in the middle of a line
  LINE_WIDTH = 300;
  START_TIMEOUT_MS = 10000;
  // a code page that isn't UTF-8: it has the a with tilde (#$E3) and the euro
  // sign (#$80), not the CJK character nor the emoji of the sample
  CP_LATIN = 1252;
  // "Sao Paulo" with an a-tilde, the euro sign, U+65E5 (CJK) and U+1F600 (an
  // emoji, a surrogate pair in UTF-16), in UTF-8
  SAMPLE_UTF8: array[0..22] of Byte = (
    $53, $C3, $A3, $6F, $20, $50, $61, $75, $6C, $6F, $20, $E2, $82, $AC,
    $20, $E6, $97, $A5, $20, $F0, $9F, $98, $80);

var
  GCaptureLock: TCriticalSection;
  GCaptured: TMemoryStream;
  GSavedOutput: TTextRec;

{ The capture device. FPC's text-file functions are procedures that report
  errors through InOutRes; Delphi's are functions returning the error code. }

{$IFDEF FPC}
procedure CaptureWrite(var F: TTextRec);
{$ELSE}
function CaptureWrite(var F: TTextRec): Integer;
{$ENDIF}
begin
  if F.BufPos > 0 then
  begin
    GCaptureLock.Enter;
    try
      GCaptured.WriteBuffer(F.BufPtr^, F.BufPos);
    finally
      GCaptureLock.Leave;
    end;
  end;
  F.BufPos := 0;
  {$IFNDEF FPC}
  Result := 0;
  {$ENDIF}
end;

{$IFDEF FPC}
procedure CaptureClose(var F: TTextRec);
begin
end;
{$ELSE}
function CaptureClose(var F: TTextRec): Integer;
begin
  Result := 0;
end;
{$ENDIF}

{$IFDEF FPC}
procedure CaptureNoFlush(var F: TTextRec);
begin
end;
{$ELSE}
function CaptureNoFlush(var F: TTextRec): Integer;
begin
  Result := 0;
end;
{$ENDIF}

{$IFDEF FPC}
procedure CaptureOpen(var F: TTextRec);
{$ELSE}
function CaptureOpen(var F: TTextRec): Integer;
{$ENDIF}
begin
  F.InOutFunc := @CaptureWrite;
  F.FlushFunc := @CaptureNoFlush; // like a file or a pipe: Writeln doesn't flush
  F.CloseFunc := @CaptureClose;
  F.BufPos := 0;
  F.BufEnd := 0;
  {$IFNDEF FPC}
  Result := 0;
  {$ENDIF}
end;

// Points T at the capture device. T's previous contents are overwritten, not
// closed: the caller saves them first if it needs them back.
procedure RedirectToCapture(var T: Text);
begin
  AssignFile(T, '');
  TTextRec(T).OpenFunc := @CaptureOpen;
  Rewrite(T);
end;

procedure BeginCapture;
begin
  GCaptured.Clear;
  Move(Output, GSavedOutput, SizeOf(TTextRec));
  RedirectToCapture(Output);
end;

// Closes the capture (sending what is left in the buffer), gives the main
// thread its Output back and returns what was written.
function EndCapture: string;
var
  LBytes: AnsiString;
begin
  CloseFile(Output);
  Move(GSavedOutput, Output, SizeOf(TTextRec));
  SetString(LBytes, PAnsiChar(GCaptured.Memory), GCaptured.Size);
  Result := string(LBytes);
end;

function BytesToHex(const ABytes: RawByteString): string;
var
  I: Integer;
begin
  Result := '';
  for I := 1 to Length(ABytes) do
    Result := Result + IntToHex(Ord(ABytes[I]), 2);
end;

// Closes the capture like EndCapture and returns what was written as hex.
function EndCaptureHex: string;
var
  LBytes: RawByteString;
begin
  CloseFile(Output);
  Move(GSavedOutput, Output, SizeOf(TTextRec));
  SetString(LBytes, PAnsiChar(GCaptured.Memory), GCaptured.Size);
  Result := BytesToHex(LBytes);
end;

function SampleUtf8: RawByteString;
begin
  SetLength(Result, Length(SAMPLE_UTF8));
  Move(SAMPLE_UTF8[0], Result[1], Length(SAMPLE_UTF8));
end;

// UTF-8 bytes as a string: UTF-16 on Delphi, the process code page on FPC
// (UTF-8 in the test runner).
function Utf8BytesToText(const ABytes: RawByteString): string;
var
  LUtf8: UTF8String;
begin
  SetLength(LUtf8, Length(ABytes));
  if ABytes <> '' then
    Move(ABytes[1], LUtf8[1], Length(ABytes));
  SetCodePage(RawByteString(LUtf8), CP_UTF8, False);
  Result := string(LUtf8);
end;

function SampleText: string;
begin
  Result := Utf8BytesToText(SampleUtf8);
end;

function LineBreakHex: string;
begin
  Result := BytesToHex(RawByteString(sLineBreak));
end;

function TempFilePath: string;
var
  LGuid: TGUID;
begin
  CreateGUID(LGuid);
  {$IFDEF FPC}
  Result := IncludeTrailingPathDelimiter(GetTempDir);
  {$ELSE}
  Result := IncludeTrailingPathDelimiter(TPath.GetTempPath);
  {$ENDIF}
  Result := Result + 'pascalcommon-safelog-' + Copy(GUIDToString(LGuid), 2, 36) + '.txt';
end;

// Reads the whole file through a handle of its own, while another may still
// be writing it.
function ReadWholeFileBytes(const APath: string): RawByteString;
var
  LStream: TFileStream;
begin
  LStream := TFileStream.Create(APath, fmOpenRead or fmShareDenyNone);
  try
    SetLength(Result, LStream.Size);
    if LStream.Size > 0 then
      LStream.ReadBuffer(Result[1], LStream.Size);
  finally
    LStream.Free;
  end;
end;

function ReadWholeFile(const APath: string): string;
var
  LStream: TFileStream;
  LBytes: AnsiString;
begin
  LStream := TFileStream.Create(APath, fmOpenRead or fmShareDenyNone);
  try
    SetLength(LBytes, LStream.Size);
    if LStream.Size > 0 then
      LStream.ReadBuffer(LBytes[1], LStream.Size);
  finally
    LStream.Free;
  end;
  Result := string(LBytes);
end;

type
  { Writes LINES_PER_WRITER numbered lines, alternating the two overloads,
    once AStart is set. }
  TWriterThread = class(TThread)
  private
    FIndex: Integer;
    FStart: TEvent;
    FBody: string;
  protected
    procedure Execute; override;
  public
    constructor Create(AIndex: Integer; AStart: TEvent);
  end;

constructor TWriterThread.Create(AIndex: Integer; AStart: TEvent);
begin
  FIndex := AIndex;
  FStart := AStart;
  FBody := StringOfChar(Chr(Ord('A') + AIndex), LINE_WIDTH);
  FreeOnTerminate := False;
  inherited Create(False);
end;

procedure TWriterThread.Execute;
var
  I: Integer;
begin
  {$IFDEF FPC}
  // Output is this thread's own on FPC (unit header)
  RedirectToCapture(Output);
  try
  {$ENDIF}
    if FStart.WaitFor(START_TIMEOUT_MS) <> wrSignaled then
      raise Exception.Create('start event not set');
    for I := 1 to LINES_PER_WRITER do
      if Odd(I) then
        SafeWriteln(Format('T%d-%.5d-', [FIndex, I]) + FBody)
      else
        SafeWriteln('T%d-%.5d-%s', [FIndex, I, FBody]);
  {$IFDEF FPC}
  finally
    CloseFile(Output);
  end;
  {$ENDIF}
end;

// Checks that AText holds exactly the lines the writers wrote: each one whole,
// none missing, each writer's in order. Returns '' or what is wrong.
function CheckWriterLines(const AText: string): string;
var
  LLines: TStringList;
  LNext: array[0..NUM_WRITERS - 1] of Integer;
  LLine: string;
  I, LWriter: Integer;
begin
  Result := '';
  for I := 0 to NUM_WRITERS - 1 do
    LNext[I] := 1;
  LLines := TStringList.Create;
  try
    LLines.Text := AText;
    for I := 0 to LLines.Count - 1 do
    begin
      LLine := LLines[I];
      LWriter := -1;
      if (Length(LLine) > 2) and (LLine[2] >= '0') and
        (LLine[2] < Chr(Ord('0') + NUM_WRITERS)) then
        LWriter := Ord(LLine[2]) - Ord('0');
      if (LWriter < 0) or (LNext[LWriter] > LINES_PER_WRITER) or
        (LLine <> Format('T%d-%.5d-', [LWriter, LNext[LWriter]]) +
          StringOfChar(Chr(Ord('A') + LWriter), LINE_WIDTH)) then
      begin
        Result := Format('line %d of %d is not the next line of any writer: "%s"',
          [I + 1, LLines.Count, Copy(LLine, 1, 40)]);
        Exit;
      end;
      Inc(LNext[LWriter]);
    end;
    for I := 0 to NUM_WRITERS - 1 do
      if LNext[I] <> LINES_PER_WRITER + 1 then
      begin
        Result := Format('writer %d: %d of %d lines arrived',
          [I, LNext[I] - 1, LINES_PER_WRITER]);
        Exit;
      end;
  finally
    LLines.Free;
  end;
end;

{ TSafeLogTests }

procedure TSafeLogTests.WritesTheLine;
var
  LOldIsConsole: Boolean;
  LText: string;
begin
  LOldIsConsole := IsConsole;
  IsConsole := True;
  BeginCapture;
  try
    SafeWriteln('hello world');
    SafeWriteln('');
  finally
    LText := EndCapture;
    IsConsole := LOldIsConsole;
  end;
  TAssert.AssertEquals('hello world' + sLineBreak + sLineBreak, LText);
end;

procedure TSafeLogTests.FormatOverload_FormatsTheLine;
var
  LOldIsConsole: Boolean;
  LText: string;
begin
  LOldIsConsole := IsConsole;
  IsConsole := True;
  BeginCapture;
  try
    SafeWriteln('%s=%d', ['answer', 42]);
    SafeWriteln('plain');
  finally
    LText := EndCapture;
    IsConsole := LOldIsConsole;
  end;
  TAssert.AssertEquals('answer=42' + sLineBreak + 'plain' + sLineBreak, LText);
end;

procedure TSafeLogTests.NoConsole_WritesNothing;
var
  LOldIsConsole: Boolean;
  LText: string;
begin
  LOldIsConsole := IsConsole;
  IsConsole := False;
  BeginCapture;
  try
    SafeWriteln('should not appear');
    SafeWriteln('%s', ['should not appear']);
  finally
    LText := EndCapture;
    IsConsole := LOldIsConsole;
  end;
  TAssert.AssertEquals('', LText);
end;

procedure TSafeLogTests.NoConsole_FormatOverloadDoesntFormat;
var
  LOldIsConsole: Boolean;
begin
  LOldIsConsole := IsConsole;
  IsConsole := False;
  try
    // formatting this raises EConvertError, so getting past it proves the
    // IsConsole check comes first
    SafeWriteln('%d', ['not a number']);
  finally
    IsConsole := LOldIsConsole;
  end;
  TAssert.AssertTrue('returned without formatting', True);
end;

procedure TSafeLogTests.FileOutput_EachLineReachesTheFileBeforeTheNextWrite;
var
  LOldIsConsole: Boolean;
  LSaved: TTextRec;
  LPath, LShort, LLong, LAfterShort, LAfterLong: string;
begin
  LShort := 'a short line';
  // longer than two Delphi buffers, like the access-log line that showed it
  LLong := '{"line":"long",' + StringOfChar('x', LINE_WIDTH) + '"dur":1}';
  LPath := TempFilePath;
  LOldIsConsole := IsConsole;
  IsConsole := True;
  Move(Output, LSaved, SizeOf(TTextRec));
  AssignFile(Output, LPath);
  Rewrite(Output);
  try
    SafeWriteln(LShort);
    LAfterShort := ReadWholeFile(LPath);
    SafeWriteln(LLong);
    LAfterLong := ReadWholeFile(LPath);
  finally
    CloseFile(Output);
    Move(LSaved, Output, SizeOf(TTextRec));
    IsConsole := LOldIsConsole;
    DeleteFile(LPath);
  end;
  TAssert.AssertEquals('after the short line', LShort + sLineBreak, LAfterShort);
  TAssert.AssertEquals('after the long line', LShort + sLineBreak + LLong + sLineBreak,
    LAfterLong);
end;

// Runs NUM_WRITERS writer threads into the capture and returns '' or what
// went wrong.
function RunConcurrentWriters: string;
var
  LOldIsConsole: Boolean;
  LStart: TEvent;
  LWriters: array[0..NUM_WRITERS - 1] of TWriterThread;
  LErrors, LText: string;
  I: Integer;
begin
  Result := '';
  LErrors := '';
  LOldIsConsole := IsConsole;
  IsConsole := True;
  FillChar(LWriters, SizeOf(LWriters), 0);
  LStart := TEvent.Create(nil, True, False, '');
  BeginCapture;
  try
    for I := 0 to NUM_WRITERS - 1 do
      LWriters[I] := TWriterThread.Create(I, LStart);
    LStart.SetEvent;
  finally
    for I := 0 to NUM_WRITERS - 1 do
      if LWriters[I] <> nil then
      begin
        LWriters[I].WaitFor;
        if LWriters[I].FatalException <> nil then
          LErrors := LErrors + Format('writer %d: %s; ',
            [I, Exception(LWriters[I].FatalException).Message]);
        LWriters[I].Free;
      end;
    LText := EndCapture;
    IsConsole := LOldIsConsole;
    LStart.Free;
  end;
  if LErrors <> '' then
    Result := LErrors
  else
    Result := CheckWriterLines(LText);
end;

procedure TSafeLogTests.ConcurrentWriters_EveryLineWholeAndInOrder;
begin
  TAssert.AssertEquals('', RunConcurrentWriters);
end;

procedure TSafeLogTests.Utf8_IsOffByDefault;
begin
  // every test that turns it on turns it off again in a finally
  TAssert.AssertFalse(PcSafeLogUtf8);
end;

procedure TSafeLogTests.Utf8Off_WritesInTheOutputCodePage;
var
  LOldIsConsole: Boolean;
  LHex: string;
begin
  LOldIsConsole := IsConsole;
  IsConsole := True;
  BeginCapture;
  try
    TTextRec(Output).CodePage := CP_LATIN;
    SafeWriteln(Utf8BytesToText(Copy(SampleUtf8, 1, 3)));
  finally
    LHex := EndCaptureHex;
    IsConsole := LOldIsConsole;
  end;
  // without the option, S and a-tilde come out in 1252: the setup of the
  // UTF-8 tests would catch a SafeWriteln that ignores the option
  TAssert.AssertEquals('53E3' + LineBreakHex, LHex);
end;

procedure TSafeLogTests.Utf8_WritesUtf8AndKeepsTheOutputCodePage;
var
  LOldIsConsole: Boolean;
  LCodePageAfter: Word;
  LHex: string;
begin
  LOldIsConsole := IsConsole;
  IsConsole := True;
  BeginCapture;
  PcSetSafeLogUtf8(True);
  try
    TTextRec(Output).CodePage := CP_LATIN;
    SafeWriteln(SampleText);
    SafeWriteln('%s!', [SampleText]);
    LCodePageAfter := TTextRec(Output).CodePage;
  finally
    PcSetSafeLogUtf8(False);
    LHex := EndCaptureHex;
    IsConsole := LOldIsConsole;
  end;
  TAssert.AssertEquals(BytesToHex(SampleUtf8) + LineBreakHex +
    BytesToHex(SampleUtf8) + '21' + LineBreakHex, LHex);
  TAssert.AssertEquals('Output code page set back', CP_LATIN, Integer(LCodePageAfter));
end;

procedure TSafeLogTests.Utf8_FileOutput_WritesUtf8;
var
  LOldIsConsole: Boolean;
  LSaved: TTextRec;
  LPath, LAfterFirst, LAfterSecond: string;
begin
  LPath := TempFilePath;
  LOldIsConsole := IsConsole;
  IsConsole := True;
  Move(Output, LSaved, SizeOf(TTextRec));
  AssignFile(Output, LPath);
  Rewrite(Output);
  PcSetSafeLogUtf8(True);
  try
    TTextRec(Output).CodePage := CP_LATIN;
    SafeWriteln(SampleText);
    LAfterFirst := BytesToHex(ReadWholeFileBytes(LPath));
    SafeWriteln('plain');
    LAfterSecond := BytesToHex(ReadWholeFileBytes(LPath));
  finally
    PcSetSafeLogUtf8(False);
    CloseFile(Output);
    Move(LSaved, Output, SizeOf(TTextRec));
    IsConsole := LOldIsConsole;
    DeleteFile(LPath);
  end;
  TAssert.AssertEquals('after the first line', BytesToHex(SampleUtf8) + LineBreakHex,
    LAfterFirst);
  TAssert.AssertEquals('after the second line', BytesToHex(SampleUtf8) + LineBreakHex +
    BytesToHex(RawByteString('plain')) + LineBreakHex, LAfterSecond);
end;

procedure TSafeLogTests.Utf8_ConcurrentWriters_EveryLineWholeAndInOrder;
var
  LResult: string;
begin
  PcSetSafeLogUtf8(True);
  try
    LResult := RunConcurrentWriters;
  finally
    PcSetSafeLogUtf8(False);
  end;
  TAssert.AssertEquals('', LResult);
end;

initialization
  GCaptureLock := TCriticalSection.Create;
  GCaptured := TMemoryStream.Create;
  RegisterTest(TSafeLogTests);

finalization
  GCaptured.Free;
  GCaptureLock.Free;

end.
