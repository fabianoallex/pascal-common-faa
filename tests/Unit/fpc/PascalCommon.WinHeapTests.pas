{ Tests for PascalCommon.WinHeap: what PcMemoryManagerName says on each
  compiler, and that the unit did NOT install in this runner.

  The unit switches the memory manager only when it is the program's first
  unit and nothing was allocated yet. Here it is linked after the test
  framework, which allocates in its initialization, so it must leave
  Delphi's manager in place: that is the case it guards against (a block
  from one manager freed by another), and it is what keeps
  ReportMemoryLeaksOnShutdown meaningful for this suite. The installed case
  (first unit) is the application's: pascal-agenda-faa's api logs
  'windows heap' at startup, and pascal-db-faa's gotcha 55 has the
  measurement.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  PascalCommon.WinHeap;

type
  TWinHeapTests = class(TTestCase)
  published
    procedure Name_PerCompiler_NotInstalledLate;
  end;

implementation

procedure TWinHeapTests.Name_PerCompiler_NotInstalledLate;
var
  LName: string;
begin
  LName := PcMemoryManagerName;
  {$IFDEF FPC}
  TAssert.AssertEquals('fpc', LName);
  {$ELSE}
  {$IFDEF MSWINDOWS}
  TAssert.AssertFalse('installed although linked late: ' + LName, LName = 'windows heap');
  TAssert.AssertTrue(LName,
    (LName = 'delphi (blocks allocated before PascalCommon.WinHeap)') or
    (LName = 'delphi (MEMORY_MANAGER=default)'));
  {$ELSE}
  TAssert.AssertEquals('delphi', LName);
  {$ENDIF}
  {$ENDIF}
end;

