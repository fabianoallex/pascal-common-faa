  LHost := TLoaderHost.Create(False);
  try
    LStore.Mode := smUnavailable;
    LKey := LCache.Key('k', ['t']);
    TAssert.AssertEquals('', LKey);
    TAssert.AssertEquals('loaded:1', LCache.GetOrLoad(LKey, 60, LHost.Load, '1'));
    TAssert.AssertEquals('loaded:1', LCache.GetOrLoad(LKey, 60, LHost.Load, '1'));
    TAssert.AssertEquals('an empty key is never stored', 2, LHost.Calls);
