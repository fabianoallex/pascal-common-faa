  Enter;
  FInner.Put(AKey, AValue, ATtlMs);
end;

procedure TSwitchableStore.Delete(const AKey: string);
begin
  Enter;
  FInner.Delete(AKey);
end;

function TSwitchableStore.Generations(const ATags: array of string): TArray<Int64>;
