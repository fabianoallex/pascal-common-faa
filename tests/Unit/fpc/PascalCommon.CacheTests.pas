constructor TSwitchableStore.Create;
begin
  inherited Create;
  FInner := TPcMemoryCacheStore.Create(100);
end;

procedure TSwitchableStore.Enter;
begin
  PcAtomicInc(Calls);
  case Mode of
    smUnavailable: raise EPcCacheUnavailable.Create('store down (test)');
    smBug: raise EInvalidOperation.Create('store bug (test)');
  end;
end;

function TSwitchableStore.TryGet(const AKey: string; out AValue: string): Boolean;
begin
  Enter;
  Result := FInner.TryGet(AKey, AValue);
end;

procedure TSwitchableStore.Put(const AKey, AValue: string; ATtlMs: Int64);
