  Enter;
  Result := FInner.Generations(ATags);
end;

procedure TSwitchableStore.Bump(const ATags: array of string);
begin
  Enter;
  FInner.Bump(ATags);
end;

constructor TLoaderHost.Create(ABlock: Boolean);
begin
  inherited Create;
  Started := TEvent.Create(nil, True, False, '');
  if ABlock then
    Release := TEvent.Create(nil, True, False, '');
end;

destructor TLoaderHost.Destroy;
begin
  Started.Free;
  Release.Free;
  inherited Destroy;
end;

function TLoaderHost.Load(const AArg: string): string;
begin
  PcAtomicInc(Calls);
  Started.SetEvent;
  if Release <> nil then
    Release.WaitFor(10000);
  if RaiseIt then
    raise EConvertError.Create('loader failed (test)');
  Result := 'loaded:' + AArg;
end;

procedure TErrorLog.OnError(const ACacheName: string; AError: Exception);
begin
  Inc(Count);
  LastCache := ACacheName;
  LastMessage := AError.Message;
end;

constructor TGetOrLoadThread.Create(const ACache: IPcCache; AHost: TLoaderHost;
  const AKey: string);
begin
  FCache := ACache;
  FHost := AHost;
  FKey := AKey;
  FreeOnTerminate := False;
  inherited Create(False);
end;

procedure TGetOrLoadThread.Execute;
begin
  try
    Value := FCache.GetOrLoad(FKey, 60, FHost.Load, 'x');
  except
    on E: EPcCacheLoadError do
    begin
      ErrorClass := E.ClassName;
      ErrorOriginalClass := E.OriginalClassName;
      ErrorMessage := E.Message;
    end;
    on E: Exception do
    begin
      ErrorClass := E.ClassName;
      ErrorMessage := E.Message;
    end;
  end;
end;

function NewName: string;
begin
  Result := 'test-' + IntToStr(PcAtomicInc(GNameSeq));
end;

function Metric(const AMetric, AUnit, ACache: string): Double;
begin
  Result := PcMetrics.Counter(AMetric, AUnit, '', ['cache']).Labels([ACache]).Value;
end;

// Waits until ACache has AExpected threads waiting for a load; False past
// the deadline.
function WaitWaiting(ACache: TPcCache; AExpected: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + 10000;
  while (ACache.LoadsWaiting < AExpected) and (PcTickMs < LDeadline) do
    Sleep(1);
  Result := ACache.LoadsWaiting = AExpected;
end;

type
  TThreadArray = array[0..THREADS - 1] of TGetOrLoadThread;

// Starts THREADS threads on one key with a blocking loader, releases it
// once the other THREADS - 1 are waiting, and waits for them all.
procedure RunConcurrentLoad(ACacheObject: TPcCache; AHost: TLoaderHost;
  out AThreads: TThreadArray);
var
  LCache: IPcCache;
  I: Integer;
begin
  LCache := ACacheObject;
  for I := 0 to THREADS - 1 do
    AThreads[I] := nil;
  try
    for I := 0 to THREADS - 1 do
      AThreads[I] := TGetOrLoadThread.Create(LCache, AHost, LCache.Key('k', []));
    TAssert.AssertTrue('the loader must start', AHost.Started.WaitFor(10000) = wrSignaled);
    TAssert.AssertTrue('every other thread must wait for the load',
      WaitWaiting(ACacheObject, THREADS - 1));
  finally
    if AHost.Release <> nil then
      AHost.Release.SetEvent;
    for I := 0 to THREADS - 1 do
      if AThreads[I] <> nil then
        AThreads[I].WaitFor;
  end;
end;

procedure FreeThreads(var AThreads: TThreadArray);
var
  I: Integer;
begin
  for I := 0 to THREADS - 1 do
    FreeAndNil(AThreads[I]);
end;

