procedure TCacheTests.Failure_InvalidateAndRemoveDoNotRaise;
var
  LStore: TSwitchableStore;
  LStoreRef: IPcCacheStore;
  LLog: TErrorLog;
  LCache: IPcCache;
  LCalls: Integer;
begin
  LStore := TSwitchableStore.Create;
  LStoreRef := LStore;
  LLog := TErrorLog.Create;
  try
    LCache := TPcCache.Create(LStoreRef, NewName, LLog.OnError, 1000);
    LStore.Mode := smUnavailable;
    LCache.Invalidate(['t']);
    LCalls := LStore.Calls;
    LCache.Invalidate(['t']); // in the pause: still tried
    LCache.Remove(LCache.Key('k', []));
    TAssert.AssertEquals('tried even in the pause', LCalls + 2, LStore.Calls);
    TAssert.AssertEquals(3, LLog.Count);
