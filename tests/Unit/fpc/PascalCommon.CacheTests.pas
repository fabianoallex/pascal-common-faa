procedure TCacheTests.Memory_PutThenTryGet_ReturnsTheValue;
var
  LStore: IPcCacheStore;
  LValue: string;
begin
  LStore := TPcMemoryCacheStore.Create(10);
  TAssert.AssertFalse(LStore.TryGet('a', LValue));
  TAssert.AssertEquals('', LValue);
  LStore.Put('a', '{"city":"São Paulo"}', 1000);
  TAssert.AssertTrue(LStore.TryGet('a', LValue));
  TAssert.AssertEquals('{"city":"São Paulo"}', LValue);
  LStore.Put('a', 'second', 1000);
  TAssert.AssertTrue(LStore.TryGet('a', LValue));
  TAssert.AssertEquals('second', LValue);
end;

procedure TCacheTests.Memory_ExpiresWhenTheTtlEnds;
var
  LObject: TPcMemoryCacheStore;
  LStore: IPcCacheStore;
  LValue: string;
begin
  LObject := TPcMemoryCacheStore.Create(10);
  LStore := LObject;
  LStore.Put('a', 'v', 1000);
  GTicker.Ms := GTicker.Ms + 999;
  TAssert.AssertTrue('1 ms before the TTL ends', LStore.TryGet('a', LValue));
  GTicker.Ms := GTicker.Ms + 1;
  TAssert.AssertFalse('when the TTL ends', LStore.TryGet('a', LValue));
  TAssert.AssertEquals('an expired entry is removed when read', 0, LObject.Count);
end;

procedure TCacheTests.Memory_PutWithZeroTtl_RemovesTheKey;
var
  LObject: TPcMemoryCacheStore;
  LStore: IPcCacheStore;
  LValue: string;
begin
  LObject := TPcMemoryCacheStore.Create(10);
  LStore := LObject;
  LStore.Put('a', 'v', 1000);
  LStore.Put('a', 'w', 0);
  TAssert.AssertFalse(LStore.TryGet('a', LValue));
  LStore.Put('b', 'v', -5);
  TAssert.AssertEquals(0, LObject.Count);
end;

procedure TCacheTests.Memory_Delete_RemovesTheKey;
var
  LStore: IPcCacheStore;
  LValue: string;
begin
  LStore := TPcMemoryCacheStore.Create(10);
  LStore.Put('a', 'v', 1000);
  LStore.Put('b', 'v', 1000);
  LStore.Delete('a');
  LStore.Delete('missing');
  TAssert.AssertFalse(LStore.TryGet('a', LValue));
  TAssert.AssertTrue(LStore.TryGet('b', LValue));
end;

procedure TCacheTests.Memory_Full_DropsTheExpiredBeforeTheOldest;
var
  LObject: TPcMemoryCacheStore;
  LStore: IPcCacheStore;
  LValue: string;
begin
  LObject := TPcMemoryCacheStore.Create(3);
  LStore := LObject;
  LStore.Put('a', 'v', 60000);
  LStore.Put('b', 'v', 100);
  LStore.Put('c', 'v', 100);
  GTicker.Ms := GTicker.Ms + 200;
  LStore.Put('d', 'v', 60000);
  TAssert.AssertEquals('both expired entries go', 2, LObject.Count);
  TAssert.AssertTrue('the oldest stays: it had not expired', LStore.TryGet('a', LValue));
  TAssert.AssertTrue(LStore.TryGet('d', LValue));
end;

procedure TCacheTests.Memory_Full_DropsTheOldestByInsertion;
var
  LObject: TPcMemoryCacheStore;
  LStore: IPcCacheStore;
  LValue: string;
begin
  LObject := TPcMemoryCacheStore.Create(3);
  LStore := LObject;
  LStore.Put('a', 'v', 60000);
  LStore.Put('b', 'v', 60000);
  LStore.Put('c', 'v', 60000);
  LStore.Put('d', 'v', 60000);
  TAssert.AssertEquals(3, LObject.Count);
  TAssert.AssertFalse('a, the oldest, goes', LStore.TryGet('a', LValue));
  LStore.Put('b', 'w', 60000); // written again: now the newest
  LStore.Put('e', 'v', 60000);
  TAssert.AssertFalse('c is the oldest now', LStore.TryGet('c', LValue));
  TAssert.AssertTrue(LStore.TryGet('b', LValue));
  TAssert.AssertEquals('w', LValue);
  TAssert.AssertTrue(LStore.TryGet('d', LValue));
  TAssert.AssertTrue(LStore.TryGet('e', LValue));
end;

procedure TCacheTests.Memory_ZeroEntries_KeepsNothingAndNoCounters;
var
  LObject: TPcMemoryCacheStore;
  LStore: IPcCacheStore;
  LValue: string;
  LGenerations: TArray<Int64>;
  I: Integer;
begin
  LObject := TPcMemoryCacheStore.Create(0);
  LStore := LObject;
  LStore.Put('a', 'v', 60000);
  TAssert.AssertFalse(LStore.TryGet('a', LValue));
  for I := 1 to 1000 do
  begin
    LGenerations := LStore.Generations(['product:' + IntToStr(I), 'products']);
    TAssert.AssertEquals(2, Length(LGenerations));
    TAssert.AssertEquals(Int64(0), LGenerations[0]);
    TAssert.AssertEquals(Int64(0), LGenerations[1]);
    LStore.Bump(['product:' + IntToStr(I)]);
  end;
  TAssert.AssertEquals(0, LObject.Count);
  TAssert.AssertEquals('no tag counter is kept', 0, LObject.TagCount);
end;

procedure TCacheTests.Memory_Bump_MovesTheCounterForward;
var
  LStore: IPcCacheStore;
  LFirst, LSecond: TArray<Int64>;
begin
  LStore := TPcMemoryCacheStore.Create(10);
  LFirst := LStore.Generations(['a', 'b']);
  TAssert.AssertTrue('the two counters differ', LFirst[0] <> LFirst[1]);
  TAssert.AssertEquals('reading again changes nothing', LFirst[0], LStore.Generations(['a'])[0]);
  LStore.Bump(['a']);
  LSecond := LStore.Generations(['a', 'b']);
  TAssert.AssertTrue('a moved forward', LSecond[0] > LFirst[0]);
  TAssert.AssertEquals('b did not move', LFirst[1], LSecond[1]);
end;

procedure TCacheTests.Memory_Bump_OfAMissingCounter_CreatesNothing;
var
  LObject: TPcMemoryCacheStore;
  LStore: IPcCacheStore;
begin
  LObject := TPcMemoryCacheStore.Create(10);
  LStore := LObject;
  LStore.Bump(['a', 'b']);
  TAssert.AssertEquals(0, LObject.TagCount);
end;

procedure TCacheTests.Memory_DroppedCounter_ComesBackLarger;
var
  LObject: TPcMemoryCacheStore;
  LStore: IPcCacheStore;
  LBefore, LAfter: Int64;
  I: Integer;
begin
  LObject := TPcMemoryCacheStore.Create(10, 2);
  LStore := LObject;
  LStore.Generations(['a']);
  for I := 1 to 5 do
    LStore.Bump(['a']);
  LBefore := LStore.Generations(['a'])[0];
  LStore.Generations(['b']);
  LStore.Generations(['c']); // the third counter: a, least recently used, goes
  TAssert.AssertEquals(2, LObject.TagCount);
  LAfter := LStore.Generations(['a'])[0];
  TAssert.AssertTrue(Format('a came back at %d, not above %d', [LAfter, LBefore]),
    LAfter > LBefore);
end;

procedure TCacheTests.Cache_Create_RejectsANilStoreAndBadNames;

  procedure Expect(const AStore: IPcCacheStore; const AName: string);
  var
    LCache: IPcCache;
  begin
    try
      LCache := TPcCache.Create(AStore, AName);
      TAssert.Fail('accepted the name "' + AName + '"');
    except
      on E: EArgumentException do
        ;
    end;
  end;

var
  LStore: IPcCacheStore;
begin
  LStore := TPcMemoryCacheStore.Create(10);
  Expect(nil, 'app');
  Expect(LStore, '');
  Expect(LStore, 'a:b');
  Expect(LStore, 'a|b');
