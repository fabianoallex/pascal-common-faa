  end;
end;

procedure TCacheTests.Failure_OtherExceptionsPropagate;
var
  LStore: TSwitchableStore;
  LStoreRef: IPcCacheStore;
  LCache: IPcCache;
  LValue: string;
  LRaised: Integer;
begin
  LStore := TSwitchableStore.Create;
  LStoreRef := LStore;
  LCache := TPcCache.Create(LStoreRef, NewName, nil, 1000);
  LStore.Mode := smBug;
  LRaised := 0;
  try
    LCache.TryGet(LCache.Key('k', []), LValue);
  except
    on E: EInvalidOperation do
      Inc(LRaised);
  end;
  try
    LCache.Key('k', ['t']);
  except
    on E: EInvalidOperation do
      Inc(LRaised);
  end;
  try
    LCache.Invalidate(['t']);
  except
    on E: EInvalidOperation do
      Inc(LRaised);
  end;
  TAssert.AssertEquals('TryGet, Key and Invalidate raise', 3, LRaised);
  LStore.Mode := smOk;
  LCache.Put(LCache.Key('k', []), 'v', 60);
  TAssert.AssertTrue('a bug does not pause the store', LCache.TryGet(LCache.Key('k', []), LValue));
end;

initialization
  RegisterTest(TCacheTests);

