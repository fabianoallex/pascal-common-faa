procedure TCacheTests.Cache_Key_HasTheNameTheKeyAndTheGenerations;
var
  LCache: IPcCache;
begin
  LCache := TPcCache.Create(TPcMemoryCacheStore.Create(10), 'app');
  TAssert.AssertEquals('app', LCache.Name);
  TAssert.AssertEquals('app:v:product.list|', LCache.Key('product.list', []));
  // A new store's sequence starts at 1: products gets 1, category:7 gets 2.
  TAssert.AssertEquals('app:v:product.list:7|1,2',
    LCache.Key('product.list:7', ['products', 'category:7']));
  LCache.Invalidate(['category:7']);
  TAssert.AssertEquals('app:v:product.list:7|1,3',
    LCache.Key('product.list:7', ['products', 'category:7']));
end;

procedure TCacheTests.Cache_Key_IsUnambiguous;
var
  LCache: IPcCache;
begin
  LCache := TPcCache.Create(TPcMemoryCacheStore.Create(10), NewName);
  LCache.Key('', ['t1', 't2']); // t1 = 1, t2 = 2
  TAssert.AssertFalse(LCache.Key('a|1', []) = LCache.Key('a', ['t1']));
  TAssert.AssertFalse(LCache.Key('a|1', ['t2']) = LCache.Key('a', ['t1', 't2']));
  TAssert.AssertFalse(LCache.Key('a,1', ['t2']) = LCache.Key('a', ['t1', 't2']));
end;

procedure TCacheTests.Cache_Invalidate_EitherTagMakesTheKeyMiss;
var
  LCache: IPcCache;
  LValue: string;

  procedure PutBoth;
  begin
    LCache.Put(LCache.Key('xy', ['x', 'y']), 'XY', 60);
    LCache.Put(LCache.Key('z', ['z']), 'Z', 60);
  end;

begin
  LCache := TPcCache.Create(TPcMemoryCacheStore.Create(10), NewName);
  PutBoth;
  TAssert.AssertTrue(LCache.TryGet(LCache.Key('xy', ['x', 'y']), LValue));
  TAssert.AssertEquals('XY', LValue);
  LCache.Invalidate(['x']);
  TAssert.AssertFalse('after x', LCache.TryGet(LCache.Key('xy', ['x', 'y']), LValue));
  TAssert.AssertTrue('z is untouched', LCache.TryGet(LCache.Key('z', ['z']), LValue));
  PutBoth;
  LCache.Invalidate(['y']);
  TAssert.AssertFalse('after y', LCache.TryGet(LCache.Key('xy', ['x', 'y']), LValue));
  TAssert.AssertTrue(LCache.TryGet(LCache.Key('z', ['z']), LValue));
end;

procedure TCacheTests.Cache_DroppedCounter_OldEntryIsNotRead;
var
  LObject: TPcMemoryCacheStore;
  LCache: IPcCache;
  LOldKey: string;
  LValue: string;
begin
  LObject := TPcMemoryCacheStore.Create(10, 1);
  LCache := TPcCache.Create(LObject, NewName);
  LOldKey := LCache.Key('k', ['a']);
  LCache.Put(LOldKey, 'old', 60);
  LCache.Key('other', ['b']); // the only counter slot: a is dropped
  LCache.Invalidate(['a']);   // a doesn't exist now: nothing to move
  TAssert.AssertFalse('a new key after a counter came back',
    LCache.Key('k', ['a']) = LOldKey);
  TAssert.AssertFalse(LCache.TryGet(LCache.Key('k', ['a']), LValue));
end;

procedure TCacheTests.Cache_PutWithZeroTtl_StoresNothing;
var
  LCache: IPcCache;
  LValue: string;
begin
  LCache := TPcCache.Create(TPcMemoryCacheStore.Create(10), NewName);
  LCache.Put(LCache.Key('k', []), 'v', 0);
  TAssert.AssertFalse(LCache.TryGet(LCache.Key('k', []), LValue));
  LCache.Put(LCache.Key('k', []), 'v', 1);
  TAssert.AssertTrue(LCache.TryGet(LCache.Key('k', []), LValue));
  GTicker.Ms := GTicker.Ms + 1000;
  TAssert.AssertFalse('one second later', LCache.TryGet(LCache.Key('k', []), LValue));
end;

procedure TCacheTests.Cache_Metrics_CountHitsMissesLoadsAndInvalidations;
var
  LName: string;
  LCache: IPcCache;
  LHost: TLoaderHost;
  LValue: string;
begin
  LName := NewName;
  LCache := TPcCache.Create(TPcMemoryCacheStore.Create(10), LName);
  LHost := TLoaderHost.Create(False);
  try
    LCache.TryGet(LCache.Key('a', []), LValue);                    // miss
    LCache.GetOrLoad(LCache.Key('a', []), 60, LHost.Load, 'a');    // miss, load
    LCache.GetOrLoad(LCache.Key('a', []), 60, LHost.Load, 'a');    // hit
    LCache.TryGet(LCache.Key('a', []), LValue);                    // hit
    LHost.RaiseIt := True;
    try
      LCache.GetOrLoad(LCache.Key('b', []), 60, LHost.Load, 'b');  // miss, failed load
    except
      on E: EConvertError do
        ;
    end;
    LCache.Invalidate(['t']);
    LCache.Invalidate([]); // nothing to invalidate: not counted
  finally
    LHost.Free;
  end;
  TAssert.AssertEquals('hits', 2, Metric('pc.cache.hits', '{hit}', LName), 0);
  TAssert.AssertEquals('misses', 3, Metric('pc.cache.misses', '{miss}', LName), 0);
  TAssert.AssertEquals('loads', 2, Metric('pc.cache.loads', '{load}', LName), 0);
  TAssert.AssertEquals('load failures', 1, Metric('pc.cache.load_failures', '{load}', LName), 0);
  TAssert.AssertEquals('invalidations', 1,
    Metric('pc.cache.invalidations', '{invalidation}', LName), 0);
  TAssert.AssertEquals('store errors', 0, Metric('pc.cache.store_errors', '{error}', LName), 0);
end;

procedure TCacheTests.GetOrLoad_Miss_RunsTheLoaderAndStores;
var
  LCache: IPcCache;
  LHost: TLoaderHost;
  LValue: string;
begin
  LCache := TPcCache.Create(TPcMemoryCacheStore.Create(10), NewName);
  LHost := TLoaderHost.Create(False);
  try
    TAssert.AssertEquals('loaded:7', LCache.GetOrLoad(LCache.Key('k', ['t']), 60, LHost.Load, '7'));
    TAssert.AssertEquals('loaded:7', LCache.GetOrLoad(LCache.Key('k', ['t']), 60, LHost.Load, '7'));
    TAssert.AssertEquals('the second call is a hit', 1, LHost.Calls);
    TAssert.AssertTrue(LCache.TryGet(LCache.Key('k', ['t']), LValue));
    TAssert.AssertEquals('loaded:7', LValue);
  finally
    LHost.Free;
  end;
end;

procedure TCacheTests.GetOrLoad_ConcurrentMisses_LoadOnce;
var
  LObject: TPcCache;
  LCache: IPcCache;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  I: Integer;
begin
  LObject := TPcCache.Create(TPcMemoryCacheStore.Create(10), NewName);
  LCache := LObject;
  LHost := TLoaderHost.Create(True);
  try
    RunConcurrentLoad(LObject, LHost, LThreads);
    try
      TAssert.AssertEquals('the loader ran once', 1, LHost.Calls);
      for I := 0 to THREADS - 1 do
      begin
        TAssert.AssertEquals('no error', '', LThreads[I].ErrorClass);
        TAssert.AssertEquals('loaded:x', LThreads[I].Value);
      end;
      TAssert.AssertEquals(0, LObject.LoadsWaiting);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
  end;
end;

procedure TCacheTests.GetOrLoad_ZeroEntries_ConcurrentMissesStillLoadOnce;
var
  LName: string;
  LObject: TPcCache;
  LCache: IPcCache;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  I: Integer;
begin
  LName := NewName;
  LObject := TPcCache.Create(TPcMemoryCacheStore.Create(0), LName);
  LCache := LObject;
  LHost := TLoaderHost.Create(True);
  try
    RunConcurrentLoad(LObject, LHost, LThreads);
    try
      TAssert.AssertEquals('the loader ran once', 1, LHost.Calls);
      for I := 0 to THREADS - 1 do
        TAssert.AssertEquals('loaded:x', LThreads[I].Value);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
  end;
  TAssert.AssertEquals('every read missed', THREADS,
    Metric('pc.cache.misses', '{miss}', LName), 0);
end;

procedure TCacheTests.GetOrLoad_LoaderRaises_EveryThreadGetsItAndNothingIsStored;
var
  LObject: TPcCache;
  LCache: IPcCache;
  LHost: TLoaderHost;
  LThreads: TThreadArray;
  LOriginal, LWaiters, I: Integer;
  LValue: string;
begin
  LObject := TPcCache.Create(TPcMemoryCacheStore.Create(10), NewName);
  LCache := LObject;
  LHost := TLoaderHost.Create(True);
  try
    LHost.RaiseIt := True;
    RunConcurrentLoad(LObject, LHost, LThreads);
    try
      TAssert.AssertEquals('the loader ran once', 1, LHost.Calls);
      LOriginal := 0;
      LWaiters := 0;
      for I := 0 to THREADS - 1 do
      begin
        TAssert.AssertEquals('loader failed (test)', LThreads[I].ErrorMessage);
        if LThreads[I].ErrorClass = 'EConvertError' then
          Inc(LOriginal)
        else if (LThreads[I].ErrorClass = 'EPcCacheLoadError')
          and (LThreads[I].ErrorOriginalClass = 'EConvertError') then
          Inc(LWaiters);
      end;
      TAssert.AssertEquals('the loading thread gets the original', 1, LOriginal);
      TAssert.AssertEquals('each waiting thread gets EPcCacheLoadError', THREADS - 1, LWaiters);
    finally
      FreeThreads(LThreads);
    end;
  finally
    LHost.Free;
  end;
  TAssert.AssertFalse('nothing is stored', LCache.TryGet(LCache.Key('k', []), LValue));
end;

procedure TCacheTests.Failure_ReadIsAMissAndPutIsIgnored;
var
  LName: string;
  LStore: TSwitchableStore;
  LLog: TErrorLog;
  LCache: IPcCache;
  LValue: string;
begin
  LName := NewName;
  LStore := TSwitchableStore.Create;
  LLog := TErrorLog.Create;
  try
    LCache := TPcCache.Create(LStore, LName, LLog.OnError, 0);
    LCache.Put(LCache.Key('k', []), 'v', 60);
    LStore.Mode := smUnavailable;
    TAssert.AssertFalse(LCache.TryGet(LCache.Key('k', []), LValue));
    TAssert.AssertEquals('', LValue);
    LCache.Put(LCache.Key('k', []), 'w', 60);
    TAssert.AssertEquals('both failures reported', 2, LLog.Count);
    TAssert.AssertEquals(LName, LLog.LastCache);
    TAssert.AssertEquals('store down (test)', LLog.LastMessage);
    TAssert.AssertEquals(2, Metric('pc.cache.store_errors', '{error}', LName), 0);
    LStore.Mode := smOk;
    TAssert.AssertTrue(LCache.TryGet(LCache.Key('k', []), LValue));
    TAssert.AssertEquals('the failed Put changed nothing', 'v', LValue);
    LCache := nil;
  finally
    LLog.Free;
  end;
end;

procedure TCacheTests.Failure_SkipsTheStoreForAWhileThenRetries;
var
  LStore: TSwitchableStore;
  LStoreRef: IPcCacheStore;
  LLog: TErrorLog;
  LCache: IPcCache;
  LValue: string;
  LCalls: Integer;
begin
  LStore := TSwitchableStore.Create;
  LStoreRef := LStore;
  LLog := TErrorLog.Create;
  try
    LCache := TPcCache.Create(LStoreRef, NewName, LLog.OnError, 1000);
    LStore.Mode := smUnavailable;
    LCache.TryGet(LCache.Key('k', []), LValue);
    LCalls := LStore.Calls;
    GTicker.Ms := GTicker.Ms + 999;
    TAssert.AssertFalse(LCache.TryGet(LCache.Key('k', []), LValue));
    LCache.Put(LCache.Key('k', []), 'v', 60);
    TAssert.AssertEquals('Key with tags is empty in the pause', '', LCache.Key('k', ['t']));
    TAssert.AssertEquals('the store is skipped for 1 s', LCalls, LStore.Calls);
    TAssert.AssertEquals(1, LLog.Count);
    GTicker.Ms := GTicker.Ms + 1;
    LStore.Mode := smOk;
    LCache.Put(LCache.Key('k', []), 'v', 60);
    TAssert.AssertTrue('tried again after 1 s', LCache.TryGet(LCache.Key('k', []), LValue));
    TAssert.AssertEquals('v', LValue);
    LCache := nil;
  finally
    LLog.Free;
  end;
end;

procedure TCacheTests.Failure_KeyIsEmptyAndGetOrLoadStillLoads;
var
  LStore: TSwitchableStore;
  LStoreRef: IPcCacheStore;
  LCache: IPcCache;
  LHost: TLoaderHost;
  LKey: string;
  LValue: string;
begin
