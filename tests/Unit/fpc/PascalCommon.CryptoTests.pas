procedure TCryptoTests.Pbkdf2Sha512_SameAsTheDefinitionOnHmac;
var
  LLength, LSalt, LKey: Integer;
begin
  for LKey := 0 to 3 do
    for LSalt := 0 to 3 do
      for LLength := 1 to 3 do
        TAssert.AssertTrue(Format('key %d, salt %d, length %d', [LKey * 65, LSalt * 81, LLength * 47]),
          PcSameBytes(Pbkdf2Sha512ByDefinition(Sequence(LKey * 65), Sequence(LSalt * 81), 5, LLength * 47),
            PcPbkdf2HmacSha512(Sequence(LKey * 65), Sequence(LSalt * 81), 5, LLength * 47)));
