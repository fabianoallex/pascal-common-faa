procedure TCryptoTests.Pbkdf2_SameAsTheDefinitionOnHmac;
var
  LLength, LSalt, LKey: Integer;
begin
  for LKey := 0 to 3 do
    for LSalt := 0 to 3 do
      for LLength := 1 to 3 do
        TAssert.AssertTrue(Format('key %d, salt %d, length %d', [LKey * 33, LSalt * 41, LLength * 23]),
          PcSameBytes(Pbkdf2ByDefinition(Sequence(LKey * 33), Sequence(LSalt * 41), 5, LLength * 23),
            PcPbkdf2HmacSha256(Sequence(LKey * 33), Sequence(LSalt * 41), 5, LLength * 23)));
end;

procedure TCryptoTests.Pbkdf2_RejectsBadArguments;
begin
  TAssert.AssertEquals('EArgumentException', Pbkdf2Raises(0, 32));
  TAssert.AssertEquals('EArgumentException', Pbkdf2Raises(1, 0));
  TAssert.AssertEquals('', Pbkdf2Raises(1, 1));
end;

