procedure TCryptoTests.Sha512_AroundBlockBoundary;
begin
  // 111: the length fits after the 0x80; 112: it needs a second block; 128:
  // a whole block, then the padding alone.
  TAssert.AssertEquals('111', 'fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2',
    Sha512Hex(Repeated(Ord('a'), 111)));
  TAssert.AssertEquals('112', 'c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca',
    Sha512Hex(Repeated(Ord('a'), 112)));
  TAssert.AssertEquals('127', '828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502',
    Sha512Hex(Repeated(Ord('a'), 127)));
  TAssert.AssertEquals('128', 'b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321',
    Sha512Hex(Repeated(Ord('a'), 128)));
  TAssert.AssertEquals('129', '4f681e0bd53cda4b5a2041cc8a06f2eabde44fb16c951fbd5b87702f07aeab611565b19c47fde30587177ebb852e3971bbd8d3fd30da18d71037dfbd98420429',
    Sha512Hex(Repeated(Ord('a'), 129)));
  TAssert.AssertEquals('239', '52c853cb8d907f3d4d6b889beb027985d7c273486d75f8baf26f80d24e90c74c6c3de3e22131582380a7d14d43f2941a31385439cd6ddc469f628015e50bf286',
    Sha512Hex(Repeated(Ord('a'), 239)));
  TAssert.AssertEquals('240', '4c296d90c61052a62ffb1dd196f1b7b09373b1f93e71836baebf89690546b7595684dbe9467a8e484fa0d1094272b4344a7c24f5fee8daedeb0bf549c985ab5f',
    Sha512Hex(Repeated(Ord('a'), 240)));
end;

