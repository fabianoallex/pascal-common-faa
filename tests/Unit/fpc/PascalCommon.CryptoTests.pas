procedure TCryptoTests.Pbkdf2Sha512_SaltsAroundTheBlock;
begin
  // Salt plus the 4 bytes of the block index: 112 (the padding needs a
  // second block), 127, 128 (a whole block, then the padding alone), 256.
  TAssert.AssertEquals('108', '4fd129502b2cd60a85a6f3fde422d03e357757d1822587191bb3889afe390948' +
    '9a6ac330be410e1b8e147e464a775c8da1045b3ea50dab2c0d864fc1b80e37d6',
    Pbkdf2Sha512Hex(Utf8('password'), Sequence(108), 3, 64));
  TAssert.AssertEquals('123', '75f27a872b3c1269294944b947653caab45e5cdfbbdf8c98777131c91681e639' +
    'fdd2acb49eff87fc2dfd5506823810d00a1ab1550d74fe6214bbd67e9e742554',
    Pbkdf2Sha512Hex(Utf8('password'), Sequence(123), 3, 64));
  TAssert.AssertEquals('124', '1378f28e3cf8974f5393dc37791c3608c6f3d521589e56a51aea0133c07234f2' +
    '2e78c98d4460c3568afee3507214854eb95c6657525879dc768df53f9f62de89',
    Pbkdf2Sha512Hex(Utf8('password'), Sequence(124), 3, 64));
  TAssert.AssertEquals('252', '8af032cce3dfefb49b20d0019fe7df7d383f6ffbece598136c0a23d8d8cb31cf' +
    'ecde921e2b89de6ffe686c4f912dde3b9e3da6a23e56954491d9ddf03325fc9c',
    Pbkdf2Sha512Hex(Utf8('password'), Sequence(252), 3, 64));
end;

