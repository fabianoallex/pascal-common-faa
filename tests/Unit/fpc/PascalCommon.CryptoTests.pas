procedure TCryptoTests.Sha256_Fips180Examples;
begin
  TAssert.AssertEquals('e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855',
    Sha256Hex(nil));
  TAssert.AssertEquals('ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad',
    Sha256Hex(Utf8('abc')));
  TAssert.AssertEquals('248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1',
    Sha256Hex(Utf8('abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq')));
end;

procedure TCryptoTests.Sha256_AroundBlockBoundary;
begin
  TAssert.AssertEquals('55', '9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318',
    Sha256Hex(Repeated(Ord('a'), 55)));
  TAssert.AssertEquals('56', 'b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a',
    Sha256Hex(Repeated(Ord('a'), 56)));
  TAssert.AssertEquals('63', '7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34',
    Sha256Hex(Repeated(Ord('a'), 63)));
  TAssert.AssertEquals('64', 'ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb',
    Sha256Hex(Repeated(Ord('a'), 64)));
  TAssert.AssertEquals('65', '635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0',
    Sha256Hex(Repeated(Ord('a'), 65)));
  TAssert.AssertEquals('119', '31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb',
    Sha256Hex(Repeated(Ord('a'), 119)));
  TAssert.AssertEquals('120', '2f3d335432c70b580af0e8e1b3674a7c020d683aa5f73aaaedfdc55af904c21c',
    Sha256Hex(Repeated(Ord('a'), 120)));
end;

procedure TCryptoTests.Sha256_OneMillionA;
begin
  TAssert.AssertEquals('cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0',
    Sha256Hex(Repeated(Ord('a'), 1000000)));
end;

procedure TCryptoTests.Sha256_NonAsciiHashesUtf8;
begin
  TAssert.AssertEquals('99c3d6caccd648574aa0f41f7ae30f7529df276183e187d5db4262f292843b7f',
    Sha256Hex(Utf8('São Paulo → ok')));
end;

procedure TCryptoTests.Hmac_Rfc4231;
begin
  TAssert.AssertEquals('case 1', 'b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7',
    HmacHex(Repeated($0b, 20), Utf8('Hi There')));
  TAssert.AssertEquals('case 2', '5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843',
    HmacHex(Utf8('Jefe'), Utf8('what do ya want for nothing?')));
  TAssert.AssertEquals('case 3', '773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe',
    HmacHex(Repeated($aa, 20), Repeated($dd, 50)));
  TAssert.AssertEquals('case 6', '60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54',
    HmacHex(Repeated($aa, 131), Utf8('Test Using Larger Than Block-Size Key - Hash Key First')));
  TAssert.AssertEquals('case 7', '9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2',
    HmacHex(Repeated($aa, 131), Utf8('This is a test using a larger than block-size key and a ' +
      'larger than block-size data. The key needs to be hashed before being used by the HMAC ' +
      'algorithm.')));
end;

function Encode64(const S: string): string;
begin
  Result := PcBase64Encode(Utf8(S));
end;

function Decode64(const S: string): string;
var
  LBytes: TBytes;
begin
  if not PcBase64Decode(S, LBytes) then
    Exit('<invalid>');
  Result := PcUtf8BytesToString(LBytes, 'test');
end;

procedure TCryptoTests.Base64_Rfc4648;
begin
  TAssert.AssertEquals('', Encode64(''));
  TAssert.AssertEquals('Zg==', Encode64('f'));
  TAssert.AssertEquals('Zm8=', Encode64('fo'));
  TAssert.AssertEquals('Zm9v', Encode64('foo'));
  TAssert.AssertEquals('Zm9vYg==', Encode64('foob'));
  TAssert.AssertEquals('Zm9vYmE=', Encode64('fooba'));
  TAssert.AssertEquals('Zm9vYmFy', Encode64('foobar'));
  TAssert.AssertEquals('foobar', Decode64('Zm9vYmFy'));
  TAssert.AssertEquals('fooba', Decode64('Zm9vYmE='));
  TAssert.AssertEquals('foob', Decode64('Zm9vYg=='));
  TAssert.AssertEquals('f', Decode64('Zg=='));
  TAssert.AssertEquals('', Decode64(''));
  // UTF-8 text, as SMTP AUTH and MIME carry it.
  TAssert.AssertEquals('Q2Fmw6k=', Encode64('Café'));
  TAssert.AssertEquals('Café', Decode64('Q2Fmw6k='));
end;

procedure TCryptoTests.Base64_StandardAlphabet;
var
  LBytes: TBytes;
begin
  // FB FF BF is "-_-_" in Base64url.
  LBytes := nil;
  SetLength(LBytes, 3);
  LBytes[0] := $FB;
  LBytes[1] := $FF;
  LBytes[2] := $BF;
  TAssert.AssertEquals('+/+/', PcBase64Encode(LBytes));
  TAssert.AssertEquals('+/8=', PcBase64Encode(Copy(LBytes, 0, 2)));
  TAssert.AssertTrue(PcBase64Decode('+/+/', LBytes));
  TAssert.AssertEquals(3, Length(LBytes));
  TAssert.AssertEquals($BF, Integer(LBytes[2]));
end;

procedure TCryptoTests.Base64_RoundTripEveryLength;
var
  LLen, I: Integer;
  LData, LBack: TBytes;
  LText: string;
begin
  for LLen := 0 to 300 do
  begin
    LData := nil;
    SetLength(LData, LLen);
    for I := 0 to LLen - 1 do
      LData[I] := Byte((I * 37 + LLen) and $FF);
    LText := PcBase64Encode(LData);
    TAssert.AssertEquals('length of ' + IntToStr(LLen), ((LLen + 2) div 3) * 4, Length(LText));
    TAssert.AssertTrue('decodes ' + IntToStr(LLen), PcBase64Decode(LText, LBack));
    TAssert.AssertTrue('same bytes ' + IntToStr(LLen), PcSameBytes(LData, LBack));
  end;
end;

procedure TCryptoTests.Base64_DecodeWithoutPadding;
begin
  TAssert.AssertEquals('f', Decode64('Zg'));
  TAssert.AssertEquals('fo', Decode64('Zm8'));
  TAssert.AssertEquals('fooba', Decode64('Zm9vYmE'));
end;

procedure TCryptoTests.Base64_DecodeSkipsLineBreaksAndBlanks;
begin
  TAssert.AssertEquals('foobar', Decode64('Zm9v'#13#10'YmFy'#13#10));
  TAssert.AssertEquals('fooba', Decode64(' Zm9v'#9'YmE='#10));
  TAssert.AssertEquals('foob', Decode64('Zm9vYg='#13#10'='));
end;

procedure TCryptoTests.Base64_DecodeRejectsInvalid;
var
  LBytes: TBytes;
begin
  TAssert.AssertFalse('url alphabet', PcBase64Decode('-_-_', LBytes));
  TAssert.AssertTrue('nil after failure', LBytes = nil);
  TAssert.AssertFalse('4n+1 characters', PcBase64Decode('Zm9vY', LBytes));
  TAssert.AssertFalse('character after padding', PcBase64Decode('Zg==Zg==', LBytes));
  TAssert.AssertFalse('letter after one =', PcBase64Decode('Zg=a', LBytes));
  TAssert.AssertFalse('short padding', PcBase64Decode('Zg=', LBytes));
  TAssert.AssertFalse('too much padding', PcBase64Decode('Zm9v====', LBytes));
  TAssert.AssertFalse('padding alone', PcBase64Decode('=', LBytes));
  TAssert.AssertFalse('other character', PcBase64Decode('Zm9v*mFy', LBytes));
end;

procedure TCryptoTests.Base64Url_Rfc4648;
begin
  TAssert.AssertEquals('', Encode(''));
  TAssert.AssertEquals('Zg', Encode('f'));
  TAssert.AssertEquals('Zm8', Encode('fo'));
  TAssert.AssertEquals('Zm9v', Encode('foo'));
  TAssert.AssertEquals('Zm9vYg', Encode('foob'));
  TAssert.AssertEquals('Zm9vYmE', Encode('fooba'));
  TAssert.AssertEquals('Zm9vYmFy', Encode('foobar'));
end;

procedure TCryptoTests.Base64Url_UrlAlphabet;
var
  LBytes: TBytes;
begin
  // FB FF BF is "+/+/" in standard Base64.
  LBytes := nil;
  SetLength(LBytes, 3);
  LBytes[0] := $FB;
  LBytes[1] := $FF;
  LBytes[2] := $BF;
  TAssert.AssertEquals('-_-_', PcBase64UrlEncode(LBytes));
  TAssert.AssertEquals('-_8', PcBase64UrlEncode(Copy(LBytes, 0, 2)));
end;

procedure TCryptoTests.Base64Url_DecodeRoundTrip;
var
  LBytes: TBytes;
  I: Integer;
begin
  for I := 0 to 6 do
  begin
    TAssert.AssertTrue(PcBase64UrlDecode(Encode(Copy('foobar', 1, I)), LBytes));
    TAssert.AssertEquals(Copy('foobar', 1, I), Utf8Text(LBytes));
  end;
  TAssert.AssertTrue('padding accepted', PcBase64UrlDecode('Zg==', LBytes));
  TAssert.AssertEquals('f', Utf8Text(LBytes));
end;

procedure TCryptoTests.Base64Url_DecodeRejectsInvalid;
var
  LBytes: TBytes;
begin
  TAssert.AssertFalse('standard alphabet', PcBase64UrlDecode('ab+/', LBytes));
  TAssert.AssertFalse('space', PcBase64UrlDecode('Zm 9v', LBytes));
  TAssert.AssertFalse('4n+1 characters', PcBase64UrlDecode('Zm9vY', LBytes));
end;

procedure TCryptoTests.Base64Url_StrictReadsTheEncodersText;
var
  LBytes: TBytes;
  I: Integer;
begin
  for I := 0 to 6 do
  begin
    TAssert.AssertTrue(PcBase64UrlDecodeStrict(Encode(Copy('foobar', 1, I)), LBytes));
    TAssert.AssertEquals(Copy('foobar', 1, I), Utf8Text(LBytes));
  end;
  // 32 bytes, as an HMAC-SHA256: 43 characters. (Not LBytes on both sides
  // of one call: FPC clears an out argument before it reads the others.)
  TAssert.AssertTrue('a digest', PcBase64UrlDecodeStrict(
    PcBase64UrlEncode(PcDigestToBytes(PcSha256(Utf8('abc')))), LBytes));
  TAssert.AssertTrue('a digest: its bytes', PcSameBytes(LBytes,
    PcDigestToBytes(PcSha256(Utf8('abc')))));
end;

procedure TCryptoTests.Base64Url_StrictRefusesOtherSpellings;
var
  LBytes: TBytes;
  LText: string;
begin
  // "Zg" is "f"; "Zh" differs only in the 4 bits after the byte, which the
  // lenient decoder drops.
  TAssert.AssertTrue('lenient: Zh', PcBase64UrlDecode('Zh', LBytes));
  TAssert.AssertEquals('lenient: Zh is f', 'f', Utf8Text(LBytes));
  TAssert.AssertFalse('strict: Zh', PcBase64UrlDecodeStrict('Zh', LBytes));
  TAssert.AssertTrue('strict: nil after a refusal', LBytes = nil);
  // "Zm8" is "fo"; "Zm9" differs only in the 2 bits after the bytes.
  TAssert.AssertTrue('lenient: Zm9', PcBase64UrlDecode('Zm9', LBytes));
  TAssert.AssertEquals('lenient: Zm9 is fo', 'fo', Utf8Text(LBytes));
  TAssert.AssertFalse('strict: Zm9', PcBase64UrlDecodeStrict('Zm9', LBytes));
  TAssert.AssertTrue('strict: Zm8', PcBase64UrlDecodeStrict('Zm8', LBytes));
  TAssert.AssertFalse('strict: padding', PcBase64UrlDecodeStrict('Zg==', LBytes));
  TAssert.AssertFalse('strict: standard alphabet', PcBase64UrlDecodeStrict('ab+/', LBytes));
  TAssert.AssertFalse('strict: 4n+1 characters', PcBase64UrlDecodeStrict('Zm9vY', LBytes));
  // A digest's last character carries 4 bits (SHA-256 of "abc" ends in
  // "Fa0"): the next character of the alphabet decodes to the same bytes.
  LText := PcBase64UrlEncode(PcDigestToBytes(PcSha256(Utf8('abc'))));
  TAssert.AssertTrue('lenient: the last character + 1',
    PcBase64UrlDecode(Copy(LText, 1, 42) + NextBase64UrlChar(LText[43]), LBytes));
  TAssert.AssertTrue('lenient: the same bytes',
    PcSameBytes(LBytes, PcDigestToBytes(PcSha256(Utf8('abc')))));
  TAssert.AssertFalse('strict: the last character + 1',
    PcBase64UrlDecodeStrict(Copy(LText, 1, 42) + NextBase64UrlChar(LText[43]), LBytes));
end;

procedure TCryptoTests.SameBytes;
begin
  TAssert.AssertTrue(PcSameBytes(Utf8('abc'), Utf8('abc')));
  TAssert.AssertFalse(PcSameBytes(Utf8('abc'), Utf8('abd')));
  TAssert.AssertFalse(PcSameBytes(Utf8('abc'), Utf8('abcd')));
  TAssert.AssertTrue(PcSameBytes(nil, nil));
end;

procedure TCryptoTests.Pbkdf2_Rfc7914;
begin
