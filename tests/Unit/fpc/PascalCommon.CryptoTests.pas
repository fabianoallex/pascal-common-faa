function NextBase64UrlChar(AChar: Char): Char;
const
  ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
begin
  Result := ALPHABET[Pos(AChar, ALPHABET) + 1];
end;

