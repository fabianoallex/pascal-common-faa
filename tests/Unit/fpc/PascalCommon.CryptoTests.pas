end;

function Sequence(ACount: Integer): TBytes;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, ACount);
  for I := 0 to ACount - 1 do
    Result[I] := Byte(I);
end;

function Pbkdf2Hex(const APassword, ASalt: TBytes; AIterations, ALength: Integer): string;
begin
  Result := PcBytesToHex(PcPbkdf2HmacSha256(APassword, ASalt, AIterations, ALength));
end;

// RFC 8018's definition written on PcHmacSha256, the slow way: what the
// precomputed states must give.
function Pbkdf2ByDefinition(const APassword, ASalt: TBytes; AIterations, ALength: Integer): TBytes;
var
  LBlock: TBytes;
  LU, LT: TPcSha256Digest;
  LIndex, LDone, LCount, I, J: Integer;
begin
  Result := nil;
  SetLength(Result, ALength);
  LDone := 0;
  LIndex := 0;
  while LDone < ALength do
  begin
    Inc(LIndex);
    LBlock := Copy(ASalt, 0, Length(ASalt));
    SetLength(LBlock, Length(ASalt) + 4);
    LBlock[Length(ASalt)] := 0;
    LBlock[Length(ASalt) + 1] := 0;
    LBlock[Length(ASalt) + 2] := 0;
    LBlock[Length(ASalt) + 3] := Byte(LIndex);
    LU := PcHmacSha256(APassword, LBlock);
    LT := LU;
    for I := 2 to AIterations do
    begin
      LU := PcHmacSha256(APassword, PcDigestToBytes(LU));
      for J := 0 to 31 do
        LT[J] := LT[J] xor LU[J];
    end;
    LCount := ALength - LDone;
    if LCount > 32 then
      LCount := 32;
    Move(LT[0], Result[LDone], LCount);
    Inc(LDone, LCount);
  end;
end;

// The exception class name, or '' (no closures on FPC).
function Pbkdf2Raises(AIterations, ALength: Integer): string;
begin
  Result := '';
  try
    PcPbkdf2HmacSha256(Utf8('p'), Utf8('s'), AIterations, ALength);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

function Join(const A, B: TBytes): TBytes;
begin
  Result := nil;
  SetLength(Result, Length(A) + Length(B));
  if Length(A) > 0 then
    Move(A[0], Result[0], Length(A));
  if Length(B) > 0 then
    Move(B[0], Result[Length(A)], Length(B));
end;

function Sha512Hex(const ABytes: TBytes): string;
begin
  Result := PcBytesToHex(PcSha512DigestToBytes(PcSha512(ABytes)));
end;

function HmacSha512Hex(const AKey, AData: TBytes): string;
begin
  Result := PcBytesToHex(PcSha512DigestToBytes(PcHmacSha512(AKey, AData)));
end;

function Pbkdf2Sha512Hex(const APassword, ASalt: TBytes; AIterations, ALength: Integer): string;
begin
  Result := PcBytesToHex(PcPbkdf2HmacSha512(APassword, ASalt, AIterations, ALength));
end;

// RFC 2104 written on PcSha512, the slow way: H(K xor opad || H(K xor ipad
// || data)). What the precomputed states must give.
function HmacSha512ByDefinition(const AKey, AData: TBytes): TBytes;
var
  LKey, LInner, LOuter: TBytes;
  I: Integer;
begin
  if Length(AKey) > 128 then
    LKey := PcSha512DigestToBytes(PcSha512(AKey))
  else
    LKey := Copy(AKey, 0, Length(AKey));
  SetLength(LKey, 128);
  LInner := nil;
  SetLength(LInner, 128);
  LOuter := nil;
  SetLength(LOuter, 128);
  for I := 0 to 127 do
  begin
    LInner[I] := LKey[I] xor $36;
    LOuter[I] := LKey[I] xor $5c;
  end;
  Result := PcSha512DigestToBytes(PcSha512(Join(LOuter,
    PcSha512DigestToBytes(PcSha512(Join(LInner, AData))))));
end;

// RFC 8018's definition written on PcHmacSha512, the slow way.
function Pbkdf2Sha512ByDefinition(const APassword, ASalt: TBytes;
  AIterations, ALength: Integer): TBytes;
var
  LBlock: TBytes;
  LU, LT: TPcSha512Digest;
  LIndex, LDone, LCount, I, J: Integer;
begin
  Result := nil;
  SetLength(Result, ALength);
  LDone := 0;
  LIndex := 0;
  while LDone < ALength do
  begin
    Inc(LIndex);
    LBlock := Copy(ASalt, 0, Length(ASalt));
    SetLength(LBlock, Length(ASalt) + 4);
    LBlock[Length(ASalt)] := 0;
    LBlock[Length(ASalt) + 1] := 0;
    LBlock[Length(ASalt) + 2] := 0;
    LBlock[Length(ASalt) + 3] := Byte(LIndex);
    LU := PcHmacSha512(APassword, LBlock);
    LT := LU;
    for I := 2 to AIterations do
    begin
      LU := PcHmacSha512(APassword, PcSha512DigestToBytes(LU));
      for J := 0 to 63 do
        LT[J] := LT[J] xor LU[J];
    end;
    LCount := ALength - LDone;
    if LCount > 64 then
      LCount := 64;
    Move(LT[0], Result[LDone], LCount);
    Inc(LDone, LCount);
  end;
end;

function Pbkdf2Sha512Raises(AIterations, ALength: Integer): string;
begin
  Result := '';
  try
    PcPbkdf2HmacSha512(Utf8('p'), Utf8('s'), AIterations, ALength);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

