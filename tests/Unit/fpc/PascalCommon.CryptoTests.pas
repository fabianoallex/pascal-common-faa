procedure TCryptoTests.Pbkdf2Sha512_Rfc6070LongAndNulInputs;
begin
  TAssert.AssertEquals('long', '8c0511f4c6e597c6ac6315d8f0362e225f3c501495ba23b868c005174dc4ee71' +
    '115b59f9e60cd9532fa33e0f75aefe30225c583a186cd82bd4daea9724a3d3b8',
    Pbkdf2Sha512Hex(Utf8('passwordPASSWORDpassword'), Utf8('saltSALTsaltSALTsaltSALTsaltSALTsalt'),
    4096, 64));
  // "pass\0word" and "sa\0lt": a NUL inside is data, not an end.
  TAssert.AssertEquals('nul', '9d9e9c4cd21fe4be24d5b8244c759665',
    Pbkdf2Sha512Hex(Join(Join(Utf8('pass'), Repeated(0, 1)), Utf8('word')),
    Join(Join(Utf8('sa'), Repeated(0, 1)), Utf8('lt')), 4096, 16));
end;

