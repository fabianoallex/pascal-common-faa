end;

procedure TCryptoTests.HmacSha512_SameAsTheDefinition;
var
  LKey, LData: Integer;
begin
  // Keys 0..200 and data 0..250 cross the 128-byte block and the padding's
  // 112-byte limit on both the key and the message side.
  for LKey := 0 to 8 do
    for LData := 0 to 10 do
      TAssert.AssertTrue(Format('key %d, data %d', [LKey * 25, LData * 25]),
        PcSameBytes(HmacSha512ByDefinition(Sequence(LKey * 25), Sequence(LData * 25)),
          PcSha512DigestToBytes(PcHmacSha512(Sequence(LKey * 25), Sequence(LData * 25)))));
end;

