procedure TCryptoTests.HmacSha512_Rfc4231;
begin
  TAssert.AssertEquals('case 1', '87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cde' +
    'daa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854',
    HmacSha512Hex(Repeated($0b, 20), Utf8('Hi There')));
  TAssert.AssertEquals('case 2', '164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea250554' +
    '9758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737',
    HmacSha512Hex(Utf8('Jefe'), Utf8('what do ya want for nothing?')));
  TAssert.AssertEquals('case 3', 'fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39' +
    'bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb',
    HmacSha512Hex(Repeated($aa, 20), Repeated($dd, 50)));
  TAssert.AssertEquals('case 4', 'b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3db' +
    'a91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd',
    HmacSha512Hex(Copy(Sequence(26), 1, 25), Repeated($cd, 50))); // 01..19
  TAssert.AssertEquals('case 6', '80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f352' +
    '6b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598',
    HmacSha512Hex(Repeated($aa, 131), Utf8('Test Using Larger Than Block-Size Key - Hash Key First')));
  TAssert.AssertEquals('case 7', 'e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944' +
    'b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58',
    HmacSha512Hex(Repeated($aa, 131), Utf8('This is a test using a larger than block-size key and a ' +
      'larger than block-size data. The key needs to be hashed before being used by the HMAC ' +
      'algorithm.')));
end;

procedure TCryptoTests.HmacSha512_KeysAroundTheBlock;
begin
  // 128 bytes: padded, not hashed; 129: hashed first.
  TAssert.AssertEquals('128', 'a23f6de776df36fc508c00ffdb962b1b30642e5c7e56ca255a60e5ddaeefdab3' +
    '565b361e002eac24508ff01f2fc8a16af43b1a2705a802688e3409d954f4d84c',
