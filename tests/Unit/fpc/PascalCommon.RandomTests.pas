unit PascalCommon.RandomTests;

{$mode delphi}{$H+}

{ GENERATED FILE — produced by tools/gen_fpc_mirror.py from
  tests/Unit/PascalCommon.RandomTests.pas (DUnitX). Do not edit by hand: edit the DUnitX
  master and run the script again. }

{ Tests for PascalCommon.Random: the requested length (0, 1, odd, large),
  bytes past the requested count left untouched, no repeats, every byte
  value present in a large sample (a source stuck on a few values would
  fail), a negative count refused, and several threads at once.

  The threaded test waits on TThread.WaitFor, not on a Sleep: on POSIX the
  threads share one /dev/urandom descriptor, which is what it exercises.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  fpcunit, testregistry,
  Classes,
  SysUtils,
  PascalCommon.Random;

type
  TRandomTests = class(TTestCase)
  published
    procedure RandomBytes_Lengths;
    procedure FillRandom_StaysInsideTheCount;
    procedure RandomBytes_DoNotRepeat;
    procedure RandomBytes_EveryByteValueAppears;
    procedure NegativeCount_Refused;
    procedure RandomBytes_FromSeveralThreads;
  end;

implementation

const
  THREAD_COUNT = 8;
  CALLS_PER_THREAD = 500;

type
  TRandomThread = class(TThread)
  protected
    procedure Execute; override;
  public
    Keys: TStringList;
    Error: string;
    constructor Create;
    destructor Destroy; override;
  end;

function Hex(const ABytes: TBytes): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ABytes) do
    Result := Result + IntToHex(ABytes[I], 2);
end;

// The exception a call raised, as its class name, or ''.
function RandomBytesError(ACount: Integer): string;
begin
  Result := '';
  try
    PcRandomBytes(ACount);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

function FillRandomError(ACount: Integer): string;
var
  LByte: Byte;
begin
  Result := '';
  LByte := 0;
  try
    PcFillRandom(LByte, ACount);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

{ TRandomThread }

constructor TRandomThread.Create;
begin
  Keys := TStringList.Create;
  inherited Create(False);
end;

destructor TRandomThread.Destroy;
begin
  Keys.Free;
  inherited Destroy;
end;

procedure TRandomThread.Execute;
var
  I: Integer;
begin
  try
    for I := 1 to CALLS_PER_THREAD do
      Keys.Add(Hex(PcRandomBytes(32)));
  except
    on E: Exception do
      Error := E.ClassName + ': ' + E.Message;
  end;
end;

{ TRandomTests }

procedure TRandomTests.RandomBytes_Lengths;
begin
  TAssert.AssertEquals('0', 0, Length(PcRandomBytes(0)));
  TAssert.AssertEquals('1', 1, Length(PcRandomBytes(1)));
  TAssert.AssertEquals('33', 33, Length(PcRandomBytes(33)));
  TAssert.AssertEquals('1 MiB', 1024 * 1024, Length(PcRandomBytes(1024 * 1024)));
end;

procedure TRandomTests.FillRandom_StaysInsideTheCount;
var
  LBuffer: array[0..63] of Byte;
  I, LTries: Integer;
  LChanged: Boolean;
begin
  // 0 bytes: nothing written.
  FillChar(LBuffer, SizeOf(LBuffer), $A5);
  PcFillRandom(LBuffer, 0);
  for I := 0 to High(LBuffer) do
    TAssert.AssertEquals('count 0, byte ' + IntToStr(I), $A5, LBuffer[I]);
  // 16 bytes: the other 48 keep the canary; the 16 change (all 16 equal to
  // the canary again has a chance of 2^-128, retried a few times anyway).
  LTries := 0;
  repeat
    FillChar(LBuffer, SizeOf(LBuffer), $A5);
    PcFillRandom(LBuffer, 16);
    for I := 16 to High(LBuffer) do
      TAssert.AssertEquals('past the count, byte ' + IntToStr(I), $A5, LBuffer[I]);
    LChanged := False;
    for I := 0 to 15 do
      if LBuffer[I] <> $A5 then
        LChanged := True;
    Inc(LTries);
  until LChanged or (LTries = 3);
  TAssert.AssertTrue('the first 16 bytes were written', LChanged);
end;

procedure TRandomTests.RandomBytes_DoNotRepeat;
var
  LKeys: TStringList;
  I: Integer;
begin
  LKeys := TStringList.Create;
  try
    LKeys.Sorted := True;
    LKeys.Duplicates := dupIgnore;
    for I := 1 to 2000 do
      LKeys.Add(Hex(PcRandomBytes(16)));
    TAssert.AssertEquals(2000, LKeys.Count);
  finally
    LKeys.Free;
  end;
end;

procedure TRandomTests.RandomBytes_EveryByteValueAppears;
var
  LBytes: TBytes;
  LSeen: array[0..255] of Boolean;
  I, LMissing: Integer;
begin
  // 64 KiB: the chance that a uniform source misses one of the 256 values is
  // about 256 * (255/256)^65536, below 10^-100.
  LBytes := PcRandomBytes(65536);
  FillChar(LSeen, SizeOf(LSeen), 0);
  for I := 0 to High(LBytes) do
    LSeen[LBytes[I]] := True;
  LMissing := 0;
  for I := 0 to 255 do
    if not LSeen[I] then
      Inc(LMissing);
  TAssert.AssertEquals('byte values never seen', 0, LMissing);
end;

procedure TRandomTests.NegativeCount_Refused;
begin
  TAssert.AssertEquals('EArgumentException', RandomBytesError(-1));
  TAssert.AssertEquals('EArgumentException', FillRandomError(-1));
  TAssert.AssertEquals('', FillRandomError(1));
end;

procedure TRandomTests.RandomBytes_FromSeveralThreads;
var
  LThreads: array[0..THREAD_COUNT - 1] of TRandomThread;
  LAll: TStringList;
  I, J: Integer;
begin
  for I := 0 to THREAD_COUNT - 1 do
    LThreads[I] := nil;
  LAll := TStringList.Create;
  try
    for I := 0 to THREAD_COUNT - 1 do
      LThreads[I] := TRandomThread.Create;
    for I := 0 to THREAD_COUNT - 1 do
      LThreads[I].WaitFor;
    LAll.Sorted := True;
    LAll.Duplicates := dupIgnore;
    for I := 0 to THREAD_COUNT - 1 do
    begin
      TAssert.AssertEquals('thread ' + IntToStr(I), '', LThreads[I].Error);
      for J := 0 to LThreads[I].Keys.Count - 1 do
        LAll.Add(LThreads[I].Keys[J]);
    end;
    TAssert.AssertEquals(THREAD_COUNT * CALLS_PER_THREAD, LAll.Count);
  finally
    for I := 0 to THREAD_COUNT - 1 do
      LThreads[I].Free;
    LAll.Free;
  end;
end;

initialization
  RegisterTest(TRandomTests);

end.
