procedure TMetricsTests.Histogram_BoundsAreInclusive;
var
  LRegistry: TPcMetricRegistry;
  LHistogram: TPcHistogram;
  LPoints: TPcMetricPoints;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LHistogram := LRegistry.Histogram('h', '', '', [], [1, 2, 5]);
    LHistogram.Observe(0.5);
    LHistogram.Observe(1);
    LHistogram.Observe(1.5);
    LHistogram.Observe(5);
    LHistogram.Observe(7);
    LHistogram.Observe(NaN);
    LPoints := LHistogram.Snapshot;
    TAssert.AssertEquals(1, Length(LPoints));
    TAssert.AssertEquals(4, Length(LPoints[0].BucketCounts));
    TAssert.AssertEquals('<= 1', 2, Integer(LPoints[0].BucketCounts[0]));
    TAssert.AssertEquals('<= 2', 1, Integer(LPoints[0].BucketCounts[1]));
    TAssert.AssertEquals('<= 5', 1, Integer(LPoints[0].BucketCounts[2]));
    TAssert.AssertEquals('> 5', 1, Integer(LPoints[0].BucketCounts[3]));
    TAssert.AssertEquals('count', 5, Integer(LPoints[0].Count));
    TAssert.AssertEquals('sum', 15, LPoints[0].Sum, 0);
    TAssert.AssertEquals(5, Integer(LHistogram.Labels([]).Count));
    TAssert.AssertEquals(15, LHistogram.Labels([]).Sum, 0);
  finally
    LRegistry.Free;
  end;
end;

