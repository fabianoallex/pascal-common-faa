procedure TMetricsTests.Snapshot_InCreationOrder;
var
  LRegistry: TPcMetricRegistry;
  LGauge: TPcGauge;
  LPoints: TPcMetricPoints;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LGauge := LRegistry.Gauge('g', '', '', ['k']);
    LGauge.Labels(['b']).SetValue(2);
    LGauge.Labels(['a']).SetValue(1);
    LPoints := LGauge.Snapshot;
