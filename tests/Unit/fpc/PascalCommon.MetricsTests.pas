procedure TMetricsTests.Registry_OtherDefinition_Raises;
var
  LRegistry: TPcMetricRegistry;

  procedure ExpectRaise(const AWhat: string; AStep: Integer);
  begin
    try
      case AStep of
        0: LRegistry.Gauge('c', 's', '', ['a']);
        1: LRegistry.Counter('c', 'ms', '', ['a']);
        2: LRegistry.Counter('c', 's', '', ['b']);
        3: LRegistry.Counter('c', 's', '', ['a', 'b']);
        4: LRegistry.Histogram('h', 's', '', [], [1, 3]);
        5: LRegistry.Histogram('h', 's', '', [], [1]);
      end;
      TAssert.Fail(AWhat);
    except
      on EPcMetrics do ;
    end;
  end;

begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LRegistry.Counter('c', 's', '', ['a']);
    LRegistry.Histogram('h', 's', '', [], [1, 2]);
    ExpectRaise('another kind', 0);
    ExpectRaise('another unit', 1);
    ExpectRaise('another label', 2);
    ExpectRaise('more labels', 3);
    ExpectRaise('other bounds', 4);
    ExpectRaise('fewer bounds', 5);
    TAssert.AssertEquals(2, Length(LRegistry.Metrics));
  finally
    LRegistry.Free;
  end;
end;

procedure TMetricsTests.Registry_InvalidDefinitions_Raise;
var
  LRegistry: TPcMetricRegistry;

  procedure ExpectRaise(const AWhat: string; AStep: Integer);
  begin
    try
      case AStep of
        0: LRegistry.Counter('', '', '', []);
        1: LRegistry.Counter('1abc', '', '', []);
        2: LRegistry.Counter('a b', '', '', []);
        3: LRegistry.Counter(StringOfChar('a', 256), '', '', []);
        4: LRegistry.Counter('c', 'a b', '', []);
        5: LRegistry.Counter('c', '', '', ['']);
        6: LRegistry.Counter('c', '', '', ['1a']);
        7: LRegistry.Counter('c', '', '', ['__a']);
        8: LRegistry.Counter('c', '', '', ['a-b']);
        9: LRegistry.Counter('c', '', '', ['a', 'a']);
        10: LRegistry.Histogram('h', '', '', ['le'], []);
        11: LRegistry.Histogram('h', '', '', [], [2, 1]);
        12: LRegistry.Histogram('h', '', '', [], [1, 1]);
        13: LRegistry.Histogram('h', '', '', [], [1, Infinity]);
        14: LRegistry.Histogram('h', '', '', [], [NaN]);
      end;
      TAssert.Fail(AWhat);
    except
      on EPcMetrics do ;
    end;
  end;

begin
  LRegistry := TPcMetricRegistry.Create;
  try
    ExpectRaise('empty name', 0);
    ExpectRaise('name starting with a digit', 1);
    ExpectRaise('space in the name', 2);
    ExpectRaise('name of 256 characters', 3);
    ExpectRaise('space in the unit', 4);
    ExpectRaise('empty label', 5);
    ExpectRaise('label starting with a digit', 6);
    ExpectRaise('label starting with __', 7);
    ExpectRaise('dash in a label', 8);
    ExpectRaise('duplicate label', 9);
    ExpectRaise('histogram label le', 10);
    ExpectRaise('decreasing bounds', 11);
    ExpectRaise('repeated bound', 12);
    ExpectRaise('infinite bound', 13);
    ExpectRaise('NaN bound', 14);
    TAssert.AssertEquals('nothing registered', 0, Length(LRegistry.Metrics));
    LRegistry.Counter('a.b-c/d_e', '{request}/s', '', ['_x', 'y.z']);
    LRegistry.Counter(StringOfChar('a', 255), '', '', []);
  finally
    LRegistry.Free;
  end;
end;

procedure TMetricsTests.Registry_Metrics_InRegistrationOrder;
var
  LRegistry: TPcMetricRegistry;
  LMetrics: TPcMetricList;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LRegistry.Gauge('z', '', '', []);
    LRegistry.Counter('a', '', '', []);
    LRegistry.Gauge('z', '', '', []);
    LMetrics := LRegistry.Metrics;
    TAssert.AssertEquals(2, Length(LMetrics));
    TAssert.AssertEquals('z', LMetrics[0].Name);
    TAssert.AssertEquals('a', LMetrics[1].Name);
    TAssert.AssertTrue(LMetrics[1].Kind = mkCounter);
  finally
    LRegistry.Free;
  end;
end;

procedure TMetricsTests.PrometheusName_FromOpenTelemetry;
var
  LRegistry: TPcMetricRegistry;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    TAssert.AssertEquals('http_server_request_duration_seconds',
      PcPrometheusName(LRegistry.Histogram('http.server.request.duration', 's', '', [], [])));
    TAssert.AssertEquals('http_server_active_requests',
      PcPrometheusName(LRegistry.UpDownCounter('http.server.active_requests', '{request}', '', [])));
    TAssert.AssertEquals('requests_total',
      PcPrometheusName(LRegistry.Counter('requests', '{request}', '', [])));
    TAssert.AssertEquals('no second _total', 'jobs_total',
      PcPrometheusName(LRegistry.Counter('jobs_total', '', '', [])));
    TAssert.AssertEquals('unit before _total', 'io_bytes_total',
      PcPrometheusName(LRegistry.Counter('io', 'By', '', [])));
    TAssert.AssertEquals('no second unit', 'wait_seconds',
      PcPrometheusName(LRegistry.Gauge('wait_seconds', 's', '', [])));
    TAssert.AssertEquals('1 on a gauge', 'cpu_utilization_ratio',
      PcPrometheusName(LRegistry.Gauge('cpu.utilization', '1', '', [])));
    TAssert.AssertEquals('1 on a counter', 'hits_total',
      PcPrometheusName(LRegistry.Counter('hits', '1', '', [])));
    TAssert.AssertEquals('per unit', 'throughput_bytes_per_second',
      PcPrometheusName(LRegistry.Gauge('throughput', 'By/s', '', [])));
    TAssert.AssertEquals('annotation per unit', 'rate_per_second',
      PcPrometheusName(LRegistry.Gauge('rate', '{request}/s', '', [])));
    TAssert.AssertEquals('unknown unit kept', 'distance_furlongs',
      PcPrometheusName(LRegistry.Gauge('distance', 'furlongs', '', [])));
    TAssert.AssertEquals('runs collapse', 'a_b_c',
      PcPrometheusName(LRegistry.Gauge('a..b/-c', '', '', [])));
    TAssert.AssertEquals('http_request_method', PcPrometheusLabelName('http.request.method'));
    TAssert.AssertEquals('_x', PcPrometheusLabelName('_x'));
  finally
    LRegistry.Free;
  end;
end;

procedure TMetricsTests.PrometheusFloat_Text;
var
  LSum: Double;
begin
  TAssert.AssertEquals('0', PcPrometheusFloat(0));
  TAssert.AssertEquals('3', PcPrometheusFloat(3));
  TAssert.AssertEquals('-42', PcPrometheusFloat(-42));
  TAssert.AssertEquals('9007199254740991', PcPrometheusFloat(9007199254740991.0));
  TAssert.AssertEquals('0.005', PcPrometheusFloat(0.005));
  TAssert.AssertEquals('0.1', PcPrometheusFloat(0.1));
  TAssert.AssertEquals('-2.5', PcPrometheusFloat(-2.5));
  TAssert.AssertEquals('7.5', PcPrometheusFloat(7.5));
  LSum := 0.1;
  LSum := LSum + 0.2;
  TAssert.AssertEquals('15 significant digits', '0.3', PcPrometheusFloat(LSum));
  TAssert.AssertEquals('NaN', PcPrometheusFloat(NaN));
  TAssert.AssertEquals('+Inf', PcPrometheusFloat(Infinity));
  TAssert.AssertEquals('-Inf', PcPrometheusFloat(NegInfinity));
  TAssert.AssertTrue('1e300 reads back',
    StrToFloat(StringReplace(PcPrometheusFloat(1e300), '.', FormatSettings.DecimalSeparator, []))
      = 1e300);
  TAssert.AssertTrue('1e-7 reads back',
    StrToFloat(StringReplace(PcPrometheusFloat(1e-7), '.', FormatSettings.DecimalSeparator, []))
      = 1e-7);
end;

procedure TMetricsTests.PrometheusText_ByteByByte;
const
  EXPECTED =
    '# HELP http_server_requests_total Requests.\nSecond line \\ back'#10 +
    '# TYPE http_server_requests_total counter'#10 +
    'http_server_requests_total{http_request_method="GET",http_response_status_code="200"} 3'#10 +
    'http_server_requests_total{http_request_method="PO\"ST\\x\n",http_response_status_code="500"} 1'#10 +
    '# TYPE queue_depth gauge'#10 +
    'queue_depth -2.5'#10 +
    '# HELP http_server_request_duration_seconds Duration.'#10 +
    '# TYPE http_server_request_duration_seconds histogram'#10 +
    'http_server_request_duration_seconds_bucket{http_route="/orders/:id",le="0.005"} 0'#10 +
    'http_server_request_duration_seconds_bucket{http_route="/orders/:id",le="0.25"} 1'#10 +
    'http_server_request_duration_seconds_bucket{http_route="/orders/:id",le="1"} 2'#10 +
    'http_server_request_duration_seconds_bucket{http_route="/orders/:id",le="+Inf"} 3'#10 +
    'http_server_request_duration_seconds_sum{http_route="/orders/:id"} 2.75'#10 +
    'http_server_request_duration_seconds_count{http_route="/orders/:id"} 3'#10;
var
  LRegistry: TPcMetricRegistry;
  LCounter: TPcCounter;
  LHistogram: TPcHistogramSeries;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LCounter := LRegistry.Counter('http.server.requests', '{request}',
      'Requests.'#10'Second line \ back', ['http.request.method', 'http.response.status_code']);
    LCounter.Labels(['GET', '200']).Add(3);
    LCounter.Labels(['PO"ST\x'#10, '500']).Inc;
    LRegistry.Gauge('queue.depth', '', '', []).SetValue(-2.5);
    LHistogram := LRegistry.Histogram('http.server.request.duration', 's', 'Duration.',
      ['http.route'], [0.005, 0.25, 1]).Labels(['/orders/:id']);
    LHistogram.Observe(0.25);
    LHistogram.Observe(0.5);
    LHistogram.Observe(2);
    TAssert.AssertEquals(EXPECTED, PcPrometheusText(LRegistry));
  finally
    LRegistry.Free;
  end;
end;

