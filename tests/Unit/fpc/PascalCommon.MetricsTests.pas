procedure TMetricsTests.Threads_RegisterAndRecord_ExactTotals;
var
  LRegistry: TPcMetricRegistry;
  LThreads: array[0..THREAD_COUNT - 1] of TRecorderThread;
  LOps: TPcCounter;
  LLat: TPcHistogram;
  I: Integer;
begin
  for I := 0 to THREAD_COUNT - 1 do
    LThreads[I] := nil;
  LRegistry := TPcMetricRegistry.Create;
  try
    try
      for I := 0 to THREAD_COUNT - 1 do
        LThreads[I] := TRecorderThread.Create(LRegistry, I);
      for I := 0 to THREAD_COUNT - 1 do
        LThreads[I].WaitFor;
      for I := 0 to THREAD_COUNT - 1 do
        TAssert.AssertEquals('thread error', '', LThreads[I].Error);
    finally
      for I := 0 to THREAD_COUNT - 1 do
        LThreads[I].Free;
    end;
    TAssert.AssertEquals('one registration each', 4, Length(LRegistry.Metrics));
    LOps := LRegistry.Counter('ops', '', '', ['key']);
    TAssert.AssertEquals('two series', 2, Length(LOps.Snapshot));
    TAssert.AssertEquals(THREAD_COUNT * OPS_PER_THREAD div 2, LOps.Labels(['0']).Value, 0);
    TAssert.AssertEquals(THREAD_COUNT * OPS_PER_THREAD div 2, LOps.Labels(['1']).Value, 0);
    TAssert.AssertEquals('back to 0', 0,
      LRegistry.UpDownCounter('active', '', '', []).Labels([]).Value, 0);
    LLat := LRegistry.Histogram('lat', 's', '', ['key'], [0.5]);
    TAssert.AssertEquals(THREAD_COUNT * OPS_PER_THREAD div 2, Integer(LLat.Labels(['0']).Count));
    TAssert.AssertEquals(THREAD_COUNT * OPS_PER_THREAD div 2 * 0.25, LLat.Labels(['0']).Sum, 0);
    TAssert.AssertEquals('Double CAS loses nothing', THREAD_COUNT * OPS_PER_THREAD * 0.5,
      LRegistry.Counter('sum', '', '', []).Labels([]).Value, 0);
  finally
    LRegistry.Free;
  end;
end;

