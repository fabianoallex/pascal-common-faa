const
  THREAD_COUNT = 4;
  OPS_PER_THREAD = 5000;

type
  TRecorderThread = class(TThread)
  private
    FRegistry: TPcMetricRegistry;
    FIndex: Integer;
  protected
    procedure Execute; override;
  public
    Error: string;
    constructor Create(ARegistry: TPcMetricRegistry; AIndex: Integer);
  end;

constructor TRecorderThread.Create(ARegistry: TPcMetricRegistry; AIndex: Integer);
begin
  FRegistry := ARegistry;
  FIndex := AIndex;
  inherited Create(False);
end;

procedure TRecorderThread.Execute;
var
  I: Integer;
  LKey: string;
begin
  try
    for I := 1 to OPS_PER_THREAD do
    begin
      // Two keys shared by every thread, so series creation races too.
      LKey := IntToStr(I mod 2);
      FRegistry.Counter('ops', '', '', ['key']).Labels([LKey]).Inc;
      FRegistry.UpDownCounter('active', '', '', []).Inc;
      FRegistry.Histogram('lat', 's', '', ['key'], [0.5]).Labels([LKey]).Observe(0.25);
      FRegistry.Counter('sum', '', '', []).Add(0.5);
      FRegistry.UpDownCounter('active', '', '', []).Dec;
    end;
  except
    on E: Exception do
      Error := E.ClassName + ': ' + E.Message;
  end;
end;

procedure TMetricsTests.Counter_AddsAndIgnoresNegativeAndNaN;
var
  LRegistry: TPcMetricRegistry;
  LCounter: TPcCounter;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LCounter := LRegistry.Counter('c', '', '', []);
    LCounter.Inc;
    LCounter.Add(2.5);
    LCounter.Add(-1);
    LCounter.Add(NaN);
    TAssert.AssertEquals(3.5, LCounter.Labels([]).Value, 0);
  finally
    LRegistry.Free;
  end;
end;

procedure TMetricsTests.UpDownCounter_GoesBothWays;
var
  LRegistry: TPcMetricRegistry;
  LMetric: TPcUpDownCounter;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LMetric := LRegistry.UpDownCounter('u', '', '', []);
    LMetric.Inc;
    LMetric.Inc;
    LMetric.Dec;
    LMetric.Add(-3);
    LMetric.Add(NaN);
    TAssert.AssertEquals(-2, LMetric.Labels([]).Value, 0);
  finally
    LRegistry.Free;
  end;
end;

