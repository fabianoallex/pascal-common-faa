procedure TMetricsTests.Labels_SameValues_SameSeries;
var
  LRegistry: TPcMetricRegistry;
  LCounter: TPcCounter;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    LCounter := LRegistry.Counter('c', '', '', ['a', 'b']);
    TAssert.AssertTrue(LCounter.Labels(['x', 'y']) = LCounter.Labels(['x', 'y']));
    TAssert.AssertFalse(LCounter.Labels(['x', 'y']) = LCounter.Labels(['y', 'x']));
    // A naive join would make these two the same key.
    TAssert.AssertFalse(LCounter.Labels(['x,', 'y']) = LCounter.Labels(['x', ',y']));
    TAssert.AssertEquals(4, Length(LCounter.Snapshot));
  finally
    LRegistry.Free;
  end;
end;

