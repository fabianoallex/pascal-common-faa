end;

procedure TMetricsTests.Registry_SameDefinition_ReturnsTheSameMetric;
var
  LRegistry: TPcMetricRegistry;
begin
  LRegistry := TPcMetricRegistry.Create;
  try
    TAssert.AssertTrue(LRegistry.Counter('c', 's', 'first', ['a']) =
      LRegistry.Counter('c', 's', 'second', ['a']));
