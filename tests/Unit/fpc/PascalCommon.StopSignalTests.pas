{ Tests for PascalCommon.StopSignal: PcStopSleep sleeps its time without a
  stop and returns early on one, PcRequestStop from another thread ends a
  long PcStopSleep, the flag stays raised, and the handlers install and
  uninstall (PcBlockStopSignals runs on a thread of its own, not on the
  runner's).

  The stop flag is process-wide and can't be lowered (the unit has no reset:
  a program stops once), so everything that needs it low runs in one test,
  in order, before the request. A real signal is not sent here: on Windows
  GenerateConsoleCtrlEvent reaches every process on the console, the
  script that runs the suite included, and on Unix the flag is already
  raised by then. tools/test_stop_signal_docker.sh sends a real SIGTERM to
  a separate program on Linux (tests/Signals).

  The waits have deadlines and the thread is awaited with WaitFor, never a
  Sleep and hope: a slow machine makes the test slower, not wrong.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  fpcunit, testregistry,
  Classes,
  SysUtils,
  PascalCommon.Threading,
  PascalCommon.StopSignal;

type
  TStopSignalTests = class(TTestCase)
  published
    procedure StopSleep_ThenRequestStop_FromAnotherThread;
    procedure Install_Uninstall_Block;
  end;

implementation

const
  /// How long the requesting thread waits before it asks for the stop.
  REQUEST_AFTER_MS = 100;
  /// A sleep the stop must cut short; far longer than any slow machine.
  LONG_SLEEP_MS = 30000;

type
  TRequestThread = class(TThread)
  protected
    procedure Execute; override;
  end;

  TBlockThread = class(TThread)
  protected
    procedure Execute; override;
  public
    Error: string;
  end;

procedure TRequestThread.Execute;
begin
  Sleep(REQUEST_AFTER_MS);
  PcRequestStop;
end;

procedure TBlockThread.Execute;
begin
  try
    PcBlockStopSignals;
  except
    on E: Exception do
      Error := E.ClassName + ': ' + E.Message;
  end;
end;

procedure TStopSignalTests.StopSleep_ThenRequestStop_FromAnotherThread;
var
  LStart, LElapsed: Int64;
  LThread: TRequestThread;
begin
  TAssert.AssertFalse('nothing asked for a stop yet', PcStopRequested);

  // No stop: the whole time, in slices, and False.
  LStart := PcTickMs;
  TAssert.AssertFalse(PcStopSleep(3 * PC_STOP_SLICE_MS));
  LElapsed := PcTickMs - LStart;
  TAssert.AssertTrue('slept ' + IntToStr(LElapsed) + ' ms',
    LElapsed >= 3 * PC_STOP_SLICE_MS - 20);
  TAssert.AssertFalse(PcStopSleep(0));

  // A stop from another thread ends a long sleep.
  LThread := TRequestThread.Create(False);
  try
    LStart := PcTickMs;
    TAssert.AssertTrue(PcStopSleep(LONG_SLEEP_MS));
    LElapsed := PcTickMs - LStart;
    LThread.WaitFor;
  finally
    LThread.Free;
  end;
  TAssert.AssertTrue('returned after ' + IntToStr(LElapsed) + ' ms',
    LElapsed < LONG_SLEEP_MS div 2);

  // The flag stays: every later sleep returns at once.
  TAssert.AssertTrue(PcStopRequested);
  LStart := PcTickMs;
  TAssert.AssertTrue(PcStopSleep(LONG_SLEEP_MS));
  TAssert.AssertTrue(PcStopSleep(0));
  TAssert.AssertTrue(PcTickMs - LStart < LONG_SLEEP_MS div 2);
end;

procedure TStopSignalTests.Install_Uninstall_Block;
var
  LThread: TBlockThread;
begin
  PcStopSignalInstall;
  PcStopSignalUninstall;
  // Twice: a program may install again after a restart of its loop.
  PcStopSignalInstall;
  PcStopSignalDone;
  PcStopSignalUninstall;

  LThread := TBlockThread.Create(False);
  try
    LThread.WaitFor;
    TAssert.AssertEquals('', LThread.Error);
  finally
    LThread.Free;
  end;
end;

initialization
  RegisterTest(TStopSignalTests);

end.
