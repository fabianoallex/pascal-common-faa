procedure TTlsTransportTests.ServerRead_BeforeHandshake_Raises;
var
  LTls: TPcTlsOptions;
  LRaw, LAccepted: TPcEndpoint;
  LBuf: Byte;
  LClass: string;
begin
  if not Ready then
    Exit;
  LTls := ServerOpts('');
  FListener := PcTlsListen('127.0.0.1', 0, TcpOpts, LTls);
  LRaw := PcTcpConnect('127.0.0.1', FListener.Port, TcpOpts);
  LAccepted := nil;
  try
    LAccepted := FListener.Accept; // the connection is already in the backlog
    LClass := '';
    try
      LAccepted.Read(LBuf, 1);
    except
      on E: Exception do
        LClass := E.ClassName;
    end;
    TAssert.AssertEquals(EPcTls.ClassName, LClass);
  finally
    LAccepted.Free;
    LRaw.Free;
  end;
end;

