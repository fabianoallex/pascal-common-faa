implementation

const
  CWaitMs = 15000;
  CPfxPassword = 'pipestest';

type
  { Accepts one connection and runs the server handshake on it, as a
    server's connection thread does. On failure it aborts the endpoint, so
    the client isn't left waiting. }
  TTlsServerThread = class(TThread)
  private
    FListener: TPcListener;
    FEndpoint: TPcEndpoint;
    FError: string;
    FHasIdentity: Boolean;
    FIdentity: TPcPeerIdentity;
  protected
    procedure Execute; override;
  public
    HandshakeDone: TEvent;
    constructor Create(AListener: TPcListener);
    destructor Destroy; override;
  end;

  { Base for the IO threads, as in PascalCommon.TcpTransportTests. }
  TIoThread = class(TThread)
  protected
    FEndpoint: TPcEndpoint;
    FErrorClass: string;
    procedure Work; virtual; abstract;
    procedure Execute; override;
  public
    Started: TEvent;
    Done: TEvent;
    constructor Create(AEndpoint: TPcEndpoint);
    destructor Destroy; override;
    property ErrorClass: string read FErrorClass;
  end;

  TReadOneThread = class(TIoThread)
  protected
    procedure Work; override;
  end;

  TBulkWriter = class(TIoThread)
  private
    FTotal: Integer;
    FSeed: Byte;
  protected
    procedure Work; override;
  public
    constructor Create(AEndpoint: TPcEndpoint; ATotal: Integer; ASeed: Byte);
  end;

  TBulkReader = class(TIoThread)
  private
    FTotal: Integer;
    FSeed: Byte;
    FReceived: Integer;
    FMismatchAt: Integer;
  protected
    procedure Work; override;
  public
    constructor Create(AEndpoint: TPcEndpoint; ATotal: Integer; ASeed: Byte);
    property Received: Integer read FReceived;
    property MismatchAt: Integer read FMismatchAt;
  end;

var
  GPkiDir: string;
  GOpenSslNoticePrinted: Boolean;

function PatternByte(AIndex: Integer; ASeed: Byte): Byte;
begin
  Result := Byte((AIndex * 7 + AIndex div 251 + ASeed) and $FF);
end;

// tests/pki, looked for upwards from the executable.
function PkiDir: string;
var
  LDir: string;
  I: Integer;
begin
  if GPkiDir <> '' then
    Exit(GPkiDir);
  LDir := ExtractFileDir(ExpandFileName(ParamStr(0)));
  for I := 0 to 6 do
  begin
    if FileExists(IncludeTrailingPathDelimiter(LDir) + 'tests' + PathDelim +
         'pki' + PathDelim + 'ca_cert.pem') then
    begin
      GPkiDir := IncludeTrailingPathDelimiter(LDir) + 'tests' + PathDelim + 'pki';
      Exit(GPkiDir);
    end;
    if FileExists(IncludeTrailingPathDelimiter(LDir) + 'pki' + PathDelim +
         'ca_cert.pem') then
    begin
      GPkiDir := IncludeTrailingPathDelimiter(LDir) + 'pki';
      Exit(GPkiDir);
    end;
    LDir := ExtractFileDir(LDir);
  end;
  raise Exception.Create('tests/pki not found above ' + ParamStr(0));
end;

function Pki(const AName: string): string;
begin
  Result := IncludeTrailingPathDelimiter(PkiDir) + AName;
end;

function TcpOpts: TPcTcpOptions;
begin
  Result := Default(TPcTcpOptions);
end;

{ TTlsServerThread }

constructor TTlsServerThread.Create(AListener: TPcListener);
begin
  FListener := AListener;
  HandshakeDone := TEvent.Create(nil, True, False, '');
  FreeOnTerminate := False;
  inherited Create(False);
end;

destructor TTlsServerThread.Destroy;
begin
  inherited; // joins
  FEndpoint.Free;
  HandshakeDone.Free;
end;

procedure TTlsServerThread.Execute;
begin
  try
    try
      FEndpoint := FListener.Accept;
      if FEndpoint = nil then
      begin
        FError := 'listener closed';
        Exit;
      end;
      FEndpoint.Handshake;
      FHasIdentity := FEndpoint.TryPeerIdentity(FIdentity);
    except
      on E: Exception do
      begin
        FError := E.ClassName + ': ' + E.Message;
        if FEndpoint <> nil then
          FEndpoint.CloseAbort; // the client must not wait for us
      end;
    end;
  finally
    HandshakeDone.SetEvent;
  end;
end;

{ TIoThread }

constructor TIoThread.Create(AEndpoint: TPcEndpoint);
begin
  FEndpoint := AEndpoint;
  Started := TEvent.Create(nil, True, False, '');
  Done := TEvent.Create(nil, True, False, '');
  FreeOnTerminate := False;
  inherited Create(False);
end;

destructor TIoThread.Destroy;
begin
  inherited;
  Started.Free;
  Done.Free;
end;

procedure TIoThread.Execute;
begin
  try
    try
      Started.SetEvent;
      Work;
    except
      on E: Exception do
        FErrorClass := E.ClassName;
    end;
  finally
    Done.SetEvent;
  end;
end;

procedure TReadOneThread.Work;
var
  LBuf: array[0..63] of Byte;
begin
  FEndpoint.Read(LBuf, SizeOf(LBuf));
end;

constructor TBulkWriter.Create(AEndpoint: TPcEndpoint; ATotal: Integer;
  ASeed: Byte);
begin
  FTotal := ATotal;
  FSeed := ASeed;
  inherited Create(AEndpoint);
end;

procedure TBulkWriter.Work;
const
  CChunk = 100 * 1024; // not a multiple of the record size, on purpose
var
  LBuf: TBytes;
  LSent, LLen, I: Integer;
begin
  SetLength(LBuf, CChunk);
  LSent := 0;
  while LSent < FTotal do
  begin
    LLen := CChunk;
    if FTotal - LSent < LLen then
      LLen := FTotal - LSent;
    for I := 0 to LLen - 1 do
      LBuf[I] := PatternByte(LSent + I, FSeed);
    FEndpoint.WriteExactly(LBuf[0], LLen);
    Inc(LSent, LLen);
  end;
end;

constructor TBulkReader.Create(AEndpoint: TPcEndpoint; ATotal: Integer;
  ASeed: Byte);
begin
  FTotal := ATotal;
  FSeed := ASeed;
  FMismatchAt := -1;
  inherited Create(AEndpoint);
end;

procedure TBulkReader.Work;
var
  LBuf: TBytes;
  LGot, LWant, I: Integer;
begin
  SetLength(LBuf, 7000);
  while FReceived < FTotal do
  begin
    LWant := FTotal - FReceived;
    if LWant > Length(LBuf) then
      LWant := Length(LBuf);
    LGot := FEndpoint.Read(LBuf[0], LWant);
    if FMismatchAt < 0 then
      for I := 0 to LGot - 1 do
        if LBuf[I] <> PatternByte(FReceived + I, FSeed) then
        begin
          FMismatchAt := FReceived + I;
          Break;
        end;
    Inc(FReceived, LGot);
  end;
end;

{ TTlsTransportTests }

function TTlsTransportTests.ClientBackend: TPcTlsBackend;
begin
  Result := tbDefault;
end;

function TTlsTransportTests.ServerBackend: TPcTlsBackend;
begin
  Result := tbDefault;
end;

function TTlsTransportTests.Ready: Boolean;
var
  LError: string;
begin
  Result := True;
  if (PcTlsResolveBackend(ClientBackend) <> tbOpenSsl)
    and (PcTlsResolveBackend(ServerBackend) <> tbOpenSsl) then
    Exit;
  if PcOpenSslAvailable(LError) then
    Exit;
  {$IFDEF MSWINDOWS}
  // SChannel is the default here; OpenSSL is optional, so its fixtures
  // pass with a notice instead of failing a machine without it.
  if not GOpenSslNoticePrinted then
  begin
    GOpenSslNoticePrinted := True;
    // One argument: on Delphi, inside a fixture, WriteLn resolves to a
    // one-parameter routine, not to the intrinsic (E2034 otherwise).
    WriteLn('NOTICE: OpenSSL TLS tests skipped: ' + LError);
  end;
  Result := False;
  {$ELSE}
  TAssert.Fail('OpenSSL is the only TLS backend here and it is missing: ' +
    LError);
  Result := False;
  {$ENDIF}
end;

function TTlsTransportTests.ServerOpts(const ACaFile: string): TPcTlsOptions;
begin
  Result := Default(TPcTlsOptions);
  Result.Backend := ServerBackend;
  if PcTlsResolveBackend(ServerBackend) = tbOpenSsl then
  begin
    Result.CertFile := Pki('srv_cert.pem');
    Result.KeyFile := Pki('srv_key.pem');
  end
  else
  begin
    Result.CertFile := Pki('srv.pfx');
    Result.CertPassword := CPfxPassword;
  end;
  if ACaFile <> '' then
    Result.CaFile := Pki(ACaFile);
end;

function TTlsTransportTests.ClientOpts(const ACert, ACaFile: string;
  ASkip: Boolean): TPcTlsOptions;
begin
  Result := Default(TPcTlsOptions);
  Result.Backend := ClientBackend;
  Result.SkipServerVerification := ASkip;
  Result.HandshakeTimeoutMs := 10000;
  if ACaFile <> '' then
    Result.CaFile := Pki(ACaFile);
  if ACert <> '' then
  begin
    if PcTlsResolveBackend(ClientBackend) = tbOpenSsl then
    begin
      Result.CertFile := Pki(ACert + '_cert.pem');
      Result.KeyFile := Pki(ACert + '_key.pem');
    end
    else
    begin
      Result.CertFile := Pki(ACert + '.pfx');
      Result.CertPassword := CPfxPassword;
    end;
  end;
end;

procedure TTlsTransportTests.SetUp;
begin
  FListener := nil;
  FServer := nil;
  FClientEp := nil;
end;

procedure TTlsTransportTests.TearDown;
var
  LServer: TTlsServerThread;
begin
  if Assigned(FListener) then
    FListener.Close;
  LServer := TTlsServerThread(FServer);
  if Assigned(LServer) then
  begin
    if (LServer.HandshakeDone.WaitFor(0) = wrSignaled)
      and Assigned(LServer.FEndpoint) then
      LServer.FEndpoint.CloseAbort;
  end;
  FreeAndNil(FClientEp); // a server still in its handshake sees the close
  if Assigned(LServer) then
  begin
    if LServer.HandshakeDone.WaitFor(CWaitMs) <> wrSignaled then
      WriteLn('WARNING: TLS server thread still running at TearDown');
    FreeAndNil(FServer);
  end;
  FreeAndNil(FListener);
end;

procedure TTlsTransportTests.StartServer(const ACaFile: string;
  AHandshakeTimeoutMs: Cardinal);
var
  LTls: TPcTlsOptions;
begin
  LTls := ServerOpts(ACaFile);
  LTls.HandshakeTimeoutMs := AHandshakeTimeoutMs;
  FListener := PcTlsListen('127.0.0.1', 0, TcpOpts, LTls);
  FServer := TTlsServerThread.Create(FListener);
end;

function TTlsTransportTests.TryConnect(const AName: string;
  const ATls: TPcTlsOptions; out AError: string): Boolean;
begin
  AError := '';
  try
    FClientEp := PcTlsWrap(PcTcpConnect('127.0.0.1', FListener.Port, TcpOpts),
      AName, ATls);
    Result := True;
  except
    on E: Exception do
    begin
      AError := E.ClassName + ': ' + E.Message;
      Result := False;
    end;
  end;
end;

function TTlsTransportTests.ServerResult: string;
var
  LServer: TTlsServerThread;
begin
  LServer := TTlsServerThread(FServer);
  if LServer.HandshakeDone.WaitFor(CWaitMs) <> wrSignaled then
    Exit('server handshake did not finish');
  Result := LServer.FError;
end;

function TTlsTransportTests.ServerEndpoint: TPcEndpoint;
begin
  Result := TTlsServerThread(FServer).FEndpoint;
end;

procedure TTlsTransportTests.CheckClientRefused(const AName: string;
  const ATls: TPcTlsOptions);
var
  LError: string;
begin
  StartServer('');
  TAssert.AssertFalse('the client accepted a server it should refuse',
    TryConnect(AName, ATls, LError));
  TAssert.AssertTrue('expected EPcTls, got ' + LError,
    Pos(EPcTls.ClassName + ':', LError) = 1);
end;

procedure TTlsTransportTests.CheckMtlsRefused(const ACert: string);
var
  LError, LServerError: string;
  LBuf: Byte;
  LUsable: Boolean;
begin
  StartServer('ca_cert.pem');
  TryConnect('127.0.0.1', ClientOpts(ACert, 'ca_cert.pem', False), LError);
  LServerError := ServerResult;
  TAssert.AssertTrue('the server accepted a client it should refuse',
    LServerError <> '');
  TAssert.AssertTrue('expected EPcTls on the server, got ' + LServerError,
    Pos(EPcTls.ClassName + ':', LServerError) = 1);
  TAssert.AssertFalse('a refused client has no identity',
    TTlsServerThread(FServer).FHasIdentity);
  // TLS 1.2 may finish the client's side of the handshake before the server
  // checks the certificate; the session must be dead anyway.
  if FClientEp <> nil then
  begin
    FClientEp.SetIoDeadline(5000);
    LUsable := True;
    try
      FClientEp.Read(LBuf, 1);
    except
      LUsable := False;
    end;
    TAssert.AssertFalse('the refused client can still read', LUsable);
  end;
end;

procedure TTlsTransportTests.RoundTrip_SkipServerVerification;
var
  LOk: Boolean;
  LError: string;
  LOut: AnsiString;
  LIn: array[0..31] of AnsiChar;
  LLen: Integer;
  LText: AnsiString;
begin
  if not Ready then
    Exit;
  StartServer('');
  LOk := TryConnect('127.0.0.1',
    ClientOpts('', '', True), LError);
  TAssert.AssertTrue(LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
  LOut := 'encrypted ping';
  FClientEp.WriteExactly(LOut[1], Length(LOut));
  LLen := ServerEndpoint.Read(LIn[0], SizeOf(LIn));
  SetString(LText, PAnsiChar(@LIn[0]), LLen);
  TAssert.AssertEquals('encrypted ping', string(LText));
  LOut := 'pong';
  ServerEndpoint.WriteExactly(LOut[1], Length(LOut));
  LLen := FClientEp.Read(LIn[0], SizeOf(LIn));
  SetString(LText, PAnsiChar(@LIn[0]), LLen);
  TAssert.AssertEquals('pong', string(LText));
end;

procedure TTlsTransportTests.ClientVerifiesServer_PrivateCa_ByIp;
var
  LOk: Boolean;
  LError: string;
begin
  if not Ready then
    Exit;
  // The certificate has IP:127.0.0.1 in its SAN. On OpenSSL 1.1.1 only
  // X509_VERIFY_PARAM_set1_ip_asc matches it (see the backend's header).
  StartServer('');
  LOk := TryConnect('127.0.0.1', ClientOpts('', 'ca_cert.pem', False), LError);
  TAssert.AssertTrue('refused a legitimate server by IP: ' + LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
end;

procedure TTlsTransportTests.ClientVerifiesServer_PrivateCa_ByName;
var
  LOk: Boolean;
  LError: string;
begin
  if not Ready then
    Exit;
  // TCP to 127.0.0.1, the name checked is 'localhost' (DNS:localhost in the
  // SAN): no name resolution involved.
  StartServer('');
  LOk := TryConnect('localhost', ClientOpts('', 'ca_cert.pem', False), LError);
  TAssert.AssertTrue('refused a legitimate server by name: ' + LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
end;

procedure TTlsTransportTests.ClientVerifiesServer_WrongName_Refused;
begin
  if not Ready then
    Exit;
  CheckClientRefused('wrong.example', ClientOpts('', 'ca_cert.pem', False));
end;

procedure TTlsTransportTests.ClientVerifiesServer_OtherCa_Refused;
begin
  if not Ready then
    Exit;
  CheckClientRefused('127.0.0.1', ClientOpts('', 'rogue_ca_cert.pem', False));
end;

procedure TTlsTransportTests.ClientVerifiesServer_SystemStore_RefusesTheTestCa;
begin
  if not Ready then
    Exit;
  // The zeroed record's default: validate, against the system store, where
  // the test CA isn't.
  CheckClientRefused('localhost', ClientOpts('', '', False));
end;

procedure TTlsTransportTests.Mtls_ClientOfTheCa_AcceptedWithItsIdentity;
var
  LOk: Boolean;
  LError: string;
  LId: TPcPeerIdentity;
begin
  if not Ready then
    Exit;
  StartServer('ca_cert.pem');
  LOk := TryConnect('127.0.0.1',
    ClientOpts('cli', 'ca_cert.pem', False), LError);
  TAssert.AssertTrue(LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
  TAssert.AssertTrue('no identity under mTLS',
    TTlsServerThread(FServer).FHasIdentity);
  LId := TTlsServerThread(FServer).FIdentity;
  TAssert.AssertEquals('pdv-loja-001', LId.CommonName);
  TAssert.AssertTrue('subject: ' + LId.Subject,
    Pos('pdv-loja-001', LId.Subject) > 0);
  TAssert.AssertFalse('the client side has no peer identity',
    FClientEp.TryPeerIdentity(LId));
end;

procedure TTlsTransportTests.Mtls_NoClientCertificate_Refused;
begin
  if not Ready then
    Exit;
  CheckMtlsRefused('');
end;

procedure TTlsTransportTests.Mtls_ClientOfAnotherCa_Refused;
begin
  if not Ready then
    Exit;
  CheckMtlsRefused('rogue');
end;

procedure TTlsTransportTests.Mtls_SelfSignedClient_Refused;
begin
  if not Ready then
    Exit;
  CheckMtlsRefused('selfsigned');
end;

procedure TTlsTransportTests.Mtls_ClientOfATwinCa_Refused;
begin
  if not Ready then
    Exit;
  // The twin CA has the real CA's name and serial and another key.
  CheckMtlsRefused('twin');
end;

procedure TTlsTransportTests.NoMtls_NoIdentity;
var
  LOk: Boolean;
  LError: string;
begin
  if not Ready then
    Exit;
  StartServer('');
  LOk := TryConnect('127.0.0.1',
    ClientOpts('cli', 'ca_cert.pem', False), LError);
  TAssert.AssertTrue(LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
  TAssert.AssertFalse('no mTLS, no identity',
    TTlsServerThread(FServer).FHasIdentity);
end;

procedure TTlsTransportTests.Handshake_SilentClient_ServerTimesOut;
var
  LRaw: TPcEndpoint;
  LServerError: string;
begin
  if not Ready then
    Exit;
  // A plain TCP client that never sends a ClientHello: the server's thread
  // must give up on its own.
  StartServer('', 300);
  LRaw := PcTcpConnect('127.0.0.1', FListener.Port, TcpOpts);
  try
    LServerError := ServerResult;
  finally
    LRaw.Free;
  end;
  TAssert.AssertTrue('expected a timeout, got ' + LServerError,
    Pos(EPcTransportTimeout.ClassName + ':', LServerError) = 1);
end;

procedure TTlsTransportTests.Handshake_SilentServer_ClientTimesOut;
var
  LTls: TPcTlsOptions;
  LError: string;
  T0, LElapsed: UInt64;
begin
  if not Ready then
    Exit;
  // A plain TCP listener: the connection completes in the backlog and
  // nobody ever answers the ClientHello.
  FListener := PcTcpListen('127.0.0.1', 0, TcpOpts);
  LTls := ClientOpts('', '', True);
  LTls.HandshakeTimeoutMs := 300;
  T0 := PcTickMs;
  TAssert.AssertFalse('the handshake with a silent server succeeded',
    TryConnect('127.0.0.1', LTls, LError));
  LElapsed := PcTickMs - T0;
  TAssert.AssertTrue('expected a timeout, got ' + LError,
    Pos(EPcTransportTimeout.ClassName + ':', LError) = 1);
  TAssert.AssertTrue('took ' + IntToStr(LElapsed) + ' ms', LElapsed < 5000);
end;

procedure TTlsTransportTests.FullDuplexBulk_OverTls;
const
  CTotal = 4 * 1024 * 1024;
  CBulkWaitMs = 60000;
var
  LOk: Boolean;
  LError: string;
  LCliW, LSrvW: TBulkWriter;
  LCliR, LSrvR: TBulkReader;
  LAllDone: Boolean;
begin
  if not Ready then
    Exit;
  // Many records each way, and on each endpoint a reader and a writer at
  // the same time: SChannel decrypting on one thread while encrypting on
  // another, OpenSSL's two locks, the TCP layer's two wake-ups.
  StartServer('');
  LOk := TryConnect('127.0.0.1',
    ClientOpts('', '', True), LError);
  TAssert.AssertTrue(LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
  LCliW := nil; LSrvW := nil; LCliR := nil; LSrvR := nil;
  try
    LSrvR := TBulkReader.Create(ServerEndpoint, CTotal, 1);
    LCliR := TBulkReader.Create(FClientEp, CTotal, 2);
    LCliW := TBulkWriter.Create(FClientEp, CTotal, 1);
    LSrvW := TBulkWriter.Create(ServerEndpoint, CTotal, 2);
    LAllDone := (LCliW.Done.WaitFor(CBulkWaitMs) = wrSignaled)
      and (LSrvW.Done.WaitFor(CBulkWaitMs) = wrSignaled)
      and (LCliR.Done.WaitFor(CBulkWaitMs) = wrSignaled)
      and (LSrvR.Done.WaitFor(CBulkWaitMs) = wrSignaled);
    if not LAllDone then
    begin
      FClientEp.CloseAbort;
      ServerEndpoint.CloseAbort;
    end;
    LCliW.WaitFor; LSrvW.WaitFor; LCliR.WaitFor; LSrvR.WaitFor;
    TAssert.AssertTrue(Format('stuck: server read %d, client read %d of %d',
      [LSrvR.Received, LCliR.Received, CTotal]), LAllDone);
    TAssert.AssertEquals('client writer', '', LCliW.ErrorClass);
    TAssert.AssertEquals('server writer', '', LSrvW.ErrorClass);
    TAssert.AssertEquals('server reader', '', LSrvR.ErrorClass);
    TAssert.AssertEquals('client reader', '', LCliR.ErrorClass);
    TAssert.AssertEquals('server received', CTotal, LSrvR.Received);
    TAssert.AssertEquals('client received', CTotal, LCliR.Received);
    TAssert.AssertEquals('server mismatch', -1, LSrvR.MismatchAt);
    TAssert.AssertEquals('client mismatch', -1, LCliR.MismatchAt);
  finally
    LCliW.Free; LSrvW.Free; LCliR.Free; LSrvR.Free;
  end;
end;

procedure TTlsTransportTests.CloseAbort_UnblocksATlsReader;
var
  LOk: Boolean;
  LError: string;
  LReader: TReadOneThread;
begin
  if not Ready then
    Exit;
  StartServer('');
  LOk := TryConnect('127.0.0.1',
    ClientOpts('', '', True), LError);
  TAssert.AssertTrue(LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
  LReader := TReadOneThread.Create(FClientEp);
  try
    LReader.Started.WaitFor(CWaitMs);
    Sleep(50); // a moment to enter the wait (not needed for the result)
    FClientEp.CloseAbort;
    TAssert.AssertTrue('CloseAbort did not unblock the TLS Read',
      LReader.Done.WaitFor(CWaitMs) = wrSignaled);
    LReader.WaitFor;
    TAssert.AssertEquals(EPcTransportClosed.ClassName, LReader.ErrorClass);
  finally
    LReader.Free;
  end;
end;

procedure TTlsTransportTests.PeerClosing_ReadRaisesClosed;
var
  LOk: Boolean;
  LError: string;
  LReader: TReadOneThread;
begin
  if not Ready then
    Exit;
  StartServer('');
  LOk := TryConnect('127.0.0.1',
    ClientOpts('', '', True), LError);
  TAssert.AssertTrue(LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
  LReader := TReadOneThread.Create(ServerEndpoint);
  try
    LReader.Started.WaitFor(CWaitMs);
    FreeAndNil(FClientEp); // sends close_notify, then closes the socket
    if LReader.Done.WaitFor(CWaitMs) <> wrSignaled then
      ServerEndpoint.CloseAbort;
    LReader.WaitFor;
    TAssert.AssertEquals(EPcTransportClosed.ClassName, LReader.ErrorClass);
  finally
    LReader.Free;
  end;
end;

procedure TTlsTransportTests.SetIoDeadline_ReadTimesOutThroughTls;
var
  LOk: Boolean;
  LError, LClass: string;
  LBuf: array[0..15] of Byte;
begin
  if not Ready then
    Exit;
  StartServer('');
  LOk := TryConnect('127.0.0.1',
    ClientOpts('', '', True), LError);
  TAssert.AssertTrue(LError, LOk);
  TAssert.AssertEquals('server', '', ServerResult);
  FClientEp.SetIoDeadline(200);
  LClass := '';
  try
    FClientEp.Read(LBuf, SizeOf(LBuf)); // the server sends nothing
  except
    on E: Exception do
      LClass := E.ClassName;
  end;
  TAssert.AssertEquals(EPcTransportTimeout.ClassName, LClass);
end;

