unit PascalCommon.HttpTelemetryTests;

{ Tests for PascalCommon.Http.Telemetry: the client span (parent, name,
  attributes, the traceparent and tracestate sent, errors), the cases with
  no span (no current span, the caller's own traceparent, NoSpans, a URL the
  parser refuses), the root span on request, http.request.resend_count, the
  method normalization, the histogram's labels and count, and many threads
  at once, each request carrying its own thread's trace.

  Everything runs over TPcFakeHttpTransport, with no socket. Tracing is
  started without its export thread (AAutoFlush = False) and FlushNow hands
  the spans to a fake exporter that keeps them. The histogram is the
  process-wide one on PcMetrics, which no other suite records into; each
  test reads the count of its own series before and after, with a host name
  of its own, so the order of the tests doesn't matter.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  PascalCommon.DUnitXCompat,
  Classes,
  SysUtils,
  PascalCommon.TraceContext,
  PascalCommon.Tracing,
  PascalCommon.Metrics,
  PascalCommon.Http,
  PascalCommon.Http.Fake,
  PascalCommon.Http.Telemetry;

type
  TTelemetrySpanExporter = class(TInterfacedObject, IPcSpanExporter)
  public
    Spans: TPcSpanDataArray;
    function ExportSpans(const ASpans: TPcSpanDataArray; out AError: string): Boolean;
  end;

  [TestFixture]
  THttpTelemetryTests = class
  private
    FExporterObj: TTelemetrySpanExporter;
    FExporter: IPcSpanExporter;
    FFake: TPcFakeHttpTransport;
    FInner: IPcHttpTransport;
    FTransport: IPcHttpTransport;
    procedure Wrap(const AOptions: TPcHttpTelemetryOptions);
    function ClientSpans: TPcSpanDataArray;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Span_ChildOfTheCurrent_AttributesAndTraceParent;
    [Test] procedure UrlFull_HasNoQueryNorFragment;
    [Test] procedure Status_From400_IsAnError;
    [Test] procedure Exception_ErrorType_ReRaisedUnchanged;
    [Test] procedure NoCurrentSpan_NoSpanNoHeader;
    [Test] procedure RootWhenNoParent_StartsATrace;
    [Test] procedure CallersTraceParent_Unchanged_NoSpan;
    [Test] procedure TraceState_OfTheParent_IsSent;
    [Test] procedure NoSpans_And_NoMetrics;
    [Test] procedure ResendCount_IsAnAttribute;
    [Test] procedure MetricMethod_KnownExactly_OtherwiseOther;
    [Test] procedure UnknownMethod_SpanNamedHttp;
    [Test] procedure Metric_Labels_AbsentAreEmpty;
    [Test] procedure InvalidUrl_PassedOnUnrecorded;
    [Test] procedure CallersRequest_NotChanged;
    [Test] procedure ManyThreads_EachRequestInItsThreadsTrace;
  end;

implementation

const
  THREAD_COUNT = 8;
  SENDS_PER_THREAD = 25;

type
  TSendThread = class(TThread)
  private
    FTransport: IPcHttpTransport;
  protected
    procedure Execute; override;
  public
    TraceId: string;
    Error: string;
    constructor Create(const ATransport: IPcHttpTransport);
  end;

function TTelemetrySpanExporter.ExportSpans(const ASpans: TPcSpanDataArray;
  out AError: string): Boolean;
var
  I: Integer;
begin
  for I := 0 to High(ASpans) do
  begin
    SetLength(Spans, Length(Spans) + 1);
    Spans[High(Spans)] := ASpans[I];
  end;
  AError := '';
  Result := True;
end;

// The attribute AKey of AData as text ('' when absent), and whether it is there.
function FindAttr(const AData: TPcSpanData; const AKey: string; out AValue: string): Boolean;
var
  I: Integer;
begin
  for I := 0 to High(AData.Attributes) do
    if AData.Attributes[I].Key = AKey then
    begin
      case AData.Attributes[I].ValueType of
        satInt: AValue := IntToStr(AData.Attributes[I].IntValue);
        satBool: AValue := BoolToStr(AData.Attributes[I].BoolValue, True);
      else
        AValue := AData.Attributes[I].StringValue;
      end;
      Exit(True);
    end;
  AValue := '';
  Result := False;
end;

function Attr(const AData: TPcSpanData; const AKey: string): string;
begin
  FindAttr(AData, AKey, Result);
end;

function HasAttr(const AData: TPcSpanData; const AKey: string): Boolean;
var
  LIgnored: string;
begin
  Result := FindAttr(AData, AKey, LIgnored);
end;

// The count of the histogram's series with these label values; 0 when it
// doesn't exist yet.
function DurationCount(const AMethod, AHost, APort, AScheme, AStatus, AError: string): UInt64;
var
  LMetrics: TPcMetricList;
  LPoints: TPcMetricPoints;
  I, M: Integer;
begin
  Result := 0;
  LMetrics := PcMetrics.Metrics;
  for M := 0 to High(LMetrics) do
    if LMetrics[M].Name = PC_HTTP_CLIENT_DURATION_METRIC then
    begin
      LPoints := LMetrics[M].Snapshot;
      for I := 0 to High(LPoints) do
        if (LPoints[I].LabelValues[0] = AMethod) and (LPoints[I].LabelValues[1] = AHost) and
           (LPoints[I].LabelValues[2] = APort) and (LPoints[I].LabelValues[3] = AScheme) and
           (LPoints[I].LabelValues[4] = AStatus) and (LPoints[I].LabelValues[5] = AError) then
          Exit(LPoints[I].Count);
    end;
end;

function TraceIdOf(const ATraceParent: string): string;
var
  LParsed: TPcTraceParent;
begin
  if PcTryParseTraceParent(ATraceParent, LParsed) then
    Result := LParsed.TraceId
  else
    Result := '';
end;

{ TSendThread }

constructor TSendThread.Create(const ATransport: IPcHttpTransport);
begin
  FTransport := ATransport;
  inherited Create(False);
end;

procedure TSendThread.Execute;
var
  LSpan: IPcSpan;
  I: Integer;
begin
  try
    LSpan := TPcTracing.StartSpan('thread', skInternal);
    try
      TraceId := LSpan.TraceId;
      for I := 1 to SENDS_PER_THREAD do
        FTransport.Send(TPcHttpRequest.Create('GET', 'http://threads.test/x'));
    finally
      LSpan.Finish;
    end;
    LSpan := nil;
  except
    on E: Exception do
      Error := E.ClassName + ': ' + E.Message;
  end;
  FTransport := nil;
end;

{ THttpTelemetryTests }

procedure THttpTelemetryTests.Setup;
begin
  FExporterObj := TTelemetrySpanExporter.Create;
  FExporter := FExporterObj;
  TPcTracing.Start(TPcTracingOptions.Default('svc', '1.0.0'), FExporter, False);
  FFake := TPcFakeHttpTransport.Create;
  FInner := FFake;
  Wrap(Default(TPcHttpTelemetryOptions));
end;

procedure THttpTelemetryTests.TearDown;
begin
  FTransport := nil;
  FInner := nil;
  TPcTracing.Shutdown;
  FExporter := nil;
end;

procedure THttpTelemetryTests.Wrap(const AOptions: TPcHttpTelemetryOptions);
begin
  FTransport := PcNewTracedHttpTransport(FInner, AOptions);
end;

function THttpTelemetryTests.ClientSpans: TPcSpanDataArray;
var
  I: Integer;
begin
  TPcTracing.FlushNow;
  Result := nil;
  for I := 0 to High(FExporterObj.Spans) do
    if FExporterObj.Spans[I].Kind = skClient then
    begin
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := FExporterObj.Spans[I];
    end;
end;

procedure THttpTelemetryTests.Span_ChildOfTheCurrent_AttributesAndTraceParent;
var
  LParent: IPcSpan;
  LSpans: TPcSpanDataArray;
  LSent: string;
begin
  FFake.Answer(200, 'ok');
  LParent := TPcTracing.StartSpan('handler', skServer);
  try
    TAssert.AssertEquals(200, FTransport.Send(
      TPcHttpRequest.Create('GET', 'https://search.test:7700/indexes')).Status);
  finally
    LParent.Finish;
  end;
  LSpans := ClientSpans;
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals('GET', LSpans[0].Name);
  TAssert.AssertEquals(LParent.TraceId, LSpans[0].TraceId);
  TAssert.AssertEquals(LParent.SpanId, LSpans[0].ParentSpanId);
  TAssert.AssertEquals('GET', Attr(LSpans[0], 'http.request.method'));
  TAssert.AssertEquals('search.test', Attr(LSpans[0], 'server.address'));
  TAssert.AssertEquals('7700', Attr(LSpans[0], 'server.port'));
  TAssert.AssertEquals('https', Attr(LSpans[0], 'url.scheme'));
  TAssert.AssertEquals('https://search.test:7700/indexes', Attr(LSpans[0], 'url.full'));
  TAssert.AssertEquals('200', Attr(LSpans[0], 'http.response.status_code'));
  TAssert.AssertFalse('no error.type on success', HasAttr(LSpans[0], 'error.type'));
  TAssert.AssertFalse('no resend_count on a first try', HasAttr(LSpans[0], 'http.request.resend_count'));
  TAssert.AssertTrue('2xx leaves the status unset', LSpans[0].Status = ssUnset);
  // The traceparent sent is this span's.
  LSent := FFake.Request(0).Header('traceparent');
  TAssert.AssertEquals(PcFormatTraceParent(LSpans[0].TraceId, LSpans[0].SpanId, True), LSent);
  TAssert.AssertEquals('', FFake.Request(0).Header('tracestate'));
  LParent := nil;
end;

procedure THttpTelemetryTests.UrlFull_HasNoQueryNorFragment;
var
  LParent: IPcSpan;
  LSpans: TPcSpanDataArray;
begin
  FFake.Answer(200);
  LParent := TPcTracing.StartSpan('handler');
  try
    FTransport.Send(TPcHttpRequest.Create('GET', 'http://q.test/search?api_key=secret#top'));
  finally
    LParent.Finish;
  end;
  LParent := nil;
  LSpans := ClientSpans;
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals('http://q.test/search', Attr(LSpans[0], 'url.full'));
  TAssert.AssertEquals('80', Attr(LSpans[0], 'server.port'));
  // The request itself goes as written.
  TAssert.AssertEquals('http://q.test/search?api_key=secret#top', FFake.Request(0).Url);
end;

procedure THttpTelemetryTests.Status_From400_IsAnError;
const
  STATUSES: array[0..3] of Integer = (404, 503, 302, 200);
var
  LParent: IPcSpan;
  LSpans: TPcSpanDataArray;
  I: Integer;
begin
  for I := 0 to High(STATUSES) do
    FFake.Answer(STATUSES[I]);
  LParent := TPcTracing.StartSpan('handler');
  try
    for I := 0 to High(STATUSES) do
      TAssert.AssertEquals('every status is an answer', STATUSES[I],
        FTransport.Send(TPcHttpRequest.Create('GET', 'http://status.test/')).Status);
  finally
    LParent.Finish;
  end;
  LParent := nil;
  LSpans := ClientSpans;
  TAssert.AssertEquals(4, Length(LSpans));
  TAssert.AssertTrue('404 is an error', LSpans[0].Status = ssError);
  TAssert.AssertEquals('404', Attr(LSpans[0], 'error.type'));
  TAssert.AssertEquals('', LSpans[0].StatusMessage);
  TAssert.AssertTrue('503 is an error', LSpans[1].Status = ssError);
  TAssert.AssertEquals('503', Attr(LSpans[1], 'error.type'));
  TAssert.AssertTrue('302 is not', LSpans[2].Status = ssUnset);
  TAssert.AssertFalse(HasAttr(LSpans[2], 'error.type'));
  TAssert.AssertTrue('200 is not', LSpans[3].Status = ssUnset);
end;

procedure THttpTelemetryTests.Exception_ErrorType_ReRaisedUnchanged;
var
  LParent: IPcSpan;
  LSpans: TPcSpanDataArray;
  LRaised: string;
  LBefore: UInt64;
begin
  LBefore := DurationCount('POST', 'down.test', '80', 'http', '', 'EPcHttpTransport');
  FFake.Fail('POST http://down.test/x: no answer (refused)');
  LRaised := '';
  LParent := TPcTracing.StartSpan('handler');
  try
    try
      FTransport.Send(TPcHttpRequest.Create('POST', 'http://down.test/x'));
    except
      on E: Exception do
        LRaised := E.ClassName + ': ' + E.Message;
    end;
  finally
    LParent.Finish;
  end;
  LParent := nil;
  TAssert.AssertEquals('EPcHttpTransport: POST http://down.test/x: no answer (refused)', LRaised);
  LSpans := ClientSpans;
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertTrue(LSpans[0].Status = ssError);
  TAssert.AssertEquals('POST http://down.test/x: no answer (refused)', LSpans[0].StatusMessage);
  TAssert.AssertEquals('EPcHttpTransport', Attr(LSpans[0], 'error.type'));
  TAssert.AssertFalse('no answer, no status', HasAttr(LSpans[0], 'http.response.status_code'));
  TAssert.AssertTrue('recorded with no status', DurationCount('POST', 'down.test', '80', 'http', '',
    'EPcHttpTransport') = LBefore + 1);
end;

procedure THttpTelemetryTests.NoCurrentSpan_NoSpanNoHeader;
var
  LBefore: UInt64;
begin
  LBefore := DurationCount('GET', 'orphan.test', '80', 'http', '200', '');
  FFake.Answer(200);
  FTransport.Send(TPcHttpRequest.Create('GET', 'http://orphan.test/'));
  TAssert.AssertEquals(0, Length(ClientSpans));
  TAssert.AssertEquals('', FFake.Request(0).Header('traceparent'));
  TAssert.AssertTrue('the metric is still recorded',
    DurationCount('GET', 'orphan.test', '80', 'http', '200', '') = LBefore + 1);
end;

procedure THttpTelemetryTests.RootWhenNoParent_StartsATrace;
var
  LOptions: TPcHttpTelemetryOptions;
  LSpans: TPcSpanDataArray;
begin
  LOptions := Default(TPcHttpTelemetryOptions);
  LOptions.RootWhenNoParent := True;
  Wrap(LOptions);
  FFake.Answer(200);
  FTransport.Send(TPcHttpRequest.Create('DELETE', 'http://root.test/a/1'));
  LSpans := ClientSpans;
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals('DELETE', LSpans[0].Name);
  TAssert.AssertEquals('a root', '', LSpans[0].ParentSpanId);
  TAssert.AssertEquals(LSpans[0].TraceId, TraceIdOf(FFake.Request(0).Header('traceparent')));
  TAssert.AssertTrue('the current span is back to none', TPcTracing.Current = nil);
end;

procedure THttpTelemetryTests.CallersTraceParent_Unchanged_NoSpan;
const
  THEIRS = '00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01';
var
  LParent: IPcSpan;
  LRequest: TPcHttpRequest;
begin
  FFake.Answer(200);
  LRequest := TPcHttpRequest.Create('GET', 'http://forward.test/');
  LRequest.AddHeader('TraceParent', THEIRS);
  LRequest.AddHeader('tracestate', 'k=v');
  LParent := TPcTracing.StartSpan('handler');
  try
    FTransport.Send(LRequest);
  finally
    LParent.Finish;
  end;
  LParent := nil;
  TAssert.AssertEquals(0, Length(ClientSpans));
  TAssert.AssertEquals(2, Length(FFake.Request(0).Headers));
  TAssert.AssertEquals(THEIRS, FFake.Request(0).Header('traceparent'));
  TAssert.AssertEquals('k=v', FFake.Request(0).Header('tracestate'));
end;

procedure THttpTelemetryTests.TraceState_OfTheParent_IsSent;
var
  LParent: IPcSpan;
begin
  FFake.Answer(200);
  LParent := TPcTracing.StartSpanFromParent(
    '00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01', 'vendor=abc', 'consume',
    skConsumer);
  try
    FTransport.Send(TPcHttpRequest.Create('GET', 'http://state.test/'));
  finally
    LParent.Finish;
  end;
  LParent := nil;
  TAssert.AssertEquals('0af7651916cd43dd8448eb211c80319c',
    TraceIdOf(FFake.Request(0).Header('traceparent')));
  TAssert.AssertEquals('vendor=abc', FFake.Request(0).Header('tracestate'));
end;

procedure THttpTelemetryTests.NoSpans_And_NoMetrics;
var
  LOptions: TPcHttpTelemetryOptions;
  LParent: IPcSpan;
  LBefore: UInt64;
begin
  LBefore := DurationCount('GET', 'switches.test', '80', 'http', '200', '');
  LOptions := Default(TPcHttpTelemetryOptions);
  LOptions.NoSpans := True;
  Wrap(LOptions);
  FFake.Answer(200);
  LParent := TPcTracing.StartSpan('handler');
  try
    FTransport.Send(TPcHttpRequest.Create('GET', 'http://switches.test/'));
  finally
    LParent.Finish;
  end;
  LParent := nil;
  TAssert.AssertEquals(0, Length(ClientSpans));
  TAssert.AssertEquals('', FFake.Request(0).Header('traceparent'));
  TAssert.AssertTrue('NoSpans still records the metric',
    DurationCount('GET', 'switches.test', '80', 'http', '200', '') = LBefore + 1);

  LOptions.NoSpans := False;
  LOptions.NoMetrics := True;
  Wrap(LOptions);
  FFake.Answer(200);
  LParent := TPcTracing.StartSpan('handler');
  try
    FTransport.Send(TPcHttpRequest.Create('GET', 'http://switches.test/'));
  finally
    LParent.Finish;
  end;
  LParent := nil;
  TAssert.AssertEquals(1, Length(ClientSpans));
  TAssert.AssertTrue('NoMetrics records nothing',
    DurationCount('GET', 'switches.test', '80', 'http', '200', '') = LBefore + 1);
end;

procedure THttpTelemetryTests.ResendCount_IsAnAttribute;
var
  LParent: IPcSpan;
  LRequest: TPcHttpRequest;
  LSpans: TPcSpanDataArray;
begin
  FFake.Answer(503);
  LRequest := TPcHttpRequest.Create('GET', 'http://retry.test/');
  TAssert.AssertEquals('Create sets it to 0', 0, LRequest.ResendCount);
  LRequest.ResendCount := 2;
  LParent := TPcTracing.StartSpan('handler');
  try
    FTransport.Send(LRequest);
  finally
    LParent.Finish;
  end;
  LParent := nil;
  LSpans := ClientSpans;
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals('2', Attr(LSpans[0], 'http.request.resend_count'));
end;

procedure THttpTelemetryTests.MetricMethod_KnownExactly_OtherwiseOther;
begin
  TAssert.AssertEquals('GET', PcHttpMetricMethod('GET'));
  TAssert.AssertEquals('HEAD', PcHttpMetricMethod('HEAD'));
  TAssert.AssertEquals('POST', PcHttpMetricMethod('POST'));
  TAssert.AssertEquals('PUT', PcHttpMetricMethod('PUT'));
  TAssert.AssertEquals('DELETE', PcHttpMetricMethod('DELETE'));
  TAssert.AssertEquals('CONNECT', PcHttpMetricMethod('CONNECT'));
  TAssert.AssertEquals('OPTIONS', PcHttpMetricMethod('OPTIONS'));
  TAssert.AssertEquals('TRACE', PcHttpMetricMethod('TRACE'));
  TAssert.AssertEquals('PATCH', PcHttpMetricMethod('PATCH'));
  TAssert.AssertEquals('methods are case-sensitive', '_OTHER', PcHttpMetricMethod('get'));
  TAssert.AssertEquals('_OTHER', PcHttpMetricMethod('PURGE'));
  TAssert.AssertEquals('_OTHER', PcHttpMetricMethod(''));
end;

procedure THttpTelemetryTests.UnknownMethod_SpanNamedHttp;
var
  LParent: IPcSpan;
  LSpans: TPcSpanDataArray;
begin
  FFake.Answer(200);
  LParent := TPcTracing.StartSpan('handler');
  try
    FTransport.Send(TPcHttpRequest.Create('PURGE', 'http://cdn.test/a'));
  finally
    LParent.Finish;
  end;
  LParent := nil;
  LSpans := ClientSpans;
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals('HTTP', LSpans[0].Name);
  TAssert.AssertEquals('_OTHER', Attr(LSpans[0], 'http.request.method'));
  TAssert.AssertEquals('the method itself is sent', 'PURGE', FFake.Request(0).Method);
end;

procedure THttpTelemetryTests.Metric_Labels_AbsentAreEmpty;
var
  LOk, LNotFound, LDown: UInt64;
begin
  LOk := DurationCount('PUT', 'labels.test', '8080', 'http', '204', '');
  LNotFound := DurationCount('PUT', 'labels.test', '8080', 'http', '404', '404');
  LDown := DurationCount('PUT', 'labels.test', '8080', 'http', '', 'EPcHttpTransport');
  FFake.Answer(204);
  FFake.Answer(204);
  FFake.Answer(404);
  FFake.Fail;
  FTransport.Send(TPcHttpRequest.Create('PUT', 'http://labels.test:8080/a'));
  FTransport.Send(TPcHttpRequest.Create('PUT', 'http://labels.test:8080/b?x=1'));
  FTransport.Send(TPcHttpRequest.Create('PUT', 'http://labels.test:8080/c'));
  try
    FTransport.Send(TPcHttpRequest.Create('PUT', 'http://labels.test:8080/d'));
    TAssert.Fail('the failure was not raised');
  except
    on EPcHttpTransport do
      ;
  end;
  TAssert.AssertTrue('two 204s, whatever the path',
    DurationCount('PUT', 'labels.test', '8080', 'http', '204', '') = LOk + 2);
  TAssert.AssertTrue('a 404',
    DurationCount('PUT', 'labels.test', '8080', 'http', '404', '404') = LNotFound + 1);
  TAssert.AssertTrue('no answer',
    DurationCount('PUT', 'labels.test', '8080', 'http', '', 'EPcHttpTransport') = LDown + 1);
end;

procedure THttpTelemetryTests.InvalidUrl_PassedOnUnrecorded;
var
  LOptions: TPcHttpTelemetryOptions;
  LResponse: TPcHttpResponse;
begin
  LOptions := Default(TPcHttpTelemetryOptions);
  LOptions.RootWhenNoParent := True;
  Wrap(LOptions);
  FFake.Answer(200);
  // The fake doesn't parse URLs: the decorator leaves the verdict to the
  // transport it wraps.
  LResponse := FTransport.Send(TPcHttpRequest.Create('GET', 'ftp://files.test/a b'));
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals(0, Length(ClientSpans));
  TAssert.AssertEquals('', FFake.Request(0).Header('traceparent'));
end;

procedure THttpTelemetryTests.CallersRequest_NotChanged;
var
  LParent: IPcSpan;
  LRequest: TPcHttpRequest;
begin
  FFake.Answer(200);
  LRequest := TPcHttpRequest.Create('GET', 'http://copy.test/');
  LRequest.AddHeader('Accept', 'application/json');
  LParent := TPcTracing.StartSpan('handler');
  try
    FTransport.Send(LRequest);
  finally
    LParent.Finish;
  end;
  LParent := nil;
  TAssert.AssertEquals('the caller''s headers are left alone', 1, Length(LRequest.Headers));
  TAssert.AssertEquals(2, Length(FFake.Request(0).Headers));
  TAssert.AssertEquals('application/json', FFake.Request(0).Header('Accept'));
  TAssert.AssertTrue(FFake.Request(0).Header('traceparent') <> '');
end;

procedure THttpTelemetryTests.ManyThreads_EachRequestInItsThreadsTrace;
var
  LThreads: array[0..THREAD_COUNT - 1] of TSendThread;
  LRequests: TArray<TPcHttpRequest>;
  LTrace: string;
  I, J, LCount: Integer;
begin
  for I := 1 to THREAD_COUNT * SENDS_PER_THREAD do
    FFake.Answer(200);
  for I := 0 to THREAD_COUNT - 1 do
    LThreads[I] := TSendThread.Create(FTransport);
  for I := 0 to THREAD_COUNT - 1 do
    LThreads[I].WaitFor;
  try
    for I := 0 to THREAD_COUNT - 1 do
      TAssert.AssertEquals('thread ' + IntToStr(I), '', LThreads[I].Error);
    LRequests := FFake.Requests;
    TAssert.AssertEquals(THREAD_COUNT * SENDS_PER_THREAD, Length(LRequests));
    for I := 0 to THREAD_COUNT - 1 do
    begin
      LCount := 0;
      for J := 0 to High(LRequests) do
      begin
        LTrace := TraceIdOf(LRequests[J].Header('traceparent'));
        if LTrace = LThreads[I].TraceId then
          Inc(LCount);
      end;
      TAssert.AssertEquals('requests in thread ' + IntToStr(I) + '''s trace',
        SENDS_PER_THREAD, LCount);
    end;
    TAssert.AssertEquals(THREAD_COUNT * SENDS_PER_THREAD, Length(ClientSpans));
  finally
    for I := 0 to THREAD_COUNT - 1 do
      LThreads[I].Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(THttpTelemetryTests);

end.
