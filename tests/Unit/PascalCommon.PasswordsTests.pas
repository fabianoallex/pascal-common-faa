unit PascalCommon.PasswordsTests;

{ Tests for PascalCommon.Passwords: the stored form, Verify on anything a
  database could hold, NeedsRehash. PBKDF2 itself is PcPbkdf2HmacSha256,
  tested in PascalCommon.CryptoTests (RFC 7914 and more); the stored forms
  below were computed with Python's hashlib.pbkdf2_hmac (2026-10-18). Came
  with the unit from pascal-agenda-faa (Agenda.PasswordsTests) in 1.26.0.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  PascalCommon.DUnitXCompat,
  SysUtils,
  PascalCommon.Utf8,
  PascalCommon.Passwords;

type
  [TestFixture]
  TPasswordsTests = class
  public
    [Test] procedure HashWithSalt_StoredForm;
    [Test] procedure HashWithSalt_NonAsciiIsUtf8;
    [Test] procedure Hash_VerifiesItsPassword;
    [Test] procedure Hash_NewSaltEachTime;
    [Test] procedure Hash_RejectsEmptyAndTooLong;
    [Test] procedure Hash_RejectsIterationsOutOfRange;
    [Test] procedure Verify_WrongPassword;
    [Test] procedure Verify_FalseForWhatItCannotRead;
    [Test] procedure NeedsRehash_FollowsIterations;
  end;

implementation

const
  // Typed constants: FPC warns (4104/4105) on a non-ASCII literal in an
  // expression.
  SAO_PAULO: string = 'São Paulo → ok';
  SAO_PAULO_STORED = '$pbkdf2-sha256$i=3$c2FsdA$PuV9Tx2FEsKy52wl3cJ619vagJ52I9Gn1oyOYBs_0AE';
  SECRET_STORED = '$pbkdf2-sha256$i=1000$AAAAAAAAAAAAAAAAAAAAAA$AkYsQLg1WVW2sQ8m-tSg6vMnKdmKRLxP8_X30HK_IPU';
  // Few iterations: these tests check behavior, not cost.
  FAST = 1000;

function Bytes(const AText: string): TBytes;
begin
  Result := PcStringToUtf8Bytes(AText);
end;

function ZeroBytes(ACount: Integer): TBytes;
begin
  Result := nil;
  SetLength(Result, ACount);
  FillChar(Result[0], ACount, 0);
end;

// The exception class name, or '' when nothing was raised (no closures on FPC).
function HashRaises(const APassword: string; AIterations: Integer): string;
begin
  Result := '';
  try
    TPcPasswords.Hash(APassword, AIterations);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

procedure TPasswordsTests.HashWithSalt_StoredForm;
begin
  TAssert.AssertEquals(SECRET_STORED,
    TPcPasswords.HashWithSalt('secret', ZeroBytes(16), 1000));
end;

procedure TPasswordsTests.HashWithSalt_NonAsciiIsUtf8;
begin
  TAssert.AssertEquals(SAO_PAULO_STORED, TPcPasswords.HashWithSalt(SAO_PAULO, Bytes('salt'), 3));
  TAssert.AssertTrue(TPcPasswords.Verify(SAO_PAULO, SAO_PAULO_STORED));
end;

procedure TPasswordsTests.Hash_VerifiesItsPassword;
var
  LStored: string;
begin
  LStored := TPcPasswords.Hash('correct horse', FAST);
  TAssert.AssertEquals('$pbkdf2-sha256$i=1000$', Copy(LStored, 1, 22));
  TAssert.AssertTrue(TPcPasswords.Verify('correct horse', LStored));
  TAssert.AssertTrue(TPcPasswords.Verify('secret', SECRET_STORED));
end;

procedure TPasswordsTests.Hash_NewSaltEachTime;
begin
  TAssert.AssertFalse(TPcPasswords.Hash('same', FAST) = TPcPasswords.Hash('same', FAST));
end;

procedure TPasswordsTests.Hash_RejectsEmptyAndTooLong;
begin
  TAssert.AssertEquals('EPcPasswordError', HashRaises('', FAST));
  TAssert.AssertEquals('EPcPasswordError', HashRaises(StringOfChar('a', PC_PASSWORD_MAX_BYTES + 1), FAST));
  TAssert.AssertEquals('', HashRaises(StringOfChar('a', PC_PASSWORD_MAX_BYTES), FAST));
end;

procedure TPasswordsTests.Hash_RejectsIterationsOutOfRange;
begin
  TAssert.AssertEquals('EArgumentException', HashRaises('p', 0));
  TAssert.AssertEquals('EArgumentException', HashRaises('p', PC_PASSWORD_MAX_ITERATIONS + 1));
end;

procedure TPasswordsTests.Verify_WrongPassword;
begin
  TAssert.AssertFalse(TPcPasswords.Verify('Secret', SECRET_STORED));
  TAssert.AssertFalse(TPcPasswords.Verify('secret ', SECRET_STORED));
  TAssert.AssertFalse(TPcPasswords.Verify('', SECRET_STORED));
  TAssert.AssertFalse(TPcPasswords.Verify(StringOfChar('a', PC_PASSWORD_MAX_BYTES + 1), SECRET_STORED));
end;

procedure TPasswordsTests.Verify_FalseForWhatItCannotRead;
const
  SALT = '$AAAAAAAAAAAAAAAAAAAAAA';
  HASH = '$AkYsQLg1WVW2sQ8m-tSg6vMnKdmKRLxP8_X30HK_IPU';
begin
  TAssert.AssertFalse('empty', TPcPasswords.Verify('secret', ''));
  TAssert.AssertFalse('plain text', TPcPasswords.Verify('secret', 'secret'));
  TAssert.AssertFalse('another scheme',
    TPcPasswords.Verify('secret', '$2b$12$abcdefghijklmnopqrstuuJ0J5bq3XK3V0ZQ5rR1h8m1Q3Q5Q5Q5Q'));
  TAssert.AssertFalse('scheme case', TPcPasswords.Verify('secret', '$PBKDF2-SHA256$i=1000' + SALT + HASH));
  TAssert.AssertFalse('no hash', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT));
  TAssert.AssertFalse('empty hash', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT + '$'));
  TAssert.AssertFalse('extra field', TPcPasswords.Verify('secret', SECRET_STORED + '$x'));
  TAssert.AssertFalse('no i=', TPcPasswords.Verify('secret', '$pbkdf2-sha256$1000' + SALT + HASH));
  TAssert.AssertFalse('zero iterations', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=0' + SALT + HASH));
  TAssert.AssertFalse('negative', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=-1' + SALT + HASH));
  TAssert.AssertFalse('hex iterations', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=0x3E8' + SALT + HASH));
  TAssert.AssertFalse('too many', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=10000001' + SALT + HASH));
  TAssert.AssertFalse('huge', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=99999999999' + SALT + HASH));
  TAssert.AssertFalse('empty salt', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=1000$' + HASH));
  TAssert.AssertFalse('bad Base64', TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT + '$Ak*sQ'));
  TAssert.AssertFalse('short hash',
    TPcPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT + '$AkYsQLg1WVW2sQ8m'));
end;

procedure TPasswordsTests.NeedsRehash_FollowsIterations;
begin
  TAssert.AssertFalse(TPcPasswords.NeedsRehash(SECRET_STORED, 1000));
  TAssert.AssertFalse(TPcPasswords.NeedsRehash(SECRET_STORED, 999));
  TAssert.AssertTrue(TPcPasswords.NeedsRehash(SECRET_STORED, 1001));
  TAssert.AssertTrue(TPcPasswords.NeedsRehash(SECRET_STORED));
  TAssert.AssertTrue('unreadable', TPcPasswords.NeedsRehash('secret', 1));
end;

initialization
  TDUnitX.RegisterTestFixture(TPasswordsTests);

end.
