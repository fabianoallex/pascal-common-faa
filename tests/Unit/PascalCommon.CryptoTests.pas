unit PascalCommon.CryptoTests;

{ Tests for PascalCommon.Crypto (SHA-256, HMAC-SHA256, Base64url, the
  constant-time comparison), moved with the code from pascal-api-infra-faa's
  PascalApi.CryptoTests in 1.17.0, and PBKDF2-HMAC-SHA256 (1.18.0).

  Vectors: SHA-256 from FIPS 180-4's examples plus lengths around the
  64-byte block (computed with Python's hashlib); HMAC from RFC 4231 test
  cases 1, 2, 3, 6 and 7; Base64url from RFC 4648 section 10. PBKDF2 from
  RFC 7914 section 11 and the widely used "password"/"salt" set, plus keys
  and salts around the 64-byte block (where the precomputed HMAC states and
  the padding of the first block change), all recomputed with Python's
  hashlib.pbkdf2_hmac; and against PBKDF2 written directly on PcHmacSha256.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  PascalCommon.DUnitXCompat,
  SysUtils,
  PascalCommon.Utf8,
  PascalCommon.Crypto;

type
  [TestFixture]
  TCryptoTests = class
  public
    [Test] procedure Sha256_Fips180Examples;
    [Test] procedure Sha256_AroundBlockBoundary;
    [Test] procedure Sha256_OneMillionA;
    [Test] procedure Sha256_NonAsciiHashesUtf8;
    [Test] procedure Hmac_Rfc4231;
    [Test] procedure Base64Url_Rfc4648;
    [Test] procedure Base64Url_UrlAlphabet;
    [Test] procedure Base64Url_DecodeRoundTrip;
    [Test] procedure Base64Url_DecodeRejectsInvalid;
    [Test] procedure Base64Url_StrictReadsTheEncodersText;
    [Test] procedure Base64Url_StrictRefusesOtherSpellings;
    [Test] procedure SameBytes;
    [Test] procedure Pbkdf2_Rfc7914;
    [Test] procedure Pbkdf2_PasswordSaltVectors;
    [Test] procedure Pbkdf2_LengthNotAMultipleOfTheDigest;
    [Test] procedure Pbkdf2_KeysAroundTheBlock;
    [Test] procedure Pbkdf2_SaltsAroundTheBlock;
    [Test] procedure Pbkdf2_EmptyPasswordAndSalt;
    [Test] procedure Pbkdf2_SameAsTheDefinitionOnHmac;
    [Test] procedure Pbkdf2_RejectsBadArguments;
  end;

implementation

function Utf8(const AText: string): TBytes;
{$IFDEF FPC}
var
  LUtf8: UTF8String;
{$ENDIF}
begin
  Result := nil;
  {$IFDEF FPC}
  LUtf8 := UTF8String(AText);
  SetLength(Result, Length(LUtf8));
  if Length(LUtf8) > 0 then
    Move(LUtf8[1], Result[0], Length(LUtf8));
  {$ELSE}
  Result := TEncoding.UTF8.GetBytes(AText);
  {$ENDIF}
end;

function Utf8Text(const ABytes: TBytes): string;
begin
  if not PcTryUtf8BytesToString(ABytes, Result) then
    Result := '<not UTF-8>';
end;

function Repeated(AByte: Byte; ACount: Integer): TBytes;
begin
  Result := nil;
  SetLength(Result, ACount);
  if ACount > 0 then
    FillChar(Result[0], ACount, AByte);
end;

function Sha256Hex(const ABytes: TBytes): string;
begin
  Result := PcBytesToHex(PcDigestToBytes(PcSha256(ABytes)));
end;

function HmacHex(const AKey, AData: TBytes): string;
begin
  Result := PcBytesToHex(PcDigestToBytes(PcHmacSha256(AKey, AData)));
end;

function Sequence(ACount: Integer): TBytes;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, ACount);
  for I := 0 to ACount - 1 do
    Result[I] := Byte(I);
end;

function Pbkdf2Hex(const APassword, ASalt: TBytes; AIterations, ALength: Integer): string;
begin
  Result := PcBytesToHex(PcPbkdf2HmacSha256(APassword, ASalt, AIterations, ALength));
end;

// RFC 8018's definition written on PcHmacSha256, the slow way: what the
// precomputed states must give.
function Pbkdf2ByDefinition(const APassword, ASalt: TBytes; AIterations, ALength: Integer): TBytes;
var
  LBlock: TBytes;
  LU, LT: TPcSha256Digest;
  LIndex, LDone, LCount, I, J: Integer;
begin
  Result := nil;
  SetLength(Result, ALength);
  LDone := 0;
  LIndex := 0;
  while LDone < ALength do
  begin
    Inc(LIndex);
    LBlock := Copy(ASalt, 0, Length(ASalt));
    SetLength(LBlock, Length(ASalt) + 4);
    LBlock[Length(ASalt)] := 0;
    LBlock[Length(ASalt) + 1] := 0;
    LBlock[Length(ASalt) + 2] := 0;
    LBlock[Length(ASalt) + 3] := Byte(LIndex);
    LU := PcHmacSha256(APassword, LBlock);
    LT := LU;
    for I := 2 to AIterations do
    begin
      LU := PcHmacSha256(APassword, PcDigestToBytes(LU));
      for J := 0 to 31 do
        LT[J] := LT[J] xor LU[J];
    end;
    LCount := ALength - LDone;
    if LCount > 32 then
      LCount := 32;
    Move(LT[0], Result[LDone], LCount);
    Inc(LDone, LCount);
  end;
end;

// The exception class name, or '' (no closures on FPC).
function Pbkdf2Raises(AIterations, ALength: Integer): string;
begin
  Result := '';
  try
    PcPbkdf2HmacSha256(Utf8('p'), Utf8('s'), AIterations, ALength);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

// The character after AChar in the Base64url alphabet.
function NextBase64UrlChar(AChar: Char): Char;
const
  ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
begin
  Result := ALPHABET[Pos(AChar, ALPHABET) + 1];
end;

function Encode(const S: string): string;
begin
  Result := PcBase64UrlEncode(Utf8(S));
end;

{ TCryptoTests }

procedure TCryptoTests.Sha256_Fips180Examples;
begin
  TAssert.AssertEquals('e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855',
    Sha256Hex(nil));
  TAssert.AssertEquals('ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad',
    Sha256Hex(Utf8('abc')));
  TAssert.AssertEquals('248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1',
    Sha256Hex(Utf8('abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq')));
end;

procedure TCryptoTests.Sha256_AroundBlockBoundary;
begin
  TAssert.AssertEquals('55', '9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318',
    Sha256Hex(Repeated(Ord('a'), 55)));
  TAssert.AssertEquals('56', 'b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a',
    Sha256Hex(Repeated(Ord('a'), 56)));
  TAssert.AssertEquals('63', '7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34',
    Sha256Hex(Repeated(Ord('a'), 63)));
  TAssert.AssertEquals('64', 'ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb',
    Sha256Hex(Repeated(Ord('a'), 64)));
  TAssert.AssertEquals('65', '635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0',
    Sha256Hex(Repeated(Ord('a'), 65)));
  TAssert.AssertEquals('119', '31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb',
    Sha256Hex(Repeated(Ord('a'), 119)));
  TAssert.AssertEquals('120', '2f3d335432c70b580af0e8e1b3674a7c020d683aa5f73aaaedfdc55af904c21c',
    Sha256Hex(Repeated(Ord('a'), 120)));
end;

procedure TCryptoTests.Sha256_OneMillionA;
begin
  TAssert.AssertEquals('cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0',
    Sha256Hex(Repeated(Ord('a'), 1000000)));
end;

procedure TCryptoTests.Sha256_NonAsciiHashesUtf8;
begin
  TAssert.AssertEquals('99c3d6caccd648574aa0f41f7ae30f7529df276183e187d5db4262f292843b7f',
    Sha256Hex(Utf8('São Paulo → ok')));
end;

procedure TCryptoTests.Hmac_Rfc4231;
begin
  TAssert.AssertEquals('case 1', 'b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7',
    HmacHex(Repeated($0b, 20), Utf8('Hi There')));
  TAssert.AssertEquals('case 2', '5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843',
    HmacHex(Utf8('Jefe'), Utf8('what do ya want for nothing?')));
  TAssert.AssertEquals('case 3', '773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe',
    HmacHex(Repeated($aa, 20), Repeated($dd, 50)));
  TAssert.AssertEquals('case 6', '60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54',
    HmacHex(Repeated($aa, 131), Utf8('Test Using Larger Than Block-Size Key - Hash Key First')));
  TAssert.AssertEquals('case 7', '9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2',
    HmacHex(Repeated($aa, 131), Utf8('This is a test using a larger than block-size key and a ' +
      'larger than block-size data. The key needs to be hashed before being used by the HMAC ' +
      'algorithm.')));
end;

procedure TCryptoTests.Base64Url_Rfc4648;
begin
  TAssert.AssertEquals('', Encode(''));
  TAssert.AssertEquals('Zg', Encode('f'));
  TAssert.AssertEquals('Zm8', Encode('fo'));
  TAssert.AssertEquals('Zm9v', Encode('foo'));
  TAssert.AssertEquals('Zm9vYg', Encode('foob'));
  TAssert.AssertEquals('Zm9vYmE', Encode('fooba'));
  TAssert.AssertEquals('Zm9vYmFy', Encode('foobar'));
end;

procedure TCryptoTests.Base64Url_UrlAlphabet;
var
  LBytes: TBytes;
begin
  // FB FF BF is "+/+/" in standard Base64.
  LBytes := nil;
  SetLength(LBytes, 3);
  LBytes[0] := $FB;
  LBytes[1] := $FF;
  LBytes[2] := $BF;
  TAssert.AssertEquals('-_-_', PcBase64UrlEncode(LBytes));
  TAssert.AssertEquals('-_8', PcBase64UrlEncode(Copy(LBytes, 0, 2)));
end;

procedure TCryptoTests.Base64Url_DecodeRoundTrip;
var
  LBytes: TBytes;
  I: Integer;
begin
  for I := 0 to 6 do
  begin
    TAssert.AssertTrue(PcBase64UrlDecode(Encode(Copy('foobar', 1, I)), LBytes));
    TAssert.AssertEquals(Copy('foobar', 1, I), Utf8Text(LBytes));
  end;
  TAssert.AssertTrue('padding accepted', PcBase64UrlDecode('Zg==', LBytes));
  TAssert.AssertEquals('f', Utf8Text(LBytes));
end;

procedure TCryptoTests.Base64Url_DecodeRejectsInvalid;
var
  LBytes: TBytes;
begin
  TAssert.AssertFalse('standard alphabet', PcBase64UrlDecode('ab+/', LBytes));
  TAssert.AssertFalse('space', PcBase64UrlDecode('Zm 9v', LBytes));
  TAssert.AssertFalse('4n+1 characters', PcBase64UrlDecode('Zm9vY', LBytes));
end;

procedure TCryptoTests.Base64Url_StrictReadsTheEncodersText;
var
  LBytes: TBytes;
  I: Integer;
begin
  for I := 0 to 6 do
  begin
    TAssert.AssertTrue(PcBase64UrlDecodeStrict(Encode(Copy('foobar', 1, I)), LBytes));
    TAssert.AssertEquals(Copy('foobar', 1, I), Utf8Text(LBytes));
  end;
  // 32 bytes, as an HMAC-SHA256: 43 characters. (Not LBytes on both sides
  // of one call: FPC clears an out argument before it reads the others.)
  TAssert.AssertTrue('a digest', PcBase64UrlDecodeStrict(
    PcBase64UrlEncode(PcDigestToBytes(PcSha256(Utf8('abc')))), LBytes));
  TAssert.AssertTrue('a digest: its bytes', PcSameBytes(LBytes,
    PcDigestToBytes(PcSha256(Utf8('abc')))));
end;

procedure TCryptoTests.Base64Url_StrictRefusesOtherSpellings;
var
  LBytes: TBytes;
  LText: string;
begin
  // "Zg" is "f"; "Zh" differs only in the 4 bits after the byte, which the
  // lenient decoder drops.
  TAssert.AssertTrue('lenient: Zh', PcBase64UrlDecode('Zh', LBytes));
  TAssert.AssertEquals('lenient: Zh is f', 'f', Utf8Text(LBytes));
  TAssert.AssertFalse('strict: Zh', PcBase64UrlDecodeStrict('Zh', LBytes));
  TAssert.AssertTrue('strict: nil after a refusal', LBytes = nil);
  // "Zm8" is "fo"; "Zm9" differs only in the 2 bits after the bytes.
  TAssert.AssertTrue('lenient: Zm9', PcBase64UrlDecode('Zm9', LBytes));
  TAssert.AssertEquals('lenient: Zm9 is fo', 'fo', Utf8Text(LBytes));
  TAssert.AssertFalse('strict: Zm9', PcBase64UrlDecodeStrict('Zm9', LBytes));
  TAssert.AssertTrue('strict: Zm8', PcBase64UrlDecodeStrict('Zm8', LBytes));
  TAssert.AssertFalse('strict: padding', PcBase64UrlDecodeStrict('Zg==', LBytes));
  TAssert.AssertFalse('strict: standard alphabet', PcBase64UrlDecodeStrict('ab+/', LBytes));
  TAssert.AssertFalse('strict: 4n+1 characters', PcBase64UrlDecodeStrict('Zm9vY', LBytes));
  // A digest's last character carries 4 bits (SHA-256 of "abc" ends in
  // "Fa0"): the next character of the alphabet decodes to the same bytes.
  LText := PcBase64UrlEncode(PcDigestToBytes(PcSha256(Utf8('abc'))));
  TAssert.AssertTrue('lenient: the last character + 1',
    PcBase64UrlDecode(Copy(LText, 1, 42) + NextBase64UrlChar(LText[43]), LBytes));
  TAssert.AssertTrue('lenient: the same bytes',
    PcSameBytes(LBytes, PcDigestToBytes(PcSha256(Utf8('abc')))));
  TAssert.AssertFalse('strict: the last character + 1',
    PcBase64UrlDecodeStrict(Copy(LText, 1, 42) + NextBase64UrlChar(LText[43]), LBytes));
end;

procedure TCryptoTests.SameBytes;
begin
  TAssert.AssertTrue(PcSameBytes(Utf8('abc'), Utf8('abc')));
  TAssert.AssertFalse(PcSameBytes(Utf8('abc'), Utf8('abd')));
  TAssert.AssertFalse(PcSameBytes(Utf8('abc'), Utf8('abcd')));
  TAssert.AssertTrue(PcSameBytes(nil, nil));
end;

procedure TCryptoTests.Pbkdf2_Rfc7914;
begin
  TAssert.AssertEquals('55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc' +
    '49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783',
    Pbkdf2Hex(Utf8('passwd'), Utf8('salt'), 1, 64));
  TAssert.AssertEquals('4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56' +
    'a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d',
    Pbkdf2Hex(Utf8('Password'), Utf8('NaCl'), 80000, 64));
end;

procedure TCryptoTests.Pbkdf2_PasswordSaltVectors;
begin
  TAssert.AssertEquals('120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b',
    Pbkdf2Hex(Utf8('password'), Utf8('salt'), 1, 32));
  TAssert.AssertEquals('ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43',
    Pbkdf2Hex(Utf8('password'), Utf8('salt'), 2, 32));
  TAssert.AssertEquals('c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a',
    Pbkdf2Hex(Utf8('password'), Utf8('salt'), 4096, 32));
end;

procedure TCryptoTests.Pbkdf2_LengthNotAMultipleOfTheDigest;
begin
  TAssert.AssertEquals('348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1' +
    'c635518c7dac47e9',
    Pbkdf2Hex(Utf8('passwordPASSWORDpassword'), Utf8('saltSALTsaltSALTsaltSALTsaltSALTsalt'),
    4096, 40));
  // Three blocks, the last one cut.
  TAssert.AssertEquals('ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43' +
    '830651afcb5c862f0b249bd031f7a67520d136470f5ec271ece91c07773253d9' +
    '3e676b079cae1219a000f8b4b1a0a3ba',
    Pbkdf2Hex(Utf8('password'), Utf8('salt'), 2, 80));
end;

procedure TCryptoTests.Pbkdf2_KeysAroundTheBlock;
begin
  // 64 bytes: padded, not hashed; 65 and 100: hashed first.
  TAssert.AssertEquals('a858736c1761ff7ff75351b00e8314761c199f7cc28eea967495340c34228e87',
    Pbkdf2Hex(Repeated(Ord('k'), 64), Utf8('salt'), 2, 32));
  TAssert.AssertEquals('ddff3f4befbd87f443c0d32abcea246f26aa533be46caa8829e6dba1e8566728',
    Pbkdf2Hex(Repeated(Ord('k'), 65), Utf8('salt'), 2, 32));
  TAssert.AssertEquals('d43a18cd77bafc1a4b0c6025dbbf29c7e6d67acce6ad02a736d4a3003b6a3c26',
    Pbkdf2Hex(Repeated(Ord('x'), 100), Utf8('salt'), 2, 32));
end;

procedure TCryptoTests.Pbkdf2_SaltsAroundTheBlock;
begin
  // Salt plus the 4 bytes of the block index: 56 (the padding needs a second
  // block), 63, 64 (a whole block, then the padding alone), 128.
  TAssert.AssertEquals('688602a2b809101fbd978454f3774ea4713dcf155943e265ec7e0ee920ec10e7',
    Pbkdf2Hex(Utf8('password'), Sequence(52), 3, 32));
  TAssert.AssertEquals('b2e83d320975512469705d2ba64056ad48b5d5c56e74dc6238549e4ff1c7ef70',
    Pbkdf2Hex(Utf8('password'), Sequence(59), 3, 32));
  TAssert.AssertEquals('a2ddd47111ab5953ba03cd741e62037170e6b8e09e2685608721006e6919a481',
    Pbkdf2Hex(Utf8('password'), Sequence(60), 3, 32));
  TAssert.AssertEquals('19244fdfd60dc4be89772556ce285cbdac972c88f92168bfd862fe19aea7432f',
    Pbkdf2Hex(Utf8('password'), Sequence(124), 3, 32));
end;

procedure TCryptoTests.Pbkdf2_EmptyPasswordAndSalt;
begin
  TAssert.AssertEquals('97398411d6aea43a77acef92226ab8278d4db0668bd1d7a76a725f7680ac45c5',
    Pbkdf2Hex(nil, nil, 2, 32));
end;

procedure TCryptoTests.Pbkdf2_SameAsTheDefinitionOnHmac;
var
  LLength, LSalt, LKey: Integer;
begin
  for LKey := 0 to 3 do
    for LSalt := 0 to 3 do
      for LLength := 1 to 3 do
        TAssert.AssertTrue(Format('key %d, salt %d, length %d', [LKey * 33, LSalt * 41, LLength * 23]),
          PcSameBytes(Pbkdf2ByDefinition(Sequence(LKey * 33), Sequence(LSalt * 41), 5, LLength * 23),
            PcPbkdf2HmacSha256(Sequence(LKey * 33), Sequence(LSalt * 41), 5, LLength * 23)));
end;

procedure TCryptoTests.Pbkdf2_RejectsBadArguments;
begin
  TAssert.AssertEquals('EArgumentException', Pbkdf2Raises(0, 32));
  TAssert.AssertEquals('EArgumentException', Pbkdf2Raises(1, 0));
  TAssert.AssertEquals('', Pbkdf2Raises(1, 1));
end;

initialization
  TDUnitX.RegisterTestFixture(TCryptoTests);

end.
