unit PascalCommon.AesGcmTests;

{ Tests for PascalCommon.AesGcm against published vectors: FIPS-197
  appendix C (one block, AES-128/192/256), McGrew and Viega's GCM test
  cases 1-4 and 13-16 (AES-128 and AES-256; empty, one-block and
  partial-block texts, with and without AAD), and vectors computed with
  OpenSSL (Python's cryptography 50.0.1) for AES-192, 8- and 60-byte nonces
  and a 1000-byte text. Every vector was recomputed with OpenSSL before it
  went in. Then decryption refusing a changed key, nonce, AAD, ciphertext
  or tag, round trips of every length around the block size, and the
  argument checks.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  PascalCommon.DUnitXCompat,
  SysUtils,
  PascalCommon.Random,
  PascalCommon.AesGcm;

type
  [TestFixture]
  TAesGcmTests = class
  public
    [Test] procedure Block_Fips197;
    [Test] procedure Gcm_McGrewViega_Aes128;
    [Test] procedure Gcm_McGrewViega_Aes256;
    [Test] procedure Gcm_OpenSsl_Aes192AndOtherNonces;
    [Test] procedure Gcm_OpenSsl_LongText;
    [Test] procedure Decrypt_RefusesAnyChange;
    [Test] procedure RoundTrip_EveryLengthAroundTheBlock;
    [Test] procedure Arguments_Checked;
  end;

implementation

const
  K3 = 'feffe9928665731c6d6a8f9467308308';
  P3 = 'd9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72' +
    '1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255';
  AAD = 'feedfacedeadbeeffeedfacedeadbeefabaddad2';
  IV3 = 'cafebabefacedbaddecaf888';

function Hex(const ABytes: TBytes): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ABytes) do
    Result := Result + LowerCase(IntToHex(ABytes[I], 2));
end;

function FromHex(const AText: string): TBytes;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(AText) div 2);
  for I := 0 to High(Result) do
    Result[I] := StrToInt('$' + Copy(AText, 2 * I + 1, 2));
end;

function Ascii(const AText: string): TBytes;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(AText));
  for I := 1 to Length(AText) do
    Result[I - 1] := Ord(AText[I]);
end;

function AsciiText(const ABytes: TBytes): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ABytes) do
    Result := Result + Chr(ABytes[I]);
end;

function Sequence(ACount: Integer): TBytes;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, ACount);
  for I := 0 to ACount - 1 do
    Result[I] := I mod 256;
end;

// Encrypts, checks ciphertext and tag, then decrypts back.
procedure CheckVector(const AName, AKey, ANonce, APlain, AAad, ACipher, ATag: string);
var
  LTag, LPlain: TBytes;
begin
  TAssert.AssertEquals(AName + ' ciphertext', ACipher,
    Hex(PcAesGcmEncrypt(FromHex(AKey), FromHex(ANonce), FromHex(APlain), FromHex(AAad), LTag)));
  TAssert.AssertEquals(AName + ' tag', ATag, Hex(LTag));
  TAssert.AssertTrue(AName + ' decrypts', PcAesGcmDecrypt(FromHex(AKey), FromHex(ANonce),
    FromHex(ACipher), FromHex(AAad), FromHex(ATag), LPlain));
  TAssert.AssertEquals(AName + ' plaintext', APlain, Hex(LPlain));
end;

function Flipped(const ABytes: TBytes; AIndex: Integer): TBytes;
begin
  Result := Copy(ABytes);
  Result[AIndex] := Result[AIndex] xor $01;
end;

function EncryptError(AKeyBytes, ANonceBytes: Integer): string;
var
  LTag: TBytes;
begin
  Result := '';
  try
    PcAesGcmEncrypt(Sequence(AKeyBytes), Sequence(ANonceBytes), Sequence(10), nil, LTag);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

function BlockError(AKeyBytes, ABlockBytes: Integer): string;
begin
  Result := '';
  try
    PcAesEncryptBlock(Sequence(AKeyBytes), Sequence(ABlockBytes));
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

{ TAesGcmTests }

procedure TAesGcmTests.Block_Fips197;
const
  PLAIN = '00112233445566778899aabbccddeeff';
begin
  TAssert.AssertEquals('AES-128', '69c4e0d86a7b0430d8cdb78070b4c55a',
    Hex(PcAesEncryptBlock(Sequence(16), FromHex(PLAIN))));
  TAssert.AssertEquals('AES-192', 'dda97ca4864cdfe06eaf70a0ec0d7191',
    Hex(PcAesEncryptBlock(Sequence(24), FromHex(PLAIN))));
  TAssert.AssertEquals('AES-256', '8ea2b7ca516745bfeafc49904b496089',
    Hex(PcAesEncryptBlock(Sequence(32), FromHex(PLAIN))));
end;

procedure TAesGcmTests.Gcm_McGrewViega_Aes128;
begin
  CheckVector('TC1', StringOfChar('0', 32), StringOfChar('0', 24), '', '', '',
    '58e2fccefa7e3061367f1d57a4e7455a');
  CheckVector('TC2', StringOfChar('0', 32), StringOfChar('0', 24), StringOfChar('0', 32), '',
    '0388dace60b6a392f328c2b971b2fe78', 'ab6e47d42cec13bdf53a67b21257bddf');
  CheckVector('TC3', K3, IV3, P3, '',
    '42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e' +
    '21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f5985',
    '4d5c2af327cd64a62cf35abd2ba6fab4');
  CheckVector('TC4', K3, IV3, Copy(P3, 1, 120), AAD,
    '42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e' +
    '21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091',
    '5bc94fbc3221a5db94fae95ae7121a47');
end;

procedure TAesGcmTests.Gcm_McGrewViega_Aes256;
begin
  CheckVector('TC13', StringOfChar('0', 64), StringOfChar('0', 24), '', '', '',
    '530f8afbc74536b9a963b4f1c4cb738b');
  CheckVector('TC14', StringOfChar('0', 64), StringOfChar('0', 24), StringOfChar('0', 32), '',
    'cea7403d4d606b6e074ec5d3baf39d18', 'd0d1c8a799996bf0265b98b5d48ab919');
  CheckVector('TC15', K3 + K3, IV3, P3, '',
    '522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa' +
    '8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662898015ad',
    'b094dac5d93471bdec1a502270e3cc6c');
  CheckVector('TC16', K3 + K3, IV3, Copy(P3, 1, 120), AAD,
    '522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa' +
    '8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662',
    '76fc6ece0f4e1768cddf8853bb2d551b');
end;

procedure TAesGcmTests.Gcm_OpenSsl_Aes192AndOtherNonces;
begin
  CheckVector('AES-192', K3 + 'feffe9928665731c', IV3, Copy(P3, 1, 120), AAD,
    '3980ca0b3c00e841eb06fac4872a2757859e1ceaa6efd984628593b40ca1e19c' +
    '7d773d00c144c525ac619d18c84a3f4718e2448b2fe324d9ccda2710',
    '2519498e80f1478f37ba55bd6d27618c');
  CheckVector('8-byte nonce', K3, 'cafebabefacedbad', Copy(P3, 1, 120), AAD,
    '61353b4c2806934a777ff51fa22a4755699b2a714fcdc6f83766e5f97b6c7423' +
    '73806900e49f24b22b097544d4896b424989b5e1ebac0f07c23f4598',
    '3612d2e79e3b0785561be14aaca2fccb');
  CheckVector('60-byte nonce', K3,
    '9313225df88406e555909c5aff5269aa6a7a9538534f7da1e4c303d2a318a728' +
    'c3c0c95156809539fcf0e2429a6b525416aedbf5a0de6a57a637b39b',
    Copy(P3, 1, 120), AAD,
    '8ce24998625615b603a033aca13fb894be9112a5c3a211a8ba262a3cca7e2ca7' +
    '01e4a9a4fba43c90ccdcb281d48c7c6fd62875d2aca417034c34aee5',
    '619cc5aefffe0bfa462af43c1699d050');
end;

procedure TAesGcmTests.Gcm_OpenSsl_LongText;
var
  LCipher, LTag, LPlain: TBytes;
begin
  // 1000 bytes (62 full blocks and a partial one), AAD "aad".
  LCipher := PcAesGcmEncrypt(Sequence(32), Sequence(12), Sequence(1000),
    Ascii('aad'), LTag);
  TAssert.AssertEquals('first block', '4703d418c1e0c41c85489d80bde47662', Hex(Copy(LCipher, 0, 16)));
  TAssert.AssertEquals('last 16 bytes', '8a680cf7706c70920c1340bda75c92c2',
    Hex(Copy(LCipher, 984, 16)));
  TAssert.AssertEquals('tag', 'ad6627ba8a2639ddf3b40734379916fc', Hex(LTag));
  TAssert.AssertTrue(PcAesGcmDecrypt(Sequence(32), Sequence(12), LCipher,
    Ascii('aad'), LTag, LPlain));
  TAssert.AssertEquals(Hex(Sequence(1000)), Hex(LPlain));
end;

procedure TAesGcmTests.Decrypt_RefusesAnyChange;
var
  LKey, LNonce, LAad, LCipher, LTag, LPlain: TBytes;
begin
  LKey := PcRandomBytes(32);
  LNonce := PcRandomBytes(PC_AES_GCM_NONCE_BYTES);
  LAad := Ascii('jwt-key|acme|acme/0123456789abcdef|3');
  LCipher := PcAesGcmEncrypt(LKey, LNonce, Ascii('the secret'), LAad, LTag);
  TAssert.AssertTrue('unchanged', PcAesGcmDecrypt(LKey, LNonce, LCipher, LAad, LTag, LPlain));
  TAssert.AssertEquals('the secret', AsciiText(LPlain));
  TAssert.AssertFalse('key', PcAesGcmDecrypt(Flipped(LKey, 31), LNonce, LCipher, LAad, LTag, LPlain));
  TAssert.AssertTrue('nothing when refused', LPlain = nil);
  TAssert.AssertFalse('nonce', PcAesGcmDecrypt(LKey, Flipped(LNonce, 0), LCipher, LAad, LTag, LPlain));
  TAssert.AssertFalse('aad', PcAesGcmDecrypt(LKey, LNonce, LCipher, Flipped(LAad, 5), LTag, LPlain));
  TAssert.AssertFalse('no aad', PcAesGcmDecrypt(LKey, LNonce, LCipher, nil, LTag, LPlain));
  TAssert.AssertFalse('ciphertext', PcAesGcmDecrypt(LKey, LNonce, Flipped(LCipher, 9), LAad, LTag, LPlain));
  TAssert.AssertFalse('tag', PcAesGcmDecrypt(LKey, LNonce, LCipher, LAad, Flipped(LTag, 15), LPlain));
  TAssert.AssertFalse('short tag', PcAesGcmDecrypt(LKey, LNonce, LCipher, LAad, Copy(LTag, 0, 15), LPlain));
  TAssert.AssertFalse('cut ciphertext', PcAesGcmDecrypt(LKey, LNonce, Copy(LCipher, 0, 9), LAad, LTag, LPlain));
end;

procedure TAesGcmTests.RoundTrip_EveryLengthAroundTheBlock;
var
  LKey, LNonce, LPlain, LCipher, LTag, LBack: TBytes;
  I: Integer;
begin
  LKey := PcRandomBytes(32);
  for I := 0 to 49 do
  begin
    LNonce := PcRandomBytes(PC_AES_GCM_NONCE_BYTES);
    LPlain := PcRandomBytes(I);
    LCipher := PcAesGcmEncrypt(LKey, LNonce, LPlain, Sequence(I mod 20), LTag);
    TAssert.AssertEquals('length ' + IntToStr(I), I, Length(LCipher));
    TAssert.AssertTrue('decrypts ' + IntToStr(I),
      PcAesGcmDecrypt(LKey, LNonce, LCipher, Sequence(I mod 20), LTag, LBack));
    TAssert.AssertEquals('back ' + IntToStr(I), Hex(LPlain), Hex(LBack));
  end;
end;

procedure TAesGcmTests.Arguments_Checked;
begin
  TAssert.AssertEquals('15-byte key', 'EArgumentException', EncryptError(15, 12));
  TAssert.AssertEquals('33-byte key', 'EArgumentException', EncryptError(33, 12));
  TAssert.AssertEquals('empty nonce', 'EArgumentException', EncryptError(32, 0));
  TAssert.AssertEquals('1-byte nonce', '', EncryptError(32, 1));
  TAssert.AssertEquals('24-byte key', '', EncryptError(24, 12));
  TAssert.AssertEquals('15-byte block', 'EArgumentException', BlockError(16, 15));
  TAssert.AssertEquals('20-byte key', 'EArgumentException', BlockError(20, 16));
end;

initialization
  TDUnitX.RegisterTestFixture(TAesGcmTests);

end.
