<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pascal_common_faa"/>
    <Author Value="Fabiano Arndt"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\src"/>
        <OtherUnitFiles Value="..\src"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Base library shared by the *-faa libraries (Delphi and Free Pascal/Lazarus, dual-compiler): optional/nullable types, portable atomics and monotonic time, a monitor and a thread pool, a clock/sleep context and a bounded cache."/>
    <License Value="MIT"/>
    <Version Major="1" Minor="1" Release="3"/>
    <Files>
      <Item>
        <Filename Value="..\src\pascalcommon.inc"/>
        <Type Value="Include"/>
      </Item>
      <Item>
        <Filename Value="..\src\PascalCommon.Version.pas"/>
        <UnitName Value="PascalCommon.Version"/>
      </Item>
      <Item>
        <Filename Value="..\src\PascalCommon.Threading.pas"/>
        <UnitName Value="PascalCommon.Threading"/>
      </Item>
      <Item>
        <Filename Value="..\src\PascalCommon.SystemContext.pas"/>
        <UnitName Value="PascalCommon.SystemContext"/>
      </Item>
      <Item>
        <Filename Value="..\src\PascalCommon.ClockCache.pas"/>
        <UnitName Value="PascalCommon.ClockCache"/>
      </Item>
      <Item>
        <Filename Value="..\src\PascalCommon.Optionals.pas"/>
        <UnitName Value="PascalCommon.Optionals"/>
      </Item>
      <Item>
        <Filename Value="..\src\PascalCommon.ThreadPool.pas"/>
        <UnitName Value="PascalCommon.ThreadPool"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
